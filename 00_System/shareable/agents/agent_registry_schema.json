{
  "version": "1.0",
  "required_fields": [
    "agent_id",
    "agent_name",
    "agent_type",
    "owner_layer",
    "primary_function",
    "capabilities",
    "entry_command",
    "service",
    "auth_required",
    "auth_status",
    "credential_location_hint",
    "allowed_actions",
    "blocked_actions",
    "memory_scope",
    "last_verified_at",
    "notes"
  ],
  "agent_types": ["logical_role", "workflow_agent", "external_service_agent", "local_tool"],
  "auth_statuses": ["unknown", "not_required", "configured", "expired", "failed"],
  "credential_rule": "Only store credential location hints. Never store real passwords, tokens, secrets, or API keys."
}
