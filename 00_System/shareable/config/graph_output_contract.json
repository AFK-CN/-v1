{
  "version": "1.0",
  "updated_at": "2026-07-14",
  "route_id": "knowledge_graph",
  "required_outputs": [
    "graph.json",
    "manifest.json",
    "index.html"
  ],
  "required_node_fields": [
    "id",
    "label",
    "layer",
    "status",
    "domain",
    "views",
    "source_file"
  ],
  "required_edge_fields": [
    "source",
    "target",
    "relation",
    "relation_source",
    "confidence"
  ],
  "must_not": [
    "不得扫描原始资料、私有层、归档层和运行层",
    "不得逐文件读取候选资产",
    "不得由图谱直接写入正式知识",
    "不得把 inferred 关系显示为确定事实",
    "不得安装 Graphify 的 AGENTS 指令、Git hook 或 watcher"
  ]
}
