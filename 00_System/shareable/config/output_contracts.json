{
  "version": "3.0",
  "updated_at": "2026-07-19",
  "clarification_policy": {
    "max_questions": 3,
    "rule": "缺少最低输入时先反问；只缺可选信息时使用默认值并说明。"
  },
  "contracts": [
    {
      "route_id": "content_processing",
      "required_fields": ["账号或资料范围", "媒介分支", "清洗统计", "完整粗学与选题池", "深学计划", "证据状态", "阻塞项"],
      "must_not": ["不修改原始资料", "不把 Top 清单当完整选题池", "不在处理阶段宣布账号方法成立", "不写正式账号中心"]
    },
    {
      "route_id": "account_learning",
      "required_fields": ["workflow_id", "阶段状态", "统一学习卡", "流派观察", "三重验证", "拒绝项", "RIA++方法", "压力测试", "生产交接", "账号Skill候选", "视觉参考候选状态", "生产角色覆盖", "视觉风险覆盖", "视觉来源隔离状态", "轻量数据源状态", "轻量内容数", "轻量方向数", "轻量manifest", "轻量数据源差异与缺口"],
      "must_not": ["不把单卡候选写成稳定方法", "不把账号内容写进系统 Skill", "不跳过用户确认门", "不直接激活账号 Skill", "不使用方向均衡轻量数据源替代生产视觉参考包", "不把账号视觉资产写入系统 Skill", "不把用户拒绝反例用于生成参考", "不跨账号补视觉正例", "不在候选阶段写正式轻量数据源", "不未经差异审核覆盖已有离线包", "NAS不可用时不删除旧包或用候选资产填充"]
    },
    {
      "route_id": "topic_generation",
      "required_fields": ["account_skill_id", "账号Skill版本", "选题标题", "受众", "问题", "方向", "角度", "机制", "流派", "查重状态", "真实新变量", "topic_id"],
      "must_not": ["不读取完整生产数据库", "不只换标题或关键词", "不绕过高度重复阻断", "不把选题写入正式知识"]
    },
    {
      "route_id": "script_generation",
      "required_fields": ["account_skill_id", "账号Skill版本", "topic_id", "content_id", "完整内容包", "内部溯源", "生产登记状态"],
      "must_not": ["不绕过账号 Skill", "不编造原句、经历、数据和结果", "不把内部字段写进成品正文", "不直接更新账号 Skill"]
    },
    {
      "route_id": "content_review",
      "required_fields": ["content_id", "topic_id", "account_skill_id", "账号Skill版本", "反馈证据", "问题诊断", "信号级别", "下一步动作"],
      "must_not": ["不猜看不清的字段", "不跨平台硬比", "不把单次反馈写成稳定规律", "不自动修改 active Skill"]
    },
    {
      "route_id": "user_setup",
      "required_fields": ["用户层目录", "账号Skill注册表", "生产数据库", "迁移状态", "验证结果"],
      "must_not": ["不复制其他用户真实数据", "不分享用户私有和本机配置", "不把账号Skill复制进系统层"]
    },
    {
      "route_id": "creator_db_export",
      "required_fields": ["博主名", "内容数量", "评论数量", "manifest", "外部写入状态"],
      "must_not": ["不修改原始数据库", "不默认导出评论", "不默认公开分享"]
    },
    {
      "route_id": "formal_retrieval",
      "required_fields": ["query", "scope", "filters", "retrieval", "count", "path", "evidence_coordinate", "snippet", "score_details", "chunk_sha256"],
      "must_not": ["不索引候选资产", "不索引原始资料", "不索引系统规则和Skill proposal", "不跨账号放宽精确过滤", "不把本地哈希向量冒充神经语义嵌入", "不返回无证据坐标的结论"]
    },
    {
      "route_id": "external_use",
      "required_fields": ["命中路由", "读取层级", "账号Skill状态", "用户层边界", "下一步"],
      "must_not": ["不默认扫原始资料", "不默认读取用户私有数据", "不把候选当正式知识"]
    },
    {
      "route_id": "system_audit",
      "required_fields": ["三套系统Skill", "用户层", "账号Skill", "生产记忆", "索引", "边界", "清理", "测试"],
      "must_not": ["不以窄测试证明全系统完成", "不删除原始资料", "不把归档当 active"]
    }
  ]
}
