{
  "version": "1.0",
  "updated_at": "2026-06-30",
  "clarification_policy": {
    "max_questions": 3,
    "rule": "固定高级入口缺少最低信息时先反问，不直接生成；只缺可选信息时可采用默认值并说明。"
  },
  "contracts": [
    {
      "route_id": "topic_generation",
      "name": "出选题输出契约",
      "required_fields": [
        "选题标题",
        "对应方法论",
        "受众痛点",
        "钩子角度",
        "核心观点",
        "对标知识库内容",
        "原链接或证据来源",
        "来源层级",
        "证据边界"
      ],
      "must_not": [
        "不把候选资产写成正式知识",
        "不编造原链接、source_id、收益或案例",
        "不只换关键词批量输出"
      ]
    },
    {
      "route_id": "script_generation",
      "name": "写文案/口播输出契约",
      "required_fields": [
        "黄金3s",
        "完整文案",
        "互动收尾",
        "对标知识库内容",
        "source_id",
        "原链接",
        "来源层级",
        "证据边界",
        "图文脚本包（仅图文分支）",
        "image2生成状态（仅图文分支）",
        "生图验收结果（仅图文分支）"
      ],
      "must_not": [
        "不直接反写正式知识",
        "不把粗扫线索写成已验证事实",
        "不复用同一个钩子批量套壳",
        "不在选题未确认时直接生图",
        "不让 image2 替代账号学习"
      ]
    },
    {
      "route_id": "account_learning",
      "name": "账号学习输出契约",
      "required_fields": [
        "workflow_id",
        "profile_id",
        "账号名",
        "阶段状态",
        "方向统计",
        "方向全量粗扫选题池",
        "Top/候补深学清单",
        "媒介分支",
        "图文结构化报告",
        "封面与分图结构学习结果",
        "OCR或视觉解析状态",
        "学习计划",
        "深度学习卡",
        "候选学习卡",
        "机器审计结果",
        "审核清单",
        "入库建议",
        "不能入库或需补证据内容",
        "下一阶段阻塞条件"
      ],
      "must_not": [
        "不直接写正式账号中心",
        "不自动创建正式子库",
        "不跳过审核注册表",
        "不把单一账号方向、模板或风格写成通用系统规则",
        "不把 Top 内容清单当成粗学与选题池全量结果",
        "不把 OCR 或图片结构化结果当成已审核账号知识"
      ]
    },
    {
      "route_id": "json_ingest",
      "name": "JSON 入库输出契约",
      "required_fields": [
        "数据盘点",
        "字段统计",
        "去重统计",
        "噪音判断",
        "keep/review/archive/discard 决策",
        "候选内容",
        "需用户确认事项"
      ],
      "must_not": [
        "不修改原始 JSON",
        "不删除原始资料",
        "不只按指标判断长期价值"
      ]
    },
    {
      "route_id": "screenshot_review",
      "name": "截图复盘输出契约",
      "required_fields": [
        "platform",
        "page_type",
        "content_id",
        "visible_metrics",
        "uncertain_metrics",
        "performance_signal",
        "next_review_action"
      ],
      "must_not": [
        "不猜测看不清的数字",
        "不单凭截图决定长期方法论有效",
        "不跨平台硬比"
      ]
    },
    {
      "route_id": "table_review",
      "name": "表格复盘输出契约",
      "required_fields": [
        "platform",
        "date_range",
        "rows",
        "columns",
        "best_items",
        "worst_items",
        "method_updates",
        "topic_updates",
        "uncertain_columns"
      ],
      "must_not": [
        "不混用不同平台字段定义",
        "不只看数字不看内容结构",
        "缺少内容文本时必须回查标题或案例"
      ]
    },
    {
      "route_id": "creator_db_export",
      "name": "博主数据导出输出契约",
      "required_fields": [
        "飞书链接",
        "内容数量",
        "评论数量",
        "分享权限读回状态",
        "本地 manifest 路径"
      ],
      "must_not": [
        "不修改原始数据库",
        "不默认导出评论",
        "不在未显式要求时打开公开分享",
        "不实时陪跑输出过程日志"
      ]
    },
    {
      "route_id": "skill_evolution",
      "name": "Skill 沉淀输出契约",
      "required_fields": [
        "适用范围",
        "触发条件",
        "证据",
        "拟变更规则",
        "风险",
        "验证用例",
        "回滚方式"
      ],
      "must_not": [
        "不直接覆盖 active Skill",
        "不把账号专属规则写成通用规则",
        "不把一次性反馈沉淀为长期规则"
      ]
    },
    {
      "route_id": "external_use",
      "name": "其他项目调用输出契约",
      "required_fields": [
        "调用入口",
        "命中路由",
        "读取层级",
        "允许使用范围",
        "禁止使用范围",
        "正式知识来源",
        "候选证据状态",
        "下一步调用建议"
      ],
      "must_not": [
        "不默认读取原始数据目录",
        "不默认读取未经审核候选资产",
        "不把项目外调用变成全库递归搜索",
        "不把未确认 proposal 当成 active 规则"
      ]
    },
    {
      "route_id": "system_audit",
      "name": "系统审计输出契约",
      "required_fields": [
        "入口状态",
        "active Skill",
        "待确认 proposal",
        "候选待审核",
        "账号中心状态",
        "最近学习状态",
        "验证结果",
        "建议下一步动作"
      ],
      "must_not": [
        "不把 history/proposals 当 active",
        "不忽略候选/正式边界",
        "不只报告文件存在而不检查路由"
      ]
    },
    {
      "route_id": "memory_capture",
      "name": "记忆捕获输出契约",
      "required_fields": [
        "记忆标题",
        "记忆类别",
        "目标层级",
        "复用理由",
        "敏感信息检查",
        "是否待确认",
        "建议写入位置",
        "判断分数",
        "生成或跳过原因"
      ],
      "must_not": [
        "不直接写入未确认长期记忆",
        "不把密钥或账号密码写入可同步目录",
        "不把一次性聊天过程沉淀为长期规则",
        "不在低于阈值时生成记忆候选"
      ]
    },
    {
      "route_id": "agent_registry",
      "name": "智能体登记输出契约",
      "required_fields": [
        "agent_id",
        "agent_name",
        "primary_function",
        "capabilities",
        "auth_status",
        "memory_scope",
        "blocked_actions"
      ],
      "must_not": [
        "不把逻辑角色误说成独立账号",
        "不在可分享文件写真实凭证",
        "不跳过用户私有层边界"
      ]
    }
  ]
}
