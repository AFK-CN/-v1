{
  "version": "2.9",
  "updated_at": "2026-07-19",
  "method": "RIA-TV++ adapted for account learning",
  "candidate_root": "10_Knowledge/candidates/account_learning_workflows",
  "card_contract": "00_System/shareable/config/account_learning_card_contract.json",
  "formal_write_allowed": false,
  "confirmation_gates": [
    "stage0_account_overview",
    "stage2_triple_verification"
  ],
  "stages": [
    {
      "id": "stage0_account_overview",
      "name": "整体账号理解",
      "principle": "Adler structural, interpretive, critical and applicability analysis",
      "required_artifacts": [
        "ACCOUNT_OVERVIEW.md",
        "ACCOUNT_OVERVIEW.json"
      ]
    },
    {
      "id": "stage1_parallel_extraction",
      "name": "五视角并行提取",
      "principle": "Independent extraction for positioning, topics, structures, expression and counterexamples",
      "required_artifacts": [
        "candidates/positioning.jsonl",
        "candidates/topics.jsonl",
        "candidates/structures.jsonl",
        "candidates/expression.jsonl",
        "candidates/counterexamples.jsonl",
        "candidates/publish_copy_observations.jsonl",
        "PUBLISH_COPY_SPECIAL_STUDY.json",
        "PUBLISH_COPY_SPECIAL_STUDY.md",
        "REAL_ACCEPTANCE_REPORT_<date>.md",
        "REAL_ACCEPTANCE_SUMMARY.json"
      ]
    },
    {
      "id": "stage2_triple_verification",
      "name": "三重验证筛选",
      "principle": "Consolidate five-lens observations into mechanism clusters, then verify cross-context evidence, predictive usefulness and account exclusivity",
      "required_artifacts": [
        "candidate_clusters.jsonl",
        "verified.jsonl",
        "rejected.jsonl"
      ]
    },
    {
      "id": "stage3_ria_construction",
      "name": "RIA++ 方法单元构造",
      "principle": "Reading, interpretation, past application, future trigger, execution and boundary",
      "required_artifacts": [
        "methods/"
      ]
    },
    {
      "id": "stage4_method_linking",
      "name": "跨卡机制聚合与验证",
      "principle": "Depends-on, contrasts-with and composes-with relations",
      "required_artifacts": [
        "METHOD_INDEX.json",
        "GLOSSARY.md"
      ]
    },
    {
      "id": "stage5_pressure_test",
      "name": "触发与边界压力测试",
      "principle": "Executed positive, lexical-decoy, edge, cross-scene transfer and sibling-method confusion tests with per-case evidence",
      "required_artifacts": [
        "methods/*/test-prompts.json",
        "methods/*/test-results.json"
      ]
    },
    {
      "id": "stage6_learning_delivery",
      "name": "学习交付与入库候选",
      "principle": "Candidate-only digest, promotion manifest and account production handoff; formal ingest remains approval-gated",
      "required_artifacts": [
        "LEARNING_DIGEST.md",
        "promotion_manifest.json",
        "ACCOUNT_PRODUCTION_HANDOFF.json",
        "VISUAL_REFERENCE_PROFILE.json",
        "visual_reference_candidate/manifest.json",
        "account_skill_candidate/SKILL.md",
        "account_skill_candidate/ACCOUNT_SKILL_MANIFEST.json",
        "account_skill_candidate/UPGRADE_COMPATIBILITY.json",
        "account_skill_candidate/account_views/账号整体方法论.md",
        "account_skill_candidate/account_views/内容生产使用说明.md",
        "account_skill_candidate/account_views/减少AI味输出规则.md",
        "account_skill_candidate/account_views/内容输出标准模板.md"
      ]
    }
  ],
