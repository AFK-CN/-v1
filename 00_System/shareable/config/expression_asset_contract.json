    "formal_write_allowed": false,
    "system_write_allowed": false,
    "cross_account_merge_allowed": false
  },
  "asset_types": {
    "hook": "负责在开头或内容过程中触发继续阅读或观看的结构；必须记录位置和功能，不保存账号原句为系统规则。",
    "golden_line": "承担命名、解释、判断、行动或身份表达功能的结构。",
    "sentence_pattern": "可复用的句法与节奏骨架，必须保留变量位和适用边界。",
    "structure_unit": "内容中的问题、行动、冲突、证据、转折、结果或收束等结构单元。",
    "transition": "段落、镜头或论证之间的承接与转场机制。",
    "opening_move": "进入主题前的动作与信息顺序。",
    "ending_move": "收束、行动提示、互动或回扣动作。",
    "pain_point": "受众问题、矛盾或阻力的可追溯表达。",
    "anti_pattern": "弱资产、失效结构、过度承诺或不可迁移表达。",
    "adaptation_template": "保留结构变量、删除身份绑定和账号措辞后的改编骨架。"
  },
