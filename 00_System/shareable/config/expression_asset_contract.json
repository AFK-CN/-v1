      "authority_record_id",
      "source_id",
      "source_type",
      "account_id",
      "source_path_or_url",
      "sha256",
      "authority_record_sha256"
    ],
    "source_file_hash_verification_required": true
  },
  "lifecycle": {
    "states": [
      "observed",
      "sampled",
      "retrieval_validated",
      "cross_card_verified",
      "pressure_tested",
      "approved_callable",
      "rejected"
    ],
    "default_state": "observed",
    "callable_states": [
      "approved_callable"
    ],
    "candidate_state_callable": false,
    "candidate_state_method_evidence_eligible": false,
    "candidate_state_generation_eligible": false,
    "transition_required_fields": ["from", "to", "evidence_coordinate", "evidence_sha256"],
    "transitions": [
      ["observed", "sampled"],
      ["sampled", "retrieval_validated"],
      ["retrieval_validated", "cross_card_verified"],
      ["cross_card_verified", "pressure_tested"],
      ["pressure_tested", "approved_callable"],
      ["observed", "rejected"],
      ["sampled", "rejected"],
      ["retrieval_validated", "rejected"],
      ["cross_card_verified", "rejected"],
      ["pressure_tested", "rejected"]
    ]
  },
  "score_contract": {
    "structural_usefulness_range": [0, 100],
    "structural_usefulness_means": "结构清晰度、可抽象性、可迁移性和风险可控性，不等于传播效果。",
    "performance_statuses": [
      "not_claimed",
      "observed_uncontrolled",
      "validated_with_evidence"
    ],
