{
  "version": "3.1",
  "updated_at": "2026-07-19",
  "status": "active_system_schema",
  "scope": "generic_contract_and_active_pipeline",
  "description": "表达资产候选的通用结构、七阶段接入、隔离、状态机和验收门。系统层不保存账号名、账号话术、source_id、具体金句或账号结论。",
  "activation_boundary": {
    "active_account_learning_integration": true,
    "proposal": "00_System/shareable/skills/proposals/account-learning-expression-assets-v3.0.md",
    "needs_user_confirmation": false,
    "confirmed_scope": "用户已确认只升级系统机制；不运行账号学习，不生成任何真实账号资产。",
    "current_behavior": "新建账号学习工作流默认接入表达资产链；历史工作流保持原 schema，只有显式迁移才启用。所有资产仍停留在候选层。"
  },
  "storage": {
    "candidate_root_template": "10_Knowledge/candidates/account_assets/expression_assets/{account_id}/",
