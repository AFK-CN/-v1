    "source_authority_root_template": "10_Knowledge/evidence/index/account_source_authority/{account_id}/",
    "performance_authority_root_template": "10_Knowledge/evidence/index/performance_authority/{account_id}/",
    "validation_evidence_root_template": "10_Knowledge/evidence/index/account_validation_authority/{account_id}/",
    "validator_version": "expression_asset_validator_v3.1",
    "derived_jsonl_files": {
      "hook": "hooks.jsonl",
      "golden_line": "golden_lines.jsonl",
      "sentence_pattern": "sentence_patterns.jsonl",
      "structure_unit": "structure_units.jsonl",
      "transition": "transitions.jsonl",
      "opening_move": "opening_moves.jsonl",
      "ending_move": "ending_moves.jsonl",
      "pain_point": "pain_points.jsonl",
      "adaptation_template": "adaptation_templates.jsonl",
      "anti_pattern": "anti_patterns.jsonl"
    },
    "pattern_files": [
      "表达资产总览.md",
      "钩子与留存机制图谱.md",
