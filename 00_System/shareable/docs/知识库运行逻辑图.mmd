flowchart LR
  U["用户 / 其他项目"] --> C["@知识库总控<br/>controller_routes.json"]

  subgraph SYSTEM["可迁移系统层 00_System/shareable"]
    P["内容处理 Skill<br/>接入 下载 解析 清洗 扫描 粗学"]
    L["账号学习 Skill<br/>单卡 多卡验证 RIA++ 压测 封装"]
    R["内容复盘 Skill<br/>反馈绑定 诊断 补学 升级提案"]
    SPEC["路由 契约 schema 代码 验证器"]
  end

  subgraph KNOWLEDGE["知识层 10_Knowledge"]
    CAND["候选证据与学习产物"]
    CSKILL["不可调用的账号 Skill 候选包"]
    ACCOUNT["正式账号中心"]
    ASKILL["账号 Skill<br/>production style boundaries acceptance"]
  end

  subgraph USER["本机用户层 20_User"]
    REG["账号 Skill 注册表"]
    DB["生产记忆 SQLite<br/>topics productions feedback"]
    PRIVATE["反馈 私有内容 本机配置"]
  end

  RAW["链接 SQLite NAS 本地资料<br/>原始资料只读"] --> P
  P --> CAND --> L
  L --> CSKILL
  CSKILL -->|"用户审核通过"| ASKILL
  ACCOUNT --> ASKILL
  REG --> ASKILL

  C --> P
  C --> L
  C -->|"出选题 / 写内容"| REG
  ASKILL --> PROD["内容生产"]
  DB -->|"代码只返回少量查重摘要"| PROD
  PROD -->|"登记 topic_id content_id Skill版本"| DB
  PROD --> PUBLISH["发布与反馈"]
  PUBLISH --> R
  DB -->|"单 content_id 上下文"| R
  PRIVATE --> R
  R -->|"定向补学"| L
  R -->|"用户批准的账号 Skill 更新提案"| ASKILL

  SPEC -.约束.-> P
  SPEC -.约束.-> L
  SPEC -.约束.-> R

  RULE["硬边界<br/>系统 Skill 不含账号内容<br/>候选不可调用<br/>不加载完整数据库<br/>不自动记忆或自动进化<br/>原始资料不删除不修改"]
  RULE -.-> C
  RULE -.-> SYSTEM
  RULE -.-> USER
