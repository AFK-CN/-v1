{
  "version": "v1",
  "status": "proposal",
  "created_at": "2026-06-28",
  "workflow_model": "staged_single_executor",
  "workflow_id": "account_material_cleaning_learning",
  "workflow_name": "账号资料清洗与学习工作流",
  "activation_requires_user_confirmation": true,
  "executor_policy": {
    "executor": "main_codex_session",
    "use_agents_by_default": false,
    "use_agents_only_when_user_explicitly_requests": true,
    "trace_path_template": "00_System/runtime/workflows/{workflow_run_id}/workflow_trace.json",
    "must_report_stage_status": true
  },
  "stages": [
    {
      "stage_id": "intake",
      "stage_name": "立项与边界",
      "required_inputs": ["account_name_or_scope", "source_scope", "target_stage"],
      "actions": ["select_route", "declare_boundaries", "create_workflow_trace"],
      "tools": ["controller_routes", "task_entry_index"],
      "required_outputs": ["workflow_plan", "workflow_trace"],
      "pass_conditions": ["route_selected", "boundaries_declared", "no_default_full_scan"]
    },
    {
      "stage_id": "source_cleaning",
      "stage_name": "资料接入与清洗",
      "required_inputs": ["source_locator"],
      "actions": ["read_source_readonly", "field_stats", "dedupe", "write_candidate_summary"],
      "tools": ["tools.kb.cli sqlite-ingest", "tools.sqlite_ingest"],
      "required_outputs": ["candidate_records", "cleaning_report"],
      "pass_conditions": ["raw_source_readonly", "dedupe_stats_present", "candidate_summary_written"]
    },
    {
      "stage_id": "rough_scan",
      "stage_name": "选题粗扫",
      "required_inputs": ["candidate_records"],
      "actions": ["classify_directions", "rank_candidates", "identify_review_items", "write_deep_learning_scope"],
      "tools": ["tools.content_rough_scan", "tools.video_learning scan", "tools.video_learning select"],
      "required_outputs": ["rough_scan_report", "deep_learning_scope", "validation_report"],
      "pass_conditions": ["scope_count_verified", "review_items_explicit", "no_hidden_total_limit"]
    },
    {
      "stage_id": "learning_plan",
      "stage_name": "学习计划",
      "required_inputs": ["deep_learning_scope"],
      "actions": ["split_video_text_image", "write_learning_plan", "write_download_plan"],
      "tools": ["tools.video_learning select"],
      "required_outputs": ["learning_plan", "download_plan"],
      "pass_conditions": ["planned_count_verified", "excluded_items_explained"]
    },
    {
      "stage_id": "media",
      "stage_name": "媒体下载与证据补齐",
      "required_inputs": ["download_plan"],
      "actions": ["download_video", "download_or_index_images", "validate_media", "report_failures"],
      "tools": ["tools.video_learning download", "ffprobe"],
      "required_outputs": ["download_report", "artifact_validation"],
      "pass_conditions": ["platform_prefix_verified", "failed_items_explicit", "local_artifacts_valid_or_missing_explained"]
    },
    {
      "stage_id": "deep_learning",
      "stage_name": "深度学习",
      "required_inputs": ["learning_plan", "media_artifacts"],
      "actions": ["write_selected_cards", "write_learned_cards", "transcribe_videos", "detect_scenes"],
      "tools": ["tools.video_learning learn"],
      "required_outputs": ["selected_deep_cards", "learned_cards", "transcripts", "scene_reports"],
      "pass_conditions": ["card_count_matches_scope", "video_artifacts_valid", "text_image_items_not_dropped"]
    },
    {
      "stage_id": "audit",
      "stage_name": "机器审计",
      "required_inputs": ["learned_cards", "deep_learning_scope"],
      "actions": ["check_missing", "check_structure", "check_evidence", "check_similarity", "check_repeated_passages"],
      "tools": ["tools.video_learning_audit"],
      "required_outputs": ["machine_audit", "similarity_pairs", "repeated_passages"],
      "pass_conditions": ["missing_cards_zero", "review_items_resolved_or_blocked", "duplicates_reviewed"]
    },
    {
      "stage_id": "formal_dry_run",
      "stage_name": "正式入库预览",
      "required_inputs": ["machine_audit"],
      "actions": ["run_formal_ingest_dry_run", "verify_counts"],
      "tools": ["tools.video_learning_account_ingest --dry-run"],
      "required_outputs": ["formal_ingest_preview"],
      "pass_conditions": ["direction_count_matches", "card_count_matches", "transcript_count_verified"]
    },
    {
      "stage_id": "formal_ingest",
      "stage_name": "正式入库",
      "required_inputs": ["formal_ingest_preview", "user_confirmation_or_prior_explicit_request"],
      "actions": ["write_formal_account_center", "write_global_account_index", "clean_stale_status_terms", "validate_system"],
      "tools": ["tools.video_learning_account_ingest", "tools.kb.cli validate-system"],
      "required_outputs": ["formal_account_center", "global_account_index", "acceptance_report"],
      "pass_conditions": ["formal_counts_match", "stale_status_terms_zero", "global_index_hit", "validate_system_ok"]
    },
    {
      "stage_id": "nas_backup",
      "stage_name": "NAS 备份",
      "required_inputs": ["formal_account_center", "nas_mount_path"],
      "actions": ["check_nas_mount", "copy_backup", "write_backup_manifest", "readback_validate"],
      "tools": ["local_copy_with_readback", "tools.video_learning nas-index"],
      "required_outputs": ["nas_backup_manifest", "readback_validation"],
      "pass_conditions": ["nas_mounted", "backup_manifest_written", "readback_ok"]
    },
    {
      "stage_id": "memory_handoff",
      "stage_name": "交接和记忆候选",
      "required_inputs": ["workflow_results", "reusable_rules"],
      "actions": ["write_handoff_summary", "evaluate_memory_candidate"],
      "tools": ["tools.kb.cli memory --evaluate-text"],
      "required_outputs": ["handoff_summary", "pending_memory_candidate_if_worthwhile"],
      "pass_conditions": ["no_sensitive_secret_written", "handoff_clear"]
    }
  ]
}
