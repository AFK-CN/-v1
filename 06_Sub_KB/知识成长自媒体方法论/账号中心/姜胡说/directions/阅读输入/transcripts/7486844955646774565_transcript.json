{
  "language": "zh",
  "duration": 58.6768125,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 2.16,
      "text": "一个小时就可以改变得一声"
    },
    {
      "index": 2,
      "start": 2.16,
      "end": 3.2,
      "text": "我不是在看下"
    },
    {
      "index": 3,
      "start": 3.2,
      "end": 6.4,
      "text": "我是非常认真的和达分享这句话"
    },
    {
      "index": 4,
      "start": 6.4,
      "end": 10.4,
      "text": "这是一个非常实潮的技能"
    },
    {
      "index": 5,
      "start": 10.4,
      "end": 12.8,
      "text": "首先和达分享一个努静"
    },
    {
      "index": 6,
      "start": 12.8,
      "end": 16.4,
      "text": "如果你掌握的支持技能"
    },
    {
      "index": 7,
      "start": 16.4,
      "end": 18.2,
      "text": "对别人有用"
    },
    {
      "index": 8,
      "start": 18.2,
      "end": 21.0,
      "text": "你就能获取财富"
    },
    {
      "index": 9,
      "start": 21.0,
      "end": 22.2,
      "text": "大思考一下"
    },
    {
      "index": 10,
      "start": 22.2,
      "end": 23.8,
      "text": "这是一个令类的便宜服"
    },
    {
      "index": 11,
      "start": 23.8,
      "end": 24.84,
      "text": "就是你提供的"
    },
    {
      "index": 12,
      "start": 24.84,
      "end": 25.8,
      "text": "你所擅长的"
    },
    {
      "index": 13,
      "start": 25.8,
      "end": 27.6,
      "text": "你所拥有的"
    },
    {
      "index": 14,
      "start": 27.6,
      "end": 29.2,
      "text": "然后别人需要"
    },
    {
      "index": 15,
      "start": 29.2,
      "end": 30.8,
      "text": "然后两者批配了"
    },
    {
      "index": 16,
      "start": 30.8,
      "end": 33.2,
      "text": "那么你就能获得实常"
    },
    {
      "index": 17,
      "start": 33.2,
      "end": 35.2,
      "text": "那么真正的问题是什么呢"
    },
    {
      "index": 18,
      "start": 35.2,
      "end": 36.8,
      "text": "就是很多人没有气能"
    },
    {
      "index": 19,
      "start": 36.8,
      "end": 38.4,
      "text": "我见过很多人问这个问题"
    },
    {
      "index": 20,
      "start": 38.4,
      "end": 39.4,
      "text": "获得歌我没有气能"
    },
    {
      "index": 21,
      "start": 39.4,
      "end": 40.2,
      "text": "我该这么准强"
    },
    {
      "index": 22,
      "start": 40.2,
      "end": 41.2,
      "text": "那没办法"
    },
    {
      "index": 23,
      "start": 41.2,
      "end": 42.6,
      "text": "你一直能靠"
    },
    {
      "index": 24,
      "start": 42.6,
      "end": 43.8,
      "text": "靠出卖世界"
    },
    {
      "index": 25,
      "start": 43.8,
      "end": 45.6,
      "text": "但这就是一个差一点"
    },
    {
      "index": 26,
      "start": 45.6,
      "end": 47.6,
      "text": "就很多人遇到一个气能"
    },
    {
      "index": 27,
      "start": 47.6,
      "end": 48.2,
      "text": "我不会"
    },
    {
      "index": 28,
      "start": 48.2,
      "end": 49.8,
      "text": "我一点气能都没有"
    },
    {
      "index": 29,
      "start": 49.8,
      "end": 51.2,
      "text": "我不会啊"
    },
    {
      "index": 30,
      "start": 51.2,
      "end": 51.6,
      "text": "对吧"
    },
    {
      "index": 31,
      "start": 51.6,
      "end": 52.6,
      "text": "这里边有两个角色"
    },
    {
      "index": 32,
      "start": 52.6,
      "end": 54.0,
      "text": "一个是你不会"
    },
    {
      "index": 33,
      "start": 54.0,
      "end": 56.2,
      "text": "然后你继续不会"
    },
    {
      "index": 34,
      "start": 56.2,
      "end": 57.4,
      "text": "还有一种什么的"
    },
    {
      "index": 35,
      "start": 57.4,
      "end": 58.2,
      "text": "不会"
    },
    {
      "index": 36,
      "start": 58.2,
      "end": 59.2,
      "text": "我给你"
    }
  ]
}