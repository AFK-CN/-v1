{
  "language": "zh",
  "duration": 85.056125,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 3.52,
      "text": "一定要利用自媒體給更多的人分享假設"
    },
    {
      "index": 2,
      "start": 3.52,
      "end": 4.16,
      "text": "為什麼"
    },
    {
      "index": 3,
      "start": 4.16,
      "end": 6.4,
      "text": "因為在你的那個場裡"
    },
    {
      "index": 4,
      "start": 6.4,
      "end": 9.04,
      "text": "你就在那麽一個小現場裡"
    },
    {
      "index": 5,
      "start": 9.04,
      "end": 10.8,
      "text": "你們之間的博弈"
    },
    {
      "index": 6,
      "start": 10.8,
      "end": 13.52,
      "text": "往往是靈和博弈"
    },
    {
      "index": 7,
      "start": 13.52,
      "end": 15.12,
      "text": "但是"
    },
    {
      "index": 8,
      "start": 15.12,
      "end": 18.56,
      "text": "如果你把這個信息分享給世界各地的人"
    },
    {
      "index": 9,
      "start": 18.56,
      "end": 21.12,
      "text": "全國各地的人"
    },
    {
      "index": 10,
      "start": 21.12,
      "end": 22.4,
      "text": "你會發現"
    },
    {
      "index": 11,
      "start": 22.4,
      "end": 25.36,
      "text": "這個時候你已經不是在把靈和博弈"
    },
    {
      "index": 12,
      "start": 25.36,
      "end": 27.36,
      "text": "你在玩供應博弈"
    },
    {
      "index": 13,
      "start": 27.36,
      "end": 29.68,
      "text": "給大家兩個才你們感受一下"
    },
    {
      "index": 14,
      "start": 29.68,
      "end": 31.76,
      "text": "第一個叫室用裝"
    },
    {
      "index": 15,
      "start": 31.76,
      "end": 34.48,
      "text": "讓你在網絡上給別人分享一些"
    },
    {
      "index": 16,
      "start": 34.48,
      "end": 35.6,
      "text": "支持的時候"
    },
    {
      "index": 17,
      "start": 35.6,
      "end": 37.52,
      "text": "一些經驗的時候"
    },
    {
      "index": 18,
      "start": 37.52,
      "end": 40.08,
      "text": "其實就是室用裝"
    },
    {
      "index": 19,
      "start": 40.08,
      "end": 40.8,
      "text": "對"
    },
    {
      "index": 20,
      "start": 40.8,
      "end": 42.8,
      "text": "我發視頻也是室用裝"
    },
    {
      "index": 21,
      "start": 42.8,
      "end": 44.48,
      "text": "而且我發視頻"
    },
    {
      "index": 22,
      "start": 44.48,
      "end": 45.92,
      "text": "我會全盤給你發"
    },
    {
      "index": 23,
      "start": 45.92,
      "end": 47.52,
      "text": "我有什麽想法就給大家發"
    },
    {
      "index": 24,
      "start": 47.52,
      "end": 48.08,
      "text": "你們會說"
    },
    {
      "index": 25,
      "start": 48.08,
      "end": 49.2,
      "text": "那你是不是長了業的"
    },
    {
      "index": 26,
      "start": 49.2,
      "end": 50.48,
      "text": "我告訴你我不會長了業的"
    },
    {
      "index": 27,
      "start": 50.48,
      "end": 51.44,
      "text": "我就是發"
    },
    {
      "index": 28,
      "start": 51.44,
      "end": 52.64,
      "text": "你們知道為什麼"
    },
    {
      "index": 29,
      "start": 52.64,
      "end": 56.08,
      "text": "我是一個飯店的廚師"
    },
    {
      "index": 30,
      "start": 56.08,
      "end": 57.12,
      "text": "我在"
    },
    {
      "index": 31,
      "start": 57.12,
      "end": 58.48,
      "text": "我就全程告訴你"
    },
    {
      "index": 32,
      "start": 58.48,
      "end": 60.48,
      "text": "我的飯是怎麽做的"
    },
    {
      "index": 33,
      "start": 60.48,
      "end": 62.56,
      "text": "你會認為我多幾個同行出來"
    },
    {
      "index": 34,
      "start": 62.56,
      "end": 64.08,
      "text": "我告訴你不是的"
    },
    {
      "index": 35,
      "start": 64.08,
      "end": 66.64,
      "text": "我會多更多的用戶出來"
    },
    {
      "index": 36,
      "start": 66.64,
      "end": 68.48,
      "text": "那有人說有人就學的你"
    },
    {
      "index": 37,
      "start": 68.48,
      "end": 69.6,
      "text": "開的你家對面啊"
    },
    {
      "index": 38,
      "start": 69.6,
      "end": 71.92,
      "text": "你放心他幹不過我"
    },
    {
      "index": 39,
      "start": 71.92,
      "end": 74.32,
      "text": "你知道他為什麼幹不過我嗎"
    },
    {
      "index": 40,
      "start": 74.32,
      "end": 75.2,
      "text": "因為"
    },
    {
      "index": 41,
      "start": 75.2,
      "end": 76.88,
      "text": "在他那吃"
    },
    {
      "index": 42,
      "start": 76.88,
      "end": 79.2,
      "text": "吃的是排骨米飯"
    },
    {
      "index": 43,
      "start": 79.2,
      "end": 81.04,
      "text": "到我這吃"
    },
    {
      "index": 44,
      "start": 81.04,
      "end": 82.96,
      "text": "吃的是排骨米飯"
    },
    {
      "index": 45,
      "start": 82.96,
      "end": 84.96,
      "text": "和信任的連結"
    }
  ]
}