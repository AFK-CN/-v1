{
  "language": "zh",
  "duration": 455.4608125,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 2.24,
      "text": "这两天吃床发了"
    },
    {
      "index": 2,
      "start": 2.24,
      "end": 3.18,
      "text": "这个顺庄"
    },
    {
      "index": 3,
      "start": 5.9,
      "end": 7.68,
      "text": "这个才是做自媒体"
    },
    {
      "index": 4,
      "start": 7.94,
      "end": 8.96,
      "text": "开我的样子"
    },
    {
      "index": 5,
      "start": 9.22,
      "end": 10.74,
      "text": "今天和大家分享的"
    },
    {
      "index": 6,
      "start": 11.0,
      "end": 12.8,
      "text": "一条纯纯的感觉"
    },
    {
      "index": 7,
      "start": 13.06,
      "end": 15.1,
      "text": "就是到底该怎么做自媒体"
    },
    {
      "index": 8,
      "start": 15.36,
      "end": 17.14,
      "text": "一些有那些军体识操的"
    },
    {
      "index": 9,
      "start": 17.4,
      "end": 18.18,
      "text": "方法"
    },
    {
      "index": 10,
      "start": 18.44,
      "end": 19.96,
      "text": "你肯定会有一道理我问题"
    },
    {
      "index": 11,
      "start": 19.96,
      "end": 21.5,
      "text": "就是你准备的好几号"
    },
    {
      "index": 12,
      "start": 21.76,
      "end": 23.3,
      "text": "结果拍完以后呢"
    },
    {
      "index": 13,
      "start": 23.8,
      "end": 24.84,
      "text": "根本就没人看"
    },
    {
      "index": 14,
      "start": 25.1,
      "end": 25.34,
      "text": "对吧"
    },
    {
      "index": 15,
      "start": 25.6,
      "end": 27.14,
      "text": "这就多一点了"
    },
    {
      "index": 16,
      "start": 27.64,
      "end": 28.16,
      "text": "为什么"
    },
    {
      "index": 17,
      "start": 28.16,
      "end": 30.2,
      "text": "各位好好体会的优号"
    },
    {
      "index": 18,
      "start": 30.72,
      "end": 31.74,
      "text": "自媒体"
    },
    {
      "index": 19,
      "start": 32.5,
      "end": 34.04,
      "text": "不是输出"
    },
    {
      "index": 20,
      "start": 34.56,
      "end": 37.12,
      "text": "而是制造对话"
    },
    {
      "index": 21,
      "start": 37.88,
      "end": 38.92,
      "text": "你好好体会理一下"
    },
    {
      "index": 22,
      "start": 39.68,
      "end": 41.48,
      "text": "那个内容他是火材"
    },
    {
      "index": 23,
      "start": 41.74,
      "end": 42.76,
      "text": "但是对话"
    },
    {
      "index": 24,
      "start": 43.52,
      "end": 44.8,
      "text": "才是火"
    },
    {
      "index": 25,
      "start": 46.34,
      "end": 48.64,
      "text": "给大家分享一个非常具体的案例"
    },
    {
      "index": 26,
      "start": 49.4,
      "end": 50.18,
      "text": "你像"
    },
    {
      "index": 27,
      "start": 50.44,
      "end": 52.24,
      "text": "我呢就平时就是哪个"
    },
    {
      "index": 28,
      "start": 52.48,
      "end": 54.52,
      "text": "哪个大脸对我刚来是有这样"
    },
    {
      "index": 29,
      "start": 54.78,
      "end": 56.32,
      "text": "有些说直播的时候"
    },
    {
      "index": 30,
      "start": 56.78,
      "end": 58.12,
      "text": "就上来又说还有一肥化"
    },
    {
      "index": 31,
      "start": 58.38,
      "end": 59.9,
      "text": "就是就是哪个脸对象就"
    },
    {
      "index": 32,
      "start": 60.16,
      "end": 61.44,
      "text": "就和大家老客流条"
    },
    {
      "index": 33,
      "start": 61.96,
      "end": 64.52,
      "text": "第一的时候的你就是2000"
    },
    {
      "index": 34,
      "start": 64.78,
      "end": 65.28,
      "text": "再见"
    },
    {
      "index": 35,
      "start": 65.54,
      "end": 66.56,
      "text": "我最高的时候一万多"
    },
    {
      "index": 36,
      "start": 66.82,
      "end": 68.1,
      "text": "都是同时在建议人数"
    },
    {
      "index": 37,
      "start": 68.36,
      "end": 70.4,
      "text": "可是我一旦放弹一些"
    },
    {
      "index": 38,
      "start": 71.16,
      "end": 72.7,
      "text": "放弹一些切件"
    },
    {
      "index": 39,
      "start": 73.22,
      "end": 75.52,
      "text": "然后这个内容是非常非常干的"
    },
    {
      "index": 40,
      "start": 76.04,
      "end": 76.8,
      "text": "流量马上就下来"
    },
    {
      "index": 41,
      "start": 77.06,
      "end": 78.84,
      "text": "我前两个有"
    },
    {
      "index": 42,
      "start": 79.1,
      "end": 80.14,
      "text": "我算是放弹了"
    },
    {
      "index": 43,
      "start": 80.38,
      "end": 81.66,
      "text": "服误的从事"
    },
    {
      "index": 44,
      "start": 81.92,
      "end": 82.68,
      "text": "就上台"
    },
    {
      "index": 45,
      "start": 82.94,
      "end": 84.48,
      "text": "那时候那个如果是花了"
    },
    {
      "index": 46,
      "start": 84.48,
      "end": 85.5,
      "text": "六期三大样"
    },
    {
      "index": 47,
      "start": 85.76,
      "end": 86.78,
      "text": "好拍拍摄"
    },
    {
      "index": 48,
      "start": 87.04,
      "end": 89.34,
      "text": "大家可以看那个小伙有人看过那种视频吗"
    },
    {
      "index": 49,
      "start": 89.6,
      "end": 92.42,
      "text": "那个是干活存存的干活三个小时"
    },
    {
      "index": 50,
      "start": 92.68,
      "end": 94.46,
      "text": "那种我都是体现准备好的"
    },
    {
      "index": 51,
      "start": 94.72,
      "end": 97.02,
      "text": "然后很认真地去准备"
    },
    {
      "index": 52,
      "start": 97.28,
      "end": 98.04,
      "text": "然后去沟通"
    },
    {
      "index": 53,
      "start": 98.82,
      "end": 100.1,
      "text": "但是那条视频的"
    },
    {
      "index": 54,
      "start": 100.36,
      "end": 102.4,
      "text": "播放量是非常非常差的"
    },
    {
      "index": 55,
      "start": 103.42,
      "end": 104.18,
      "text": "然后我还在这想"
    },
    {
      "index": 56,
      "start": 104.44,
      "end": 106.24,
      "text": "为什么一条有用的那种"
    },
    {
      "index": 57,
      "start": 106.5,
      "end": 107.52,
      "text": "别人不愿意看呢"
    },
    {
      "index": 58,
      "start": 107.78,
      "end": 109.56,
      "text": "我算是画了好长时间"
    },
    {
      "index": 59,
      "start": 110.08,
      "end": 112.64,
      "text": "我去研究它你们能想到是什么原因吗"
    },
    {
      "index": 60,
      "start": 112.9,
      "end": 114.44,
      "text": "我后来用了一个小方法"
    },
    {
      "index": 61,
      "start": 114.68,
      "end": 116.54,
      "text": "马上不放量就下了就上去了"
    },
    {
      "index": 62,
      "start": 117.3,
      "end": 118.32,
      "text": "大家找了怎么做的吗"
    },
    {
      "index": 63,
      "start": 118.82,
      "end": 119.86,
      "text": "就是我在"
    },
    {
      "index": 64,
      "start": 121.64,
      "end": 123.44,
      "text": "剪切削短视频之前"
    },
    {
      "index": 65,
      "start": 123.7,
      "end": 125.74,
      "text": "我记乎什么的没办法就是剪切短视频之前"
    },
    {
      "index": 66,
      "start": 126.0,
      "end": 126.78,
      "text": "我加了一段"
    },
    {
      "index": 67,
      "start": 127.02,
      "end": 127.54,
      "text": "独白"
    },
    {
      "index": 68,
      "start": 127.8,
      "end": 128.56,
      "text": "就提上一个那样说"
    },
    {
      "index": 69,
      "start": 128.82,
      "end": 130.1,
      "text": "我前两天放弹了谁谁"
    },
    {
      "index": 70,
      "start": 130.6,
      "end": 131.12,
      "text": "然后呢"
    },
    {
      "index": 71,
      "start": 131.38,
      "end": 132.66,
      "text": "为什么要放弹弹"
    },
    {
      "index": 72,
      "start": 132.92,
      "end": 136.5,
      "text": "然后这段视频我给大家准备提供什么"
    },
    {
      "index": 73,
      "start": 136.76,
      "end": 137.78,
      "text": "然后流量一些上来"
    },
    {
      "index": 74,
      "start": 138.54,
      "end": 139.32,
      "text": "可以为什么呢"
    },
    {
      "index": 75,
      "start": 139.82,
      "end": 141.1,
      "text": "因为我在放弹"
    },
    {
      "index": 76,
      "start": 141.62,
      "end": 143.92,
      "text": "上那时候我们俩是主缺"
    },
    {
      "index": 77,
      "start": 144.12,
      "end": 147.76,
      "text": "大家在看我们俩这个时候的内容是传播"
    },
    {
      "index": 78,
      "start": 148.78,
      "end": 151.6,
      "text": "但是我一上来拍一条堆不白我就和大量聊了"
    },
    {
      "index": 79,
      "start": 151.86,
      "end": 152.88,
      "text": "我说我之前俩拍了"
    },
    {
      "index": 80,
      "start": 153.14,
      "end": 154.16,
      "text": "放弹了上弹了"
    },
    {
      "index": 81,
      "start": 154.42,
      "end": 157.48,
      "text": "然后我就想到什么注意这个时候我是在盒里堆花"
    },
    {
      "index": 82,
      "start": 157.74,
      "end": 161.32,
      "text": "然后我和上那房移成为了我们这次对话的"
    },
    {
      "index": 83,
      "start": 161.58,
      "end": 162.36,
      "text": "素材"
    },
    {
      "index": 84,
      "start": 163.12,
      "end": 164.92,
      "text": "所以各位思考也就我们上学的时候"
    },
    {
      "index": 85,
      "start": 165.42,
      "end": 166.7,
      "text": "一个老师讲在好"
    },
    {
      "index": 86,
      "start": 166.96,
      "end": 169.0,
      "text": "还你听了是不是想睡觉睡觉"
    },
    {
      "index": 87,
      "start": 169.26,
      "end": 170.28,
      "text": "就这样睡着了对不对"
    },
    {
      "index": 88,
      "start": 170.54,
      "end": 173.18,
      "text": "但是如果老实在盒里堆花了在盒里"
    },
    {
      "index": 89,
      "start": 173.18,
      "end": 174.72,
      "text": "郭通在盒里提问"
    },
    {
      "index": 90,
      "start": 175.22,
      "end": 177.78,
      "text": "这个时候你的脑袭包就会为几乎"
    },
    {
      "index": 91,
      "start": 178.04,
      "end": 182.92,
      "text": "然后我们的对话会成为这次刻堂内容的一部分"
    },
    {
      "index": 92,
      "start": 184.18,
      "end": 184.7,
      "text": "所以各位"
    },
    {
      "index": 93,
      "start": 185.46,
      "end": 186.74,
      "text": "好好体会的句话"
    },
    {
      "index": 94,
      "start": 187.0,
      "end": 189.56,
      "text": "自没提本身不是"
    },
    {
      "index": 95,
      "start": 190.08,
      "end": 190.84,
      "text": "传播"
    },
    {
      "index": 96,
      "start": 191.1,
      "end": 193.14,
      "text": "而是制造对话"
    },
    {
      "index": 97,
      "start": 193.92,
      "end": 194.42,
      "text": "我们"
    },
    {
      "index": 98,
      "start": 194.94,
      "end": 196.98,
      "text": "这个内容是什么呢是直选"
    },
    {
      "index": 99,
      "start": 197.24,
      "end": 198.26,
      "text": "但是对话"
    },
    {
      "index": 100,
      "start": 199.04,
      "end": 199.54,
      "text": "糊粉"
    },
    {
      "index": 101,
      "start": 199.8,
      "end": 201.86,
      "text": "我打算大家就就提回来了"
    },
    {
      "index": 102,
      "start": 202.32,
      "end": 203.66,
      "text": "有请大家可以看一下马斯科"
    },
    {
      "index": 103,
      "start": 204.04,
      "end": 205.18,
      "text": "他在推特里边"
    },
    {
      "index": 104,
      "start": 205.44,
      "end": 206.46,
      "text": "随便发条件"
    },
    {
      "index": 105,
      "start": 206.72,
      "end": 207.24,
      "text": "这么留言呢"
    },
    {
      "index": 106,
      "start": 207.5,
      "end": 208.0,
      "text": "他说"
    },
    {
      "index": 107,
      "start": 208.26,
      "end": 209.54,
      "text": "Ni会去带人内吗"
    },
    {
      "index": 108,
      "start": 209.8,
      "end": 212.36,
      "text": "我一下下面试试一条评论"
    },
    {
      "index": 109,
      "start": 214.4,
      "end": 216.7,
      "text": "我在刚来"
    },
    {
      "index": 110,
      "start": 216.96,
      "end": 218.5,
      "text": "短片明台之前"
    },
    {
      "index": 111,
      "start": 218.76,
      "end": 221.58,
      "text": "来的时候呢有一个诸名的创听教练"
    },
    {
      "index": 112,
      "start": 221.84,
      "end": 222.6,
      "text": "一个朋友"
    },
    {
      "index": 113,
      "start": 223.36,
      "end": 225.16,
      "text": "我来的时候他30万分次"
    },
    {
      "index": 114,
      "start": 225.92,
      "end": 227.72,
      "text": "我30万分次的时候他30万分次"
    },
    {
      "index": 115,
      "start": 228.22,
      "end": 230.28,
      "text": "我30万分次的时候他还是30万分次"
    },
    {
      "index": 116,
      "start": 230.48,
      "end": 232.84,
      "text": "我30万分次的时候他还是30万分次"
    },
    {
      "index": 117,
      "start": 233.6,
      "end": 234.64,
      "text": "还还掉了几个份"
    },
    {
      "index": 118,
      "start": 235.14,
      "end": 235.92,
      "text": "后来呢"
    },
    {
      "index": 119,
      "start": 236.42,
      "end": 238.98,
      "text": "我们在机场见面了他就问我说你这个"
    },
    {
      "index": 120,
      "start": 239.24,
      "end": 240.26,
      "text": "四媒体怎么怎么"
    },
    {
      "index": 121,
      "start": 240.52,
      "end": 241.28,
      "text": "长得这么快"
    },
    {
      "index": 122,
      "start": 241.8,
      "end": 243.34,
      "text": "为什么我就只不不起来了"
    },
    {
      "index": 123,
      "start": 243.6,
      "end": 245.38,
      "text": "我说因为你是老师"
    },
    {
      "index": 124,
      "start": 246.16,
      "end": 247.18,
      "text": "我是哥们"
    },
    {
      "index": 125,
      "start": 247.44,
      "end": 249.48,
      "text": "所以人们都愿意和哥们够通"
    },
    {
      "index": 126,
      "start": 251.02,
      "end": 253.32,
      "text": "旁边明白他说他具体怎么做那种很简单"
    },
    {
      "index": 127,
      "start": 253.58,
      "end": 255.62,
      "text": "我会恢复大家的留言"
    },
    {
      "index": 128,
      "start": 256.9,
      "end": 258.44,
      "text": "所以各位体会一些最有话"
    },
    {
      "index": 129,
      "start": 258.9,
      "end": 262.02,
      "text": "你的评论区是你内容的"
    },
    {
      "index": 130,
      "start": 262.28,
      "end": 264.32,
      "text": "第2现场"
    },
    {
      "index": 131,
      "start": 265.6,
      "end": 267.66,
      "text": "给大家介绍一些非常实际潮的方法"
    },
    {
      "index": 132,
      "start": 267.92,
      "end": 268.94,
      "text": "到底该怎么做"
    },
    {
      "index": 133,
      "start": 269.2,
      "end": 271.24,
      "text": "首先第1个在你拍特短视频之前"
    },
    {
      "index": 134,
      "start": 271.5,
      "end": 273.8,
      "text": "你就必须有"
    },
    {
      "index": 135,
      "start": 274.06,
      "end": 276.62,
      "text": "我在和大家溝通聊天的"
    },
    {
      "index": 136,
      "start": 276.88,
      "end": 277.64,
      "text": "这样一个心态"
    },
    {
      "index": 137,
      "start": 278.4,
      "end": 280.2,
      "text": "我刚来"
    },
    {
      "index": 138,
      "start": 280.46,
      "end": 283.78,
      "text": "短视频之前啊你们知道吗刚拍的时候我之前的时候"
    },
    {
      "index": 139,
      "start": 284.56,
      "end": 288.4,
      "text": "我说话都是专业时候你又今天会给一些打垃圾的做自行吗"
    },
    {
      "index": 140,
      "start": 288.64,
      "end": 289.2,
      "text": "然后呢"
    },
    {
      "index": 141,
      "start": 289.46,
      "end": 292.28,
      "text": "说的都是专业数比较重要的会加一些英文"
    },
    {
      "index": 142,
      "start": 293.04,
      "end": 294.84,
      "text": "你们有着看电视能看的这种人"
    },
    {
      "index": 143,
      "start": 295.6,
      "end": 297.14,
      "text": "但是我做短视频平平台"
    },
    {
      "index": 144,
      "start": 297.4,
      "end": 297.92,
      "text": "这就不行了"
    },
    {
      "index": 145,
      "start": 298.18,
      "end": 303.04,
      "text": "所以那个时候早期我做短视频平台之前你们知道我通常会有个动作"
    },
    {
      "index": 146,
      "start": 303.28,
      "end": 304.58,
      "text": "我会喝点披油"
    },
    {
      "index": 147,
      "start": 305.34,
      "end": 311.22,
      "text": "然后把手盘起来你们认真看啊我早期的很多视频一开始都是盘扫做的"
    },
    {
      "index": 148,
      "start": 311.48,
      "end": 312.0,
      "text": "然后"
    },
    {
      "index": 149,
      "start": 312.26,
      "end": 318.4,
      "text": "为什么就是通过这些外部的动作让我进入用状态就是我在和大家"
    },
    {
      "index": 150,
      "start": 318.48,
      "end": 322.28,
      "text": "聊天我在和大家溝通在吹牛在车旦"
    },
    {
      "index": 151,
      "start": 322.54,
      "end": 325.1,
      "text": "而不是去讲课而不是去回报"
    },
    {
      "index": 152,
      "start": 325.86,
      "end": 331.76,
      "text": "一直以到今天我其实不需要任何的付注我就可以直接进入微选的状态"
    },
    {
      "index": 153,
      "start": 332.26,
      "end": 334.82,
      "text": "所以好的经常看我你今天有喝多少就没有"
    },
    {
      "index": 154,
      "start": 335.08,
      "end": 335.6,
      "text": "不需要了"
    },
    {
      "index": 155,
      "start": 336.36,
      "end": 339.94,
      "text": "因为我每次拍视频之前一定会把自己经过的那个状态"
    },
    {
      "index": 156,
      "start": 340.46,
      "end": 343.28,
      "text": "我要和老火几门聊天了"
    },
    {
      "index": 157,
      "start": 343.54,
      "end": 345.58,
      "text": "所以有些时候越不正式越好"
    },
    {
      "index": 158,
      "start": 346.14,
      "end": 348.64,
      "text": "甚至有些时候偶尔说说两句话"
    },
    {
      "index": 159,
      "start": 349.42,
      "end": 350.44,
      "text": "反而是好事"
    },
    {
      "index": 160,
      "start": 350.7,
      "end": 352.5,
      "text": "第一个就是你在心态上这样"
    },
    {
      "index": 161,
      "start": 353.0,
      "end": 355.82,
      "text": "第二个话呢你在做短视频的时候"
    },
    {
      "index": 162,
      "start": 357.1,
      "end": 359.4,
      "text": "你一定要想办法"
    },
    {
      "index": 163,
      "start": 359.66,
      "end": 361.2,
      "text": "就有那种场景感"
    },
    {
      "index": 164,
      "start": 361.46,
      "end": 364.78,
      "text": "把人拉到你的对话里来比如说你经常聊聊你会说"
    },
    {
      "index": 165,
      "start": 365.04,
      "end": 366.58,
      "text": "你没有没有那种情况"
    },
    {
      "index": 166,
      "start": 366.84,
      "end": 368.1,
      "text": "你没遇遇到过这样的问题"
    },
    {
      "index": 167,
      "start": 368.36,
      "end": 370.92,
      "text": "这个问题你们是怎么想的"
    },
    {
      "index": 168,
      "start": 371.44,
      "end": 372.72,
      "text": "这个很重要的"
    },
    {
      "index": 169,
      "start": 372.98,
      "end": 374.52,
      "text": "主要不是刻意的做"
    },
    {
      "index": 170,
      "start": 374.72,
      "end": 376.56,
      "text": "而是你就是前面第一条"
    },
    {
      "index": 171,
      "start": 376.82,
      "end": 379.12,
      "text": "你脑子就那个概念我就是在和大聊他"
    },
    {
      "index": 172,
      "start": 379.38,
      "end": 381.94,
      "text": "然后中间才会有一些对话是这样的第二个部分"
    },
    {
      "index": 173,
      "start": 382.72,
      "end": 384.0,
      "text": "然后第三个部分的话呢"
    },
    {
      "index": 174,
      "start": 384.26,
      "end": 387.32,
      "text": "就是你要学会去看数据"
    },
    {
      "index": 175,
      "start": 387.58,
      "end": 391.16,
      "text": "麻烦以后要看数据大家经常讨论的那些那种"
    },
    {
      "index": 176,
      "start": 391.42,
      "end": 393.72,
      "text": "经常聊那些那种感"
    },
    {
      "index": 177,
      "start": 393.98,
      "end": 396.8,
      "text": "感兴趣他会成为你的第二条视频"
    },
    {
      "index": 178,
      "start": 397.3,
      "end": 398.58,
      "text": "全体的来源"
    },
    {
      "index": 179,
      "start": 398.84,
      "end": 400.64,
      "text": "我看好多人这个动作是不做的"
    },
    {
      "index": 180,
      "start": 401.4,
      "end": 402.94,
      "text": "然后还有一个点我跟大家讲"
    },
    {
      "index": 181,
      "start": 402.94,
      "end": 404.74,
      "text": "就是我说要在评论的时候很容易会"
    },
    {
      "index": 182,
      "start": 405.0,
      "end": 406.0,
      "text": "会讨厌黑粉"
    },
    {
      "index": 183,
      "start": 406.26,
      "end": 409.86,
      "text": "甚至很能喜欢讨厌更新我告诉你我早就说特别喜欢黑粉"
    },
    {
      "index": 184,
      "start": 410.1,
      "end": 411.9,
      "text": "游期喜欢钢琴为什么"
    },
    {
      "index": 185,
      "start": 412.16,
      "end": 414.2,
      "text": "因为你说啥他要跟你干涉干涉上去"
    },
    {
      "index": 186,
      "start": 414.46,
      "end": 415.22,
      "text": "太好的"
    },
    {
      "index": 187,
      "start": 415.74,
      "end": 416.76,
      "text": "你知道吗"
    },
    {
      "index": 188,
      "start": 417.02,
      "end": 418.56,
      "text": "他在燃烧自己"
    },
    {
      "index": 189,
      "start": 418.82,
      "end": 420.1,
      "text": "为你的短视频"
    },
    {
      "index": 190,
      "start": 420.34,
      "end": 423.16,
      "text": "贡献热度就是我说我看到这种人我就我就"
    },
    {
      "index": 191,
      "start": 423.62,
      "end": 427.0,
      "text": "我就縮然体育又大心理"
    },
    {
      "index": 192,
      "start": 427.26,
      "end": 428.54,
      "text": "縮然体育的"
    },
    {
      "index": 193,
      "start": 429.3,
      "end": 431.36,
      "text": "这个还好体会一些的话"
    },
    {
      "index": 194,
      "start": 431.86,
      "end": 433.66,
      "text": "短视频不是"
    },
    {
      "index": 195,
      "start": 434.42,
      "end": 437.5,
      "text": "内容的输出和传播而是制造"
    },
    {
      "index": 196,
      "start": 438.26,
      "end": 438.78,
      "text": "对话"
    },
    {
      "index": 197,
      "start": 439.8,
      "end": 441.6,
      "text": "内容是中武藏"
    },
    {
      "index": 198,
      "start": 442.36,
      "end": 443.38,
      "text": "但是对话"
    },
    {
      "index": 199,
      "start": 443.64,
      "end": 444.66,
      "text": "可以让他"
    },
    {
      "index": 200,
      "start": 444.92,
      "end": 446.2,
      "text": "成为身体"
    },
    {
      "index": 201,
      "start": 446.7,
      "end": 449.26,
      "text": "所以各位好好想想你在过去"
    },
    {
      "index": 202,
      "start": 449.52,
      "end": 451.58,
      "text": "最棒的一次对话是什么时候"
    },
    {
      "index": 203,
      "start": 451.58,
      "end": 454.4,
      "text": "他是怎么发生的"
    }
  ]
}