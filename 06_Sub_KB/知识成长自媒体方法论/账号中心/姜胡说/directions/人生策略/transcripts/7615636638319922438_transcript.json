    {
      "index": 189,
      "start": 336.0,
      "end": 337.04,
      "text": "他知道你卡在哪儿了"
    },
    {
      "index": 190,
      "start": 337.04,
      "end": 338.64,
      "text": "他的细节点太远给你讲"
