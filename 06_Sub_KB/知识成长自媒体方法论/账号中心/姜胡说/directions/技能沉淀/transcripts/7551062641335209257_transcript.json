    },
    {
      "index": 67,
      "start": 163.32,
      "end": 163.58,
      "text": "口波模拒"
    },
    {
      "index": 68,
      "start": 163.82,
      "end": 164.34,
      "text": "总是这样的"
    },
    {
      "index": 69,
      "start": 164.6,
      "end": 165.88,
      "text": "首先把拥护细节的"
