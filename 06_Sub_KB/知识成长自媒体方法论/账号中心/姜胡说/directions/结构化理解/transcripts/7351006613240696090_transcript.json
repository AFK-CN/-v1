{
  "language": "zh",
  "duration": 99.6846875,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 3.34,
      "text": "我你们说千万不要线学线卖"
    },
    {
      "index": 2,
      "start": 3.84,
      "end": 6.36,
      "text": "到过来 线卖线学"
    },
    {
      "index": 3,
      "start": 6.36,
      "end": 8.4,
      "text": "你不要把碎血告诉我了"
    },
    {
      "index": 4,
      "start": 8.4,
      "end": 9.68,
      "text": "你看我们好的人啊"
    },
    {
      "index": 5,
      "start": 9.68,
      "end": 11.52,
      "text": "还留在以前的冠营思维"
    },
    {
      "index": 6,
      "start": 11.52,
      "end": 12.56,
      "text": "说我好学"
    },
    {
      "index": 7,
      "start": 12.8,
      "end": 14.0,
      "text": "喜欢以后把它用出来"
    },
    {
      "index": 8,
      "start": 14.0,
      "end": 16.32,
      "text": "你喜欢了以后你真不一定能用出来"
    },
    {
      "index": 9,
      "start": 16.32,
      "end": 18.08,
      "text": "没地方让你用"
    },
    {
      "index": 10,
      "start": 18.44,
      "end": 19.96,
      "text": "而且很多时候你在学的工作呢"
    },
    {
      "index": 11,
      "start": 19.96,
      "end": 21.56,
      "text": "没有那个场景"
    },
    {
      "index": 12,
      "start": 21.56,
      "end": 22.8,
      "text": "你没有办法其实反馈"
    },
    {
      "index": 13,
      "start": 22.8,
      "end": 24.24,
      "text": "说我学的是个傻呀"
    },
    {
      "index": 14,
      "start": 24.24,
      "end": 25.4,
      "text": "他傻用啊"
    },
    {
      "index": 15,
      "start": 25.4,
      "end": 28.08,
      "text": "就是到底这个学的东西有没有用啊"
    },
    {
      "index": 16,
      "start": 28.08,
      "end": 29.12,
      "text": "你完全不知道"
    },
    {
      "index": 17,
      "start": 29.12,
      "end": 30.76,
      "text": "学的学的那你就办图是废了"
    },
    {
      "index": 18,
      "start": 30.76,
      "end": 32.68,
      "text": "你比如说压了英语"
    },
    {
      "index": 19,
      "start": 32.68,
      "end": 33.8,
      "text": "你学过英语吗"
    },
    {
      "index": 20,
      "start": 33.8,
      "end": 34.96,
      "text": "你用出来的吗"
    },
    {
      "index": 21,
      "start": 34.96,
      "end": 37.36,
      "text": "单番英语用出来的人"
    },
    {
      "index": 22,
      "start": 37.36,
      "end": 39.76,
      "text": "他一定是知道把那个英语"
    },
    {
      "index": 23,
      "start": 39.76,
      "end": 40.76,
      "text": "他找了个地方"
    },
    {
      "index": 24,
      "start": 40.76,
      "end": 41.72,
      "text": "他把他用出来的"
    },
    {
      "index": 25,
      "start": 41.72,
      "end": 43.6,
      "text": "叫学义是用"
    },
    {
      "index": 26,
      "start": 43.6,
      "end": 44.84,
      "text": "他既然如此"
    },
    {
      "index": 27,
      "start": 44.84,
      "end": 46.64,
      "text": "为啥不更进一步啊"
    },
    {
      "index": 28,
      "start": 46.64,
      "end": 48.04,
      "text": "叫线卖线学"
    },
    {
      "index": 29,
      "start": 48.04,
      "end": 49.56,
      "text": "我先找个事儿子我"
    },
    {
      "index": 30,
      "start": 50.2,
      "end": 51.12,
      "text": "遇到问题了"
    },
    {
      "index": 31,
      "start": 51.12,
      "end": 52.4,
      "text": "然后我解决问题"
    },
    {
      "index": 32,
      "start": 52.4,
      "end": 52.8,
      "text": "对吧"
    },
    {
      "index": 33,
      "start": 52.8,
      "end": 54.04,
      "text": "哪里不会"
    },
    {
      "index": 34,
      "start": 54.04,
      "end": 55.24,
      "text": "我点哪里"
    },
    {
      "index": 35,
      "start": 55.24,
      "end": 57.28,
      "text": "你如果是做在小生意"
    },
    {
      "index": 36,
      "start": 57.28,
      "end": 57.56,
      "text": "对吧"
    },
    {
      "index": 37,
      "start": 57.56,
      "end": 58.84,
      "text": "我会把我拍个短视频"
    },
    {
      "index": 38,
      "start": 58.84,
      "end": 59.96,
      "text": "然后我不知道该怎么起号"
    },
    {
      "index": 39,
      "start": 59.96,
      "end": 60.92,
      "text": "我去学"
    },
    {
      "index": 40,
      "start": 61.92,
      "end": 63.04,
      "text": "然后出来以后的话"
    },
    {
      "index": 41,
      "start": 63.04,
      "end": 64.24,
      "text": "不过那不好"
    },
    {
      "index": 42,
      "start": 64.24,
      "end": 65.4,
      "text": "我去学"
    },
    {
      "index": 43,
      "start": 65.4,
      "end": 67.36,
      "text": "怎么把用户里无助"
    },
    {
      "index": 44,
      "start": 67.36,
      "end": 68.84,
      "text": "我去学"
    },
    {
      "index": 45,
      "start": 68.84,
      "end": 70.24,
      "text": "遇到问题"
    },
    {
      "index": 46,
      "start": 70.24,
      "end": 71.24,
      "text": "解决问题"
    },
    {
      "index": 47,
      "start": 71.24,
      "end": 72.44,
      "text": "这样你学的东西"
    },
    {
      "index": 48,
      "start": 72.44,
      "end": 75.0,
      "text": "都是可以用用出来的"
    },
    {
      "index": 49,
      "start": 75.0,
      "end": 76.36,
      "text": "就会问以前上学的时候"
    },
    {
      "index": 50,
      "start": 76.36,
      "end": 77.4,
      "text": "是你学位所说"
    },
    {
      "index": 51,
      "start": 77.4,
      "end": 78.2,
      "text": "我好人"
    },
    {
      "index": 52,
      "start": 78.2,
      "end": 79.12,
      "text": "我要记录的东西"
    },
    {
      "index": 53,
      "start": 79.12,
      "end": 80.36,
      "text": "我把它记起来"
    },
    {
      "index": 54,
      "start": 80.36,
      "end": 80.96,
      "text": "哎"
    },
    {
      "index": 55,
      "start": 80.96,
      "end": 81.6,
      "text": "考试的时候"
    },
    {
      "index": 56,
      "start": 81.6,
      "end": 82.2,
      "text": "我在直面上"
    },
    {
      "index": 57,
      "start": 82.2,
      "end": 82.92,
      "text": "才能把它打出来"
    },
    {
      "index": 58,
      "start": 82.92,
      "end": 84.36,
      "text": "我就能得份"
    },
    {
      "index": 59,
      "start": 84.36,
      "end": 85.8,
      "text": "可是你毕业了以后"
    },
    {
      "index": 60,
      "start": 85.8,
      "end": 86.96,
      "text": "你在直面上"
    },
    {
      "index": 61,
      "start": 86.96,
      "end": 88.72,
      "text": "它是谁给你得份人的"
    },
    {
      "index": 62,
      "start": 88.72,
      "end": 90.72,
      "text": "用出来以后才能得份"
    },
    {
      "index": 63,
      "start": 90.72,
      "end": 93.04,
      "text": "所以不是"
    },
    {
      "index": 64,
      "start": 93.04,
      "end": 94.68,
      "text": "先学先卖"
    },
    {
      "index": 65,
      "start": 94.68,
      "end": 95.96,
      "text": "到过来"
    },
    {
      "index": 66,
      "start": 95.96,
      "end": 97.28,
      "text": "一用为主"
    },
    {
      "index": 67,
      "start": 97.28,
      "end": 98.72,
      "text": "先卖"
    },
    {
      "index": 68,
      "start": 98.72,
      "end": 99.44,
      "text": "先学"
    }
  ]
}