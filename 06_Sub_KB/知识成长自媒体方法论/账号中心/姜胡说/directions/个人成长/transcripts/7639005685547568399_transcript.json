      "start": 475.78,
      "end": 476.78,
      "text": "也跟我說的一點是"
    },
    {
      "index": 298,
      "start": 476.78,
      "end": 477.78,
      "text": "如果沒有這個環境"
    },
    {
      "index": 299,
      "start": 477.78,
      "end": 478.78,
      "text": "他沒有辦法"
    },
    {
      "index": 300,
      "start": 478.78,
      "end": 479.78,
      "text": "建華的這麼快"
    },
    {
      "index": 301,
      "start": 479.78,
      "end": 480.78,
      "text": "對"
    },
    {
      "index": 302,
      "start": 480.78,
      "end": 481.78,
      "text": "所以越大流不越"
    },
    {
      "index": 303,
      "start": 482.78,
      "end": 483.78,
      "text": "就是你錯誤家"
    },
    {
      "index": 304,
      "start": 483.78,
      "end": 485.78,
      "text": "反思等於進步"
    },
    {
      "index": 305,
      "start": 485.78,
      "end": 486.78,
      "text": "最這個方法就是特別好的"
    },
    {
      "index": 306,
      "start": 486.78,
      "end": 487.78,
      "text": "當你不得的測試的時候"
    },
    {
      "index": 307,
      "start": 487.78,
      "end": 489.78,
      "text": "其實你是成長歲"
    },
    {
      "index": 308,
      "start": 489.78,
      "end": 490.78,
      "text": "他不是說我因此成敗"
    },
    {
      "index": 309,
      "start": 490.78,
      "end": 491.78,
      "text": "我因此出去了以後"
    },
    {
      "index": 310,
      "start": 491.78,
      "end": 492.78,
      "text": "失敗了"
    },
    {
      "index": 311,
      "start": 492.78,
      "end": 493.78,
      "text": "失敗了以後"
    },
    {
      "index": 312,
      "start": 493.78,
      "end": 494.78,
      "text": "對我內心是打擊的"
    },
    {
      "index": 313,
      "start": 494.78,
      "end": 495.78,
      "text": "然後再去做"
    },
    {
      "index": 314,
      "start": 495.78,
      "end": 496.78,
      "text": "慢慢一直立即消磨了"
    },
    {
      "index": 315,
      "start": 496.78,
      "end": 497.78,
      "text": "但是我測試就是"
    },
    {
      "index": 316,
      "start": 497.78,
      "end": 498.78,
      "text": "其實是成長"
    },
    {
      "index": 317,
      "start": 498.78,
      "end": 499.78,
      "text": "我做了以後"
    },
    {
      "index": 318,
      "start": 499.78,
      "end": 500.78,
      "text": "發現有一個問題"
    },
    {
      "index": 319,
      "start": 500.78,
      "end": 501.78,
      "text": "然後去調整他"
    },
    {
      "index": 320,
      "start": 501.78,
      "end": 502.78,
      "text": "然後再去進化"
    },
    {
      "index": 321,
      "start": 502.78,
      "end": 503.78,
      "text": "再調整再進化"
    },
    {
      "index": 322,
      "start": 503.78,
      "end": 504.78,
      "text": "照這個分享下去"
    },
    {
      "index": 323,
      "start": 504.78,
      "end": 506.78,
      "text": "其實我們成功的概率"
    },
    {
      "index": 324,
      "start": 506.78,
      "end": 507.78,
      "text": "會非常的高"
    },
    {
      "index": 325,
      "start": 507.78,
      "end": 508.78,
      "text": "就算這個事沒有做成"
    },
    {
      "index": 326,
      "start": 508.78,
      "end": 509.78,
      "text": "其實我們的人"
    },
    {
      "index": 327,
      "start": 509.78,
      "end": 511.78,
      "text": "我們人是心花了"
    },
    {
      "index": 328,
      "start": 511.78,
      "end": 512.78,
      "text": "對"
    },
    {
      "index": 329,
      "start": 512.78,
      "end": 513.78,
      "text": "我就感覺我"
    },
    {
      "index": 330,
      "start": 513.78,
      "end": 514.78,
      "text": "因為一直前面是"
    },
    {
      "index": 331,
      "start": 514.78,
      "end": 515.78,
      "text": "我卡點在的"
    },
    {
      "index": 332,
      "start": 515.78,
      "end": 517.78,
      "text": "甚至很多時候卡住我了"
    },
    {
      "index": 333,
      "start": 517.78,
      "end": 518.78,
      "text": "我甚至會兩三個月"
    },
    {
      "index": 334,
      "start": 518.78,
      "end": 519.78,
      "text": "沒有辦法繼續行動"
    },
    {
      "index": 335,
      "start": 519.78,
      "end": 520.78,
      "text": "甚至有的時候"
    },
    {
      "index": 336,
      "start": 520.78,
      "end": 521.78,
      "text": "會有一年的這種體用"
    },
    {
      "index": 337,
      "start": 521.78,
      "end": 522.78,
      "text": "職期"
    },
    {
      "index": 338,
      "start": 522.78,
      "end": 523.78,
      "text": "大家好"
    },
    {
      "index": 339,
      "start": 523.78,
      "end": 524.78,
      "text": "太好了"
    },
    {
      "index": 340,
      "start": 524.78,
      "end": 525.78,
      "text": "我們特別喜歡聽"
    },
    {
      "index": 341,
      "start": 525.78,
      "end": 526.78,
      "text": "譽門的時候"
    },
    {
      "index": 342,
      "start": 526.78,
      "end": 527.78,
      "text": "來說兩個字"
    },
    {
      "index": 343,
      "start": 527.78,
      "end": 528.78,
      "text": "要是高上我開心一下"
    },
    {
      "index": 344,
      "start": 528.78,
      "end": 530.78,
      "text": "第一個是在我"
    },
    {
      "index": 345,
      "start": 530.78,
      "end": 532.78,
      "text": "去得到那個用片"
    },
    {
      "index": 346,
      "start": 532.78,
      "end": 533.78,
      "text": "那一次"
    },
    {
      "index": 347,
      "start": 533.78,
      "end": 534.78,
      "text": "再有一次就是"
    },
    {
      "index": 348,
      "start": 534.78,
      "end": 536.78,
      "text": "我想在武漢買房子"
    },
    {
      "index": 349,
      "start": 536.78,
      "end": 538.78,
      "text": "那可能就是房價的頂點"
    },
    {
      "index": 350,
      "start": 538.78,
      "end": 540.78,
      "text": "然後但是因為自己的信用卡"
    },
    {
      "index": 351,
      "start": 540.78,
      "end": 541.78,
      "text": "好像有三次與其"
    },
    {
      "index": 352,
      "start": 541.78,
      "end": 542.78,
      "text": "沒賣成"
    },
    {
      "index": 353,
      "start": 542.78,
      "end": 544.78,
      "text": "然後也是猜的狗失怨"
    },
    {
      "index": 354,
      "start": 544.78,
      "end": 545.78,
      "text": "感謝於其"
    },
    {
      "index": 355,
      "start": 545.78,
      "end": 547.78,
      "text": "然後信用卡沒賣成"
    },
    {
      "index": 356,
      "start": 547.78,
      "end": 548.78,
      "text": "就是一件事"
    },
    {
      "index": 357,
      "start": 548.78,
      "end": 549.78,
      "text": "當時兩件事"
    },
    {
      "index": 358,
      "start": 549.78,
      "end": 550.78,
      "text": "是跌價大集"
    },
    {
      "index": 359,
      "start": 550.78,
      "end": 551.78,
      "text": "就覺得完了"
    },
    {
      "index": 360,
      "start": 551.78,
      "end": 552.78,
      "text": "這輩子"
    },
    {
      "index": 361,
      "start": 552.78,
      "end": 554.78,
      "text": "就握在這個小地方"
    },
    {
      "index": 362,
      "start": 554.78,
      "end": 556.78,
      "text": "然後沒出路了"
    },
    {
      "index": 363,
      "start": 556.78,
      "end": 557.78,
      "text": "然後自己在家跑了七天"
    },
    {
      "index": 364,
      "start": 557.78,
      "end": 558.78,
      "text": "躺在地上"
    },
    {
      "index": 365,
      "start": 558.78,
      "end": 559.78,
      "text": "照亮"
    },
    {
      "index": 366,
      "start": 559.78,
      "end": 561.78,
      "text": "出了個電子"
    },
    {
      "index": 367,
      "start": 561.78,
      "end": 563.78,
      "text": "怎麼走出來的"
    },
    {
      "index": 368,
      "start": 563.78,
      "end": 565.78,
      "text": "我朋友過推薦了兩本書"
    },
    {
      "index": 369,
      "start": 565.78,
      "end": 566.78,
      "text": "一本是"
    },
    {
      "index": 370,
      "start": 566.78,
      "end": 568.78,
      "text": "單瓶的時間美貴"
    },
    {
      "index": 371,
      "start": 568.78,
      "end": 569.78,
      "text": "然後一本是"
    },
    {
      "index": 372,
      "start": 569.78,
      "end": 570.78,
      "text": "張淚的價值"
    },
    {
      "index": 373,
      "start": 570.78,
      "end": 572.78,
      "text": "我還有是價值信訪"
    },
    {
      "index": 374,
      "start": 574.78,
      "end": 575.78,
      "text": "你要是出書"
    },
    {
      "index": 375,
      "start": 575.78,
      "end": 576.78,
      "text": "找點書"
    },
    {
      "index": 376,
      "start": 576.78,
      "end": 577.78,
      "text": "我會拿到"
    },
    {
      "index": 377,
      "start": 577.78,
      "end": 578.78,
      "text": "是價值信訪"
    },
    {
      "index": 378,
      "start": 578.78,
      "end": 579.78,
      "text": "然後就拿到這兩本"
    },
    {
      "index": 379,
      "start": 579.78,
      "end": 580.78,
      "text": "書之後"
    },
    {
      "index": 380,
      "start": 580.78,
      "end": 581.78,
      "text": "突然就覺得"
    },
    {
      "index": 381,
      "start": 581.78,
      "end": 582.78,
      "text": "我可能要學學投資了"
    },
    {
      "index": 382,
      "start": 582.78,
      "end": 584.78,
      "text": "然後在網上"
    },
    {
      "index": 383,
      "start": 584.78,
      "end": 586.78,
      "text": "帥到胡子格的視頻"
    },
    {
      "index": 384,
      "start": 586.78,
      "end": 587.78,
      "text": "好多"
    },
    {
      "index": 385,
      "start": 587.78,
      "end": 588.78,
      "text": "然後那時候"
    },
    {
      "index": 386,
      "start": 588.78,
      "end": 589.78,
      "text": "您的直播"
    },
    {
      "index": 387,
      "start": 589.78,
      "end": 590.78,
      "text": "和短視頻"
    },
    {
      "index": 388,
      "start": 590.78,
      "end": 591.78,
      "text": "只因我出來的"
    },
    {
      "index": 389,
      "start": 591.78,
      "end": 592.78,
      "text": "可能您不知道"
    },
    {
      "index": 390,
      "start": 592.78,
      "end": 593.78,
      "text": "您只是"
    },
    {
      "index": 391,
      "start": 593.78,
      "end": 594.78,
      "text": "不斷地在做"
    },
    {
      "index": 392,
      "start": 594.78,
      "end": 595.78,
      "text": "您該做的這個事"
    },
    {
      "index": 393,
      "start": 595.78,
      "end": 596.78,
      "text": "沒事"
    },
    {
      "index": 394,
      "start": 596.78,
      "end": 597.78,
      "text": "我知道"
    },
    {
      "index": 395,
      "start": 597.78,
      "end": 598.78,
      "text": "因為我從收到的羊肉"
    },
    {
      "index": 396,
      "start": 598.78,
      "end": 599.78,
      "text": "和酸海的人"
    },
    {
      "index": 397,
      "start": 599.78,
      "end": 601.78,
      "text": "我知道了那個事"
    },
    {
      "index": 398,
      "start": 601.78,
      "end": 603.78,
      "text": "分享一個"
    },
    {
      "index": 399,
      "start": 603.78,
      "end": 605.78,
      "text": "您認為這麼一路走過來"
    },
    {
      "index": 400,
      "start": 605.78,
      "end": 606.78,
      "text": "您認為很重要"
    },
    {
      "index": 401,
      "start": 606.78,
      "end": 608.78,
      "text": "但是被大多數老婆"
    },
    {
      "index": 402,
      "start": 608.78,
      "end": 609.78,
      "text": "你們忽略的"
    },
    {
      "index": 403,
      "start": 609.78,
      "end": 610.78,
      "text": "認知"
    },
    {
      "index": 404,
      "start": 610.78,
      "end": 611.78,
      "text": "或者是方法"
    },
    {
      "index": 405,
      "start": 611.78,
      "end": 612.78,
      "text": "都可以"
    },
    {
      "index": 406,
      "start": 612.78,
      "end": 613.78,
      "text": "就是"
    },
    {
      "index": 407,
      "start": 615.78,
      "end": 616.78,
      "text": "不斷地做"
    },
    {
      "index": 408,
      "start": 616.78,
      "end": 617.78,
      "text": "我覺得"
    },
    {
      "index": 409,
      "start": 617.78,
      "end": 618.78,
      "text": "我的個人的問題"
    },
    {
      "index": 410,
      "start": 618.78,
      "end": 620.78,
      "text": "是前幾年"
    },
    {
      "index": 411,
      "start": 620.78,
      "end": 622.78,
      "text": "就是看書看得太多"
    },
    {
      "index": 412,
      "start": 622.78,
      "end": 624.78,
      "text": "就不做"
    },
    {
      "index": 413,
      "start": 624.78,
      "end": 625.78,
      "text": "我今年"
    },
    {
      "index": 414,
      "start": 625.78,
      "end": 626.78,
      "text": "為什麼在下半年"
    },
    {
      "index": 415,
      "start": 626.78,
      "end": 627.78,
      "text": "跌帶的速度"
    },
    {
      "index": 416,
      "start": 627.78,
      "end": 628.78,
      "text": "特別快的一個原因"
    },
    {
      "index": 417,
      "start": 628.78,
      "end": 629.78,
      "text": "是一直在持續做"
    },
    {
      "index": 418,
      "start": 629.78,
      "end": 630.78,
      "text": "雖然"
    },
    {
      "index": 419,
      "start": 630.78,
      "end": 631.78,
      "text": "我真的覺得"
    },
    {
      "index": 420,
      "start": 631.78,
      "end": 632.78,
      "text": "我自己挺笨的"
    },
    {
      "index": 421,
      "start": 632.78,
      "end": 633.78,
      "text": "可能數個月"
    },
    {
      "index": 422,
      "start": 633.78,
      "end": 634.78,
      "text": "才產出了十來條"
    },
    {
      "index": 423,
      "start": 634.78,
      "end": 635.78,
      "text": "就很好"
    },
    {
      "index": 424,
      "start": 635.78,
      "end": 636.78,
      "text": "因為認真"
    },
    {
      "index": 425,
      "start": 636.78,
      "end": 637.78,
      "text": "打摩一款產品"
    },
    {
      "index": 426,
      "start": 637.78,
      "end": 638.78,
      "text": "其實這個時候"
    },
    {
      "index": 427,
      "start": 638.78,
      "end": 639.78,
      "text": "已經不再說"
    },
    {
      "index": 428,
      "start": 639.78,
      "end": 640.78,
      "text": "我為了是"
    },
    {
      "index": 429,
      "start": 640.78,
      "end": 641.78,
      "text": "跟我講怎麼樣"
    },
    {
      "index": 430,
      "start": 641.78,
      "end": 642.78,
      "text": "其實我剛開始的時候"
    },
    {
      "index": 431,
      "start": 642.78,
      "end": 643.78,
      "text": "可以把時間拉長"
    },
    {
      "index": 432,
      "start": 643.78,
      "end": 645.78,
      "text": "就是一週的時間"
    },
    {
      "index": 433,
      "start": 645.78,
      "end": 646.78,
      "text": "認真地去做"
    },
    {
      "index": 434,
      "start": 646.78,
      "end": 647.78,
      "text": "這麼一個產品"
    },
    {
      "index": 435,
      "start": 647.78,
      "end": 648.78,
      "text": "然後再去復盤"
    },
    {
      "index": 436,
      "start": 648.78,
      "end": 649.78,
      "text": "再去總理"
    },
    {
      "index": 437,
      "start": 649.78,
      "end": 650.78,
      "text": "再去開心"
    },
    {
      "index": 438,
      "start": 650.78,
      "end": 651.78,
      "text": "對"
    },
    {
      "index": 439,
      "start": 651.78,
      "end": 652.78,
      "text": "所以我們就是"
    },
    {
      "index": 440,
      "start": 652.78,
      "end": 653.78,
      "text": "逼逆逼自己"
    },
    {
      "index": 441,
      "start": 653.78,
      "end": 654.78,
      "text": "潛力無限"
    },
    {
      "index": 442,
      "start": 654.78,
      "end": 655.78,
      "text": "我就發現"
    },
    {
      "index": 443,
      "start": 655.78,
      "end": 656.78,
      "text": "好像之前"
    },
    {
      "index": 444,
      "start": 656.78,
      "end": 657.78,
      "text": "一個禮拜做的事"
    },
    {
      "index": 445,
      "start": 657.78,
      "end": 658.78,
      "text": "現在兩天也行了"
    },
    {
      "index": 446,
      "start": 658.78,
      "end": 659.78,
      "text": "對"
    },
    {
      "index": 447,
      "start": 659.78,
      "end": 660.78,
      "text": "所以我們把那個"
    },
    {
      "index": 448,
      "start": 660.78,
      "end": 661.78,
      "text": "方法叫"
    },
    {
      "index": 449,
      "start": 661.78,
      "end": 662.78,
      "text": "爬金森"
    },
    {
      "index": 450,
      "start": 662.78,
      "end": 663.78,
      "text": "爬子"
    },
    {
      "index": 451,
      "start": 663.78,
      "end": 664.78,
      "text": "還有什麼要喝"
    },
    {
      "index": 452,
      "start": 664.78,
      "end": 665.78,
      "text": "然後你們不重的嗎"
    },
    {
      "index": 453,
