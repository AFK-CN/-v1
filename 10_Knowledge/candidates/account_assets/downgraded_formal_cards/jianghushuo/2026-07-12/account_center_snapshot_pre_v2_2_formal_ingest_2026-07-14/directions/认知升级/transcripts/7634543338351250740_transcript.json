  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 5.88,
      "text": "大家分享一个特别简单,特别铺实的,让你变得越来越好的方法"
    },
    {
      "index": 2,
      "start": 8.2,
      "end": 9.22,
      "text": "到底很简单"
