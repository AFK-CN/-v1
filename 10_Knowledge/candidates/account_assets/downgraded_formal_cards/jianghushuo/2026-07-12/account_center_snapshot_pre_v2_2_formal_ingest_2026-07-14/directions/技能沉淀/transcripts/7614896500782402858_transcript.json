{
  "language": "zh",
  "duration": 280.8003125,
  "segments": [
    {
      "index": 1,
      "start": 0.11,
      "end": 4.19,
      "text": "一定要做可以接的事"
    },
    {
      "index": 2,
      "start": 4.19,
      "end": 6.77,
      "text": "千万千万不要等你发现的时候"
    },
    {
      "index": 3,
      "start": 6.77,
      "end": 8.31,
      "text": "问题已经完了"
    },
    {
      "index": 4,
      "start": 8.31,
      "end": 10.35,
      "text": "我就问大家一个问题"
    },
    {
      "index": 5,
      "start": 10.35,
      "end": 12.41,
      "text": "假设我说假设"
    },
    {
      "index": 6,
      "start": 12.41,
      "end": 15.21,
      "text": "你被公司才完了"
    },
    {
      "index": 7,
      "start": 15.21,
      "end": 17.77,
      "text": "然后你后面讲面臨的什么"
    },
    {
      "index": 8,
      "start": 17.77,
      "end": 19.31,
      "text": "我不是被言所听了"
    },
    {
      "index": 9,
      "start": 19.31,
      "end": 22.63,
      "text": "就今天我遇到一个多年到老朋友"
    },
    {
      "index": 10,
      "start": 22.63,
      "end": 24.69,
      "text": "就是一家公司的高官"
    },
    {
      "index": 11,
      "start": 24.69,
      "end": 27.75,
      "text": "因为公司的经营出了一些问题"
    },
    {
      "index": 12,
      "start": 27.95,
      "end": 30.31,
      "text": "然后他现在年龄也带了"
    },
    {
      "index": 13,
      "start": 30.31,
      "end": 32.61,
      "text": "然后突然发现走红布的时候"
    },
    {
      "index": 14,
      "start": 32.61,
      "end": 33.39,
      "text": "找不到了"
    },
    {
      "index": 15,
      "start": 33.39,
      "end": 34.41,
      "text": "找不到合作公路"
    },
    {
      "index": 16,
      "start": 34.41,
      "end": 36.97,
      "text": "他的心随特别特别的地"
    },
    {
      "index": 17,
      "start": 36.97,
      "end": 37.99,
      "text": "然后"
    },
    {
      "index": 18,
      "start": 37.99,
      "end": 41.05,
      "text": "正好今天晚上我们内部视频会以"
    },
    {
      "index": 19,
      "start": 41.05,
      "end": 43.11,
      "text": "正好有老化界"
    },
    {
      "index": 20,
      "start": 43.11,
      "end": 45.93,
      "text": "在一个行业工作十多年"
    },
    {
      "index": 21,
      "start": 45.93,
      "end": 49.01,
      "text": "然后发现不但"
    },
    {
      "index": 22,
      "start": 49.01,
      "end": 50.79,
      "text": "找不到更合适的工作"
    },
    {
      "index": 23,
      "start": 50.79,
      "end": 51.57,
      "text": "生活加新吗"
    },
    {
      "index": 24,
      "start": 51.57,
      "end": 52.83,
      "text": "找得更好的去"
    },
    {
      "index": 25,
      "start": 52.83,
      "end": 56.93,
      "text": "而且一旦公司拾退了"
    },
    {
      "index": 26,
      "start": 56.93,
      "end": 59.75,
      "text": "发现马上就面对生活问题"
    },
    {
      "index": 27,
      "start": 59.75,
      "end": 61.79,
      "text": "还有我们老化学生们就做"
    },
    {
      "index": 28,
      "start": 61.79,
      "end": 63.59,
      "text": "传统的建筑行业的"
    },
    {
      "index": 29,
      "start": 63.59,
      "end": 67.17,
      "text": "在行业所的飞动的时候有足结果"
    },
    {
      "index": 30,
      "start": 67.17,
      "end": 69.73,
      "text": "就是这个行业突然目楼了"
    },
    {
      "index": 31,
      "start": 69.73,
      "end": 70.75,
      "text": "所以"
    },
    {
      "index": 32,
      "start": 70.75,
      "end": 71.79,
      "text": "这就是一个问题"
    },
    {
      "index": 33,
      "start": 71.79,
      "end": 73.07,
      "text": "就是我想跟大家分享的"
    },
    {
      "index": 34,
      "start": 73.07,
      "end": 75.37,
      "text": "就一定要做可以"
    },
    {
      "index": 35,
      "start": 75.37,
      "end": 76.39,
      "text": "期待的事"
    },
    {
      "index": 36,
      "start": 76.39,
      "end": 78.43,
      "text": "我们工作两种一种叫楼是一样做业"
    },
    {
      "index": 37,
      "start": 78.43,
      "end": 79.71,
      "text": "什么意思呢就是"
    },
    {
      "index": 38,
      "start": 79.71,
      "end": 82.27,
      "text": "今天做今天做完了以后这个事就过去了"
    },
    {
      "index": 39,
      "start": 82.27,
      "end": 83.29,
      "text": "还有一种是期待的"
    },
    {
      "index": 40,
      "start": 83.29,
      "end": 85.35,
      "text": "可以不断不断的持续的"
    },
    {
      "index": 41,
      "start": 85.35,
      "end": 90.21,
      "text": "我们很多人会陷入成人陷阱"
    },
    {
      "index": 42,
      "start": 90.21,
      "end": 92.01,
      "text": "老鼠长陷阱"
    },
    {
      "index": 43,
      "start": 92.01,
      "end": 95.33,
      "text": "然后销生课的陷阱"
    },
    {
      "index": 44,
      "start": 95.33,
      "end": 97.39,
      "text": "然后同场陷阱你们还要带头到陷阱"
    },
    {
      "index": 45,
      "start": 97.39,
      "end": 98.41,
      "text": "啥意思呢"
    },
    {
      "index": 46,
      "start": 98.41,
      "end": 100.19,
      "text": "就是我默认的情况下"
    },
    {
      "index": 47,
      "start": 100.19,
      "end": 103.01,
      "text": "我们的生活方式是什么样的就是从小"
    },
    {
      "index": 48,
      "start": 103.01,
      "end": 105.07,
      "text": "好学习考上一个学校"
    },
    {
      "index": 49,
      "start": 105.07,
      "end": 106.59,
      "text": "然后毕业早份是好工作"
    },
    {
      "index": 50,
      "start": 106.59,
      "end": 107.63,
      "text": "然后"
    },
    {
      "index": 51,
      "start": 107.63,
      "end": 110.19,
      "text": "买个房子买个车去期生死"
    },
    {
      "index": 52,
      "start": 110.19,
      "end": 112.99,
      "text": "然后不断的身罩提升我们的能力"
    },
    {
      "index": 53,
      "start": 112.99,
      "end": 114.27,
      "text": "对吧"
    },
    {
      "index": 54,
      "start": 114.27,
      "end": 115.55,
      "text": "有时候回来类的时候的话"
    },
    {
      "index": 55,
      "start": 115.55,
      "end": 116.63,
      "text": "可以"
    },
    {
      "index": 56,
      "start": 116.63,
      "end": 118.11,
      "text": "可以看看视频"
    },
    {
      "index": 57,
      "start": 118.11,
      "end": 119.91,
      "text": "大家游戏啊对不对"
    },
    {
      "index": 58,
      "start": 119.91,
      "end": 121.43,
      "text": "但是我就问对我们每个问题"
    },
    {
      "index": 59,
      "start": 121.43,
      "end": 123.99,
      "text": "就订阴所在那个行业有机内嘛"
    },
    {
      "index": 60,
      "start": 123.99,
      "end": 125.53,
      "text": "或者你自己有机内嘛"
    },
    {
      "index": 61,
      "start": 125.53,
      "end": 128.09,
      "text": "万一经济下行"
    },
    {
      "index": 62,
      "start": 128.09,
      "end": 129.89,
      "text": "万一你被慈退了"
    },
    {
      "index": 63,
      "start": 129.89,
      "end": 132.45,
      "text": "万一你年龄大了"
    },
    {
      "index": 64,
      "start": 132.45,
      "end": 132.69,
      "text": "对吧"
    },
    {
      "index": 65,
      "start": 132.69,
      "end": 133.99,
      "text": "这个会出现什么问题呢"
    },
    {
      "index": 66,
      "start": 133.99,
      "end": 137.05,
      "text": "就我们很远遇到这个问题但是马上有没有另外两个问题"
    },
    {
      "index": 67,
      "start": 137.05,
      "end": 138.33,
      "text": "什么问题呢"
    },
    {
      "index": 68,
      "start": 138.33,
      "end": 140.63,
      "text": "第一个就是我们我接触不到新的思维"
    },
    {
      "index": 69,
      "start": 140.63,
      "end": 142.93,
      "text": "很能说后来往是评论不施的"
    },
    {
      "index": 70,
      "start": 142.93,
      "end": 143.71,
      "text": "不是的"
    },
    {
      "index": 71,
      "start": 143.71,
      "end": 145.51,
      "text": "就是我们说叫叫"
    },
    {
      "index": 72,
      "start": 145.51,
      "end": 146.79,
      "text": "就是信息牢龙啊"
    },
    {
      "index": 73,
      "start": 146.79,
      "end": 147.81,
      "text": "就你身边的人呢"
    },
    {
      "index": 74,
      "start": 147.81,
      "end": 149.85,
      "text": "包括你的每天推送的信息啊"
    },
    {
      "index": 75,
      "start": 149.85,
      "end": 151.13,
      "text": "都是你这个领域的"
    },
    {
      "index": 76,
      "start": 151.13,
      "end": 152.67,
      "text": "我不是在被人送听"
    },
    {
      "index": 77,
      "start": 152.67,
      "end": 154.97,
      "text": "然后很多时候呢也预止到这个问题的但是"
    },
    {
      "index": 78,
      "start": 154.97,
      "end": 156.25,
      "text": "但是不知道怎么出去"
    },
    {
      "index": 79,
      "start": 156.25,
      "end": 160.09,
      "text": "就洗得性无助不知道到底该怎么做"
    },
    {
      "index": 80,
      "start": 160.09,
      "end": 163.67,
      "text": "所以我给大家建议就是从现在开始"
    },
    {
      "index": 81,
      "start": 163.67,
      "end": 165.35,
      "text": "一定要做"
    },
    {
      "index": 82,
      "start": 165.35,
      "end": 167.53,
      "text": "累级性的工作"
    },
    {
      "index": 83,
      "start": 167.53,
      "end": 169.71,
      "text": "你千万不要每天就是每天"
    },
    {
      "index": 84,
      "start": 169.71,
      "end": 173.67,
      "text": "跑滑滑还起座的行业做很长的一段时间了"
    },
    {
      "index": 85,
      "start": 173.87,
      "end": 177.77,
      "text": "对吧但是难免出现经历下行吗公司啊不行啊"
    },
    {
      "index": 86,
      "start": 177.77,
      "end": 180.59,
      "text": "对吧这个领域不行啊对吧这样的一个问题"
    },
    {
      "index": 87,
      "start": 180.59,
      "end": 182.63,
      "text": "那么该怎么做呢"
    },
    {
      "index": 88,
      "start": 182.63,
      "end": 186.73,
      "text": "首先我之前给大家分享过一个方法"
    },
    {
      "index": 89,
      "start": 186.73,
      "end": 189.53,
      "text": "这个方法是什么呢就是每天学点什么"
    },
    {
      "index": 90,
      "start": 189.53,
      "end": 192.87,
      "text": "就很难觉得这是很小的样子是不是的"
    },
    {
      "index": 91,
      "start": 192.87,
      "end": 194.91,
      "text": "不是这是一套很有用的系统啊"
    },
    {
      "index": 92,
      "start": 194.91,
      "end": 196.45,
      "text": "首先第一个事情"
    },
    {
      "index": 93,
      "start": 196.45,
      "end": 199.01,
      "text": "就是每天学点什么学什么"
    },
    {
      "index": 94,
      "start": 199.01,
      "end": 200.55,
      "text": "我今天做了什么事"
    },
    {
      "index": 95,
      "start": 200.55,
      "end": 202.09,
      "text": "就遇到什么问题了"
    },
    {
      "index": 96,
      "start": 202.13,
      "end": 203.89,
      "text": "我是怎么解决的"
    },
    {
      "index": 97,
      "start": 203.89,
      "end": 205.41,
      "text": "注意后面这句话"
    },
    {
      "index": 98,
      "start": 205.41,
      "end": 208.75,
      "text": "是否还可以用在别的场景"
    },
    {
      "index": 99,
      "start": 208.75,
      "end": 210.29,
      "text": "如果没有"
    },
    {
      "index": 100,
      "start": 210.29,
      "end": 212.07,
      "text": "不可以用到别的场景的"
    },
    {
      "index": 101,
      "start": 212.07,
      "end": 214.37,
      "text": "那么很可能你做的这个事情"
    },
    {
      "index": 102,
      "start": 214.37,
      "end": 218.21,
      "text": "这个领域这个行业但出现下行的时候这个就不靠负用了"
    },
    {
      "index": 103,
      "start": 218.21,
      "end": 219.25,
      "text": "这是第一件事情"
    },
    {
      "index": 104,
      "start": 219.25,
      "end": 221.29,
      "text": "第二件事总结出来"
    },
    {
      "index": 105,
      "start": 221.29,
      "end": 224.37,
      "text": "如果可以用到别的行业那么他可以几个什么问题"
    },
    {
      "index": 106,
      "start": 224.37,
      "end": 227.43,
      "text": "解决发案及方法是什么"
    },
    {
      "index": 107,
      "start": 227.43,
      "end": 228.97,
      "text": "有没有更通的绝方法"
    },
    {
      "index": 108,
      "start": 228.97,
      "end": 231.27,
      "text": "是否可以把它输立成一个可以几个东西"
    },
    {
      "index": 109,
      "start": 231.27,
      "end": 233.83,
      "text": "有说是个魔法呢是个流程啊"
    },
    {
      "index": 110,
      "start": 233.83,
      "end": 235.37,
      "text": "是一天文章啊"
    },
    {
      "index": 111,
      "start": 235.37,
      "end": 236.91,
      "text": "对吧"
    },
    {
      "index": 112,
      "start": 236.91,
      "end": 238.71,
      "text": "或者是一个产品啊一个场景啊"
    },
    {
      "index": 113,
      "start": 238.71,
      "end": 239.73,
      "text": "对对"
    },
    {
      "index": 114,
      "start": 239.73,
      "end": 242.53,
      "text": "第三步把它发布出去"
    },
    {
      "index": 115,
      "start": 242.53,
      "end": 244.85,
      "text": "发布出去怎么就性命表面气"
    },
    {
      "index": 116,
      "start": 244.85,
      "end": 246.89,
      "text": "哪怕能力能力"
    },
    {
      "index": 117,
      "start": 246.89,
      "end": 252.27,
      "text": "我们差不多但是让看到的更多的人那么我的性命表面机就更多"
    },
    {
      "index": 118,
      "start": 252.27,
      "end": 255.85,
      "text": "这本身就是一个几个的过程同时的话呢"
    },
    {
      "index": 119,
      "start": 255.85,
      "end": 257.89,
      "text": "它是不断的电力建立你"
    },
    {
      "index": 120,
      "start": 257.89,
      "end": 261.47,
      "text": "学习能力思考能力和这个对外输出能力"
    },
    {
      "index": 121,
      "start": 261.47,
      "end": 266.09,
      "text": "这是一个基本盘同时不断的进行机的"
    },
    {
      "index": 122,
      "start": 266.09,
      "end": 267.87,
      "text": "所以个技术三多啊"
    },
    {
      "index": 123,
      "start": 267.87,
      "end": 271.21,
      "text": "对于他摆脱一来"
    },
    {
      "index": 124,
      "start": 271.21,
      "end": 272.99,
      "text": "第二个部分"
    },
    {
      "index": 125,
      "start": 272.99,
      "end": 274.79,
      "text": "行程系统"
    },
    {
      "index": 126,
      "start": 274.79,
      "end": 277.09,
      "text": "那些些点什么"
    },
    {
      "index": 127,
      "start": 277.09,
      "end": 278.89,
      "text": "让他可以几个第三"
    },
    {
      "index": 128,
      "start": 278.89,
      "end": 279.91,
      "text": "起累"
    },
    {
      "index": 129,
      "start": 279.91,
      "end": 280.93,
      "text": "资产"
    }
  ]
}