      "start": 419.53,
      "end": 420.53,
      "text": "記住"
    },
    {
      "index": 309,
      "start": 420.53,
      "end": 421.53,
      "text": "開頭就怎麼開"
    },
    {
      "index": 310,
      "start": 421.53,
      "end": 423.53,
      "text": "我以前認為是這樣的"
    },
    {
      "index": 311,
      "start": 423.53,
      "end": 424.53,
      "text": "但他娘的我發現"
    },
    {
      "index": 312,
      "start": 424.53,
      "end": 426.53,
      "text": "真實的情況是這樣的"
    },
    {
      "index": 313,
      "start": 426.53,
      "end": 427.53,
      "text": "然後為什麼"
    },
    {
      "index": 314,
      "start": 427.53,
      "end": 428.53,
      "text": "我給你們講"
    },
    {
      "index": 315,
      "start": 428.53,
      "end": 429.53,
      "text": "我做的什麼事"
    },
    {
      "index": 316,
      "start": 429.53,
      "end": 430.53,
      "text": "最後怎麼做的那個結果"
    },
    {
      "index": 317,
      "start": 430.53,
      "end": 431.53,
      "text": "為什麼"
    },
    {
      "index": 318,
      "start": 431.53,
      "end": 433.53,
      "text": "什麼本財結果"
    },
    {
      "index": 319,
      "start": 433.53,
      "end": 434.53,
      "text": "不重要"
    },
    {
      "index": 320,
      "start": 434.53,
      "end": 435.53,
      "text": "什麼故事"
    },
    {
      "index": 321,
      "start": 435.53,
      "end": 436.53,
      "text": "精彩層不重要"
    },
    {
      "index": 322,
      "start": 436.53,
      "end": 437.53,
      "text": "你說可怕也不重要"
    },
    {
      "index": 323,
      "start": 437.53,
      "end": 438.53,
      "text": "如果說不重要"
    },
    {
      "index": 324,
      "start": 438.53,
      "end": 439.53,
      "text": "你只要把這個事"
    },
    {
      "index": 325,
      "start": 439.53,
      "end": 441.53,
      "text": "加了我告訴你"
    },
    {
      "index": 326,
      "start": 441.53,
      "end": 443.53,
      "text": "這就是這就是一條"
    },
    {
      "index": 327,
      "start": 443.53,
      "end": 444.53,
      "text": "包括"
    },
    {
      "index": 328,
      "start": 444.53,
      "end": 446.53,
      "text": "你們看我的視頻"
    },
    {
      "index": 329,
      "start": 446.53,
      "end": 447.53,
      "text": "你們看我的視頻"
    },
    {
      "index": 330,
      "start": 447.53,
      "end": 449.53,
      "text": "就是上千萬的播放"
    },
    {
      "index": 331,
      "start": 449.53,
      "end": 451.53,
      "text": "幾乎百分之八十都是這種結果"
    },
    {
      "index": 332,
      "start": 451.53,
      "end": 452.53,
      "text": "而且很多時候"
    },
    {
      "index": 333,
      "start": 452.53,
      "end": 453.53,
      "text": "我根本就沒搞死"
    },
    {
      "index": 334,
      "start": 453.53,
      "end": 455.53,
      "text": "我把排施被沒搞死了"
    },
    {
      "index": 335,
      "start": 455.53,
      "end": 456.53,
      "text": "對吧"
    },
    {
      "index": 336,
      "start": 456.53,
      "end": 457.53,
      "text": "他就等到為什麼"
    },
    {
      "index": 337,
      "start": 457.53,
      "end": 458.53,
      "text": "我告訴你"
    },
    {
      "index": 338,
      "start": 458.53,
      "end": 459.53,
      "text": "第一個事情就是"
    },
    {
      "index": 339,
      "start": 459.53,
      "end": 461.53,
      "text": "短時間的核心什麼三段"
    },
    {
      "index": 340,
      "start": 461.53,
      "end": 462.53,
      "text": "第一塊有用"
    },
    {
      "index": 341,
      "start": 462.53,
      "end": 463.53,
      "text": "有用是基礎"
    },
    {
      "index": 342,
      "start": 463.53,
      "end": 464.53,
      "text": "第二是情緒"
    },
    {
      "index": 343,
      "start": 464.53,
      "end": 465.53,
      "text": "尤其是共鳴"
    },
    {
      "index": 344,
      "start": 465.53,
      "end": 466.53,
      "text": "共鳴"
    },
    {
      "index": 345,
      "start": 466.53,
      "end": 467.53,
      "text": "挖豪原來"
    },
    {
      "index": 346,
      "start": 467.53,
      "end": 468.53,
      "text": "你才會"
    },
    {
      "index": 347,
      "start": 468.53,
      "end": 469.53,
      "text": "是不是有各種行為"
    },
    {
      "index": 348,
      "start": 469.53,
      "end": 470.53,
      "text": "我們說他多的"
    },
    {
      "index": 349,
      "start": 470.53,
      "end": 471.53,
      "text": "怕他不怕他奶奶"
    },
    {
      "index": 350,
      "start": 471.53,
      "end": 472.53,
      "text": "他又一講那個"
    },
    {
      "index": 351,
      "start": 472.53,
      "end": 473.53,
      "text": "他這個人啥"
    },
    {
      "index": 352,
      "start": 473.53,
      "end": 474.53,
      "text": "所以你們能不能一把"
    },
    {
      "index": 353,
      "start": 474.53,
      "end": 476.53,
      "text": "他就會給你舊戶"
    },
    {
      "index": 354,
      "start": 476.53,
      "end": 477.53,
      "text": "這種舊戶的過程"
    },
    {
      "index": 355,
      "start": 477.53,
      "end": 478.53,
      "text": "就會有反規"
    },
    {
      "index": 356,
      "start": 478.53,
      "end": 479.53,
      "text": "能挺我的意思"
    },
    {
      "index": 357,
      "start": 479.53,
      "end": 480.53,
      "text": "所以情緒"
    },
    {
      "index": 358,
      "start": 480.53,
      "end": 482.53,
      "text": "是他的核心"
    },
    {
      "index": 359,
      "start": 482.53,
      "end": 483.53,
      "text": "是他的底層"
    },
    {
      "index": 360,
      "start": 483.53,
      "end": 484.53,
      "text": "但有用"
    },
    {
      "index": 361,
      "start": 484.53,
      "end": 485.53,
      "text": "是基礎"
    },
    {
      "index": 362,
      "start": 485.53,
      "end": 486.53,
      "text": "有用才會長遠"
    },
    {
      "index": 363,
      "start": 486.53,
      "end": 487.53,
      "text": "還有一個東西"
    },
    {
      "index": 364,
      "start": 487.53,
      "end": 489.53,
      "text": "就是對我考慮"
    },
    {
      "index": 365,
      "start": 489.53,
      "end": 490.53,
      "text": "他是這樣"
    },
    {
      "index": 366,
      "start": 490.53,
      "end": 492.53,
      "text": "短時間是這三項"
    },
    {
      "index": 367,
      "start": 492.53,
      "end": 493.53,
      "text": "所以"
    },
    {
      "index": 368,
      "start": 493.53,
      "end": 494.53,
      "text": "你說"
    },
    {
      "index": 369,
      "start": 494.53,
      "end": 496.53,
      "text": "我原來認為是這樣的"
    },
    {
      "index": 370,
      "start": 496.53,
      "end": 497.53,
      "text": "後來你聽"
    },
    {
      "index": 371,
      "start": 497.53,
      "end": 499.53,
      "text": "原來你一人"
    },
    {
      "index": 372,
      "start": 499.53,
      "end": 500.53,
      "text": "我考慮"
    },
    {
      "index": 373,
      "start": 500.53,
      "end": 501.53,
      "text": "我也犯了這個錯"
    },
    {
      "index": 374,
      "start": 501.53,
      "end": 503.53,
      "text": "但是我發現是"
    },
    {
      "index": 375,
      "start": 503.53,
      "end": 505.53,
      "text": "他的這次新聞是這樣的"
    },
    {
      "index": 376,
      "start": 505.53,
      "end": 507.53,
      "text": "可動機發人對我"
    },
    {
      "index": 377,
      "start": 507.53,
      "end": 509.53,
      "text": "這個"
    },
    {
      "index": 378,
      "start": 509.53,
      "end": 511.53,
      "text": "這個才是真正高級的動機"
    },
    {
      "index": 379,
      "start": 511.53,
      "end": 512.53,
      "text": "你知道嗎"
    },
    {
      "index": 380,
      "start": 512.53,
      "end": 513.53,
      "text": "你給大家講"
    },
    {
      "index": 381,
      "start": 513.53,
      "end": 515.53,
      "text": "我到底是怎麼做的"
    },
    {
      "index": 382,
      "start": 515.53,
      "end": 517.53,
      "text": "這就是有用的"
    },
    {
      "index": 383,
      "start": 517.53,
      "end": 518.53,
      "text": "這種視頻"
    },
    {
      "index": 384,
      "start": 518.53,
      "end": 520.53,
      "text": "天然就是"
    },
    {
      "index": 385,
      "start": 520.53,
      "end": 521.53,
      "text": "就是身體"
    },
    {
      "index": 386,
      "start": 521.53,
      "end": 523.53,
      "text": "你能替我吧"
    },
    {
      "index": 387,
      "start": 523.53,
      "end": 524.53,
      "text": "所以什麼本來"
    },
    {
      "index": 388,
      "start": 524.53,
      "end": 525.53,
      "text": "還能到一邊去吧"
    },
    {
      "index": 389,
      "start": 525.53,
      "end": 526.53,
      "text": "所以各位"
    },
    {
      "index": 390,
      "start": 526.53,
      "end": 527.53,
      "text": "今天呢"
    },
    {
      "index": 391,
      "start": 527.53,
      "end": 528.53,
      "text": "我就希望你想幾個問題"
    },
    {
      "index": 392,
      "start": 528.53,
      "end": 529.53,
      "text": "所以第一個問題"
    },
    {
      "index": 393,
      "start": 529.53,
      "end": 531.53,
      "text": "就是你現在做的這個事情"
    },
    {
      "index": 394,
      "start": 531.53,
      "end": 533.53,
      "text": "是你考慮能力的事情"
    },
    {
      "index": 395,
      "start": 533.53,
      "end": 535.53,
      "text": "還是已經有的尷尬"
    },
    {
      "index": 396,
      "start": 535.53,
      "end": 537.53,
      "text": "然後有了會如果沒有"
    },
    {
      "index": 397,
      "start": 537.53,
      "end": 539.53,
      "text": "把它放進去的計劃"
    },
    {
      "index": 398,
      "start": 539.53,
      "end": 540.53,
      "text": "只是方向"
    },
    {
      "index": 399,
      "start": 540.53,
      "end": 541.53,
      "text": "遇到一個真正"
    },
    {
      "index": 400,
      "start": 541.53,
      "end": 543.53,
      "text": "你佩服的記者"
    },
    {
      "index": 401,
      "start": 543.53,
      "end": 544.53,
      "text": "問他那個問題"
    },
    {
      "index": 402,
      "start": 544.53,
      "end": 545.53,
      "text": "你有那些"
    },
    {
      "index": 403,
      "start": 545.53,
      "end": 546.53,
      "text": "就你認為很重要"
    },
    {
      "index": 404,
      "start": 546.53,
      "end": 548.53,
      "text": "但是被我們這些人"
    },
    {
      "index": 405,
      "start": 548.53,
      "end": 549.53,
      "text": "大部分人都忽略的人質"
    },
    {
      "index": 406,
      "start": 549.53,
      "end": 550.53,
      "text": "忽略的人質"
    },
    {
      "index": 407,
      "start": 550.53,
      "end": 551.53,
      "text": "忽略的人質"
    },
    {
      "index": 408,
      "start": 551.53,
      "end": 552.53,
      "text": "有沒有那麼一個是你人"
    },
    {
      "index": 409,
      "start": 552.53,
      "end": 553.53,
      "text": "但是這麼人類的"
    },
    {
      "index": 410,
      "start": 553.53,
      "end": 554.53,
      "text": "後來發現"
    },
    {
      "index": 411,
      "start": 554.53,
      "end": 555.53,
      "text": "現在是這樣"
    },
    {
      "index": 412,
      "start": 555.53,
      "end": 556.53,
      "text": "然後的人生發了那邊"
    },
    {
      "index": 413,
      "start": 556.53,
      "end": 557.53,
      "text": "就問這個問題"
    },
    {
      "index": 414,
      "start": 557.53,
      "end": 558.53,
      "text": "他能幫你少主管"
    },
    {
      "index": 415,
      "start": 558.53,
      "end": 559.53,
      "text": "如果叫他認知"
    },
    {
      "index": 416,
      "start": 559.53,
      "end": 560.53,
      "text": "就做本來"
    },
    {
      "index": 417,
      "start": 560.53,
      "end": 561.53,
      "text": "然後第三個"
    },
    {
      "index": 418,
      "start": 561.53,
      "end": 563.53,
      "text": "一旦你應有了"
    },
    {
      "index": 419,
      "start": 563.53,
      "end": 565.53,
      "text": "有了這種靈感的時候"
    },
    {
      "index": 420,
      "start": 565.53,
      "end": 566.53,
      "text": "所以是把的計劃"
    },
    {
      "index": 421,
      "start": 566.53,
      "end": 567.53,
      "text": "去世是什麼"
    },
    {
      "index": 422,
      "start": 567.53,
      "end": 568.53,
      "text": "我認為是"
    },
    {
      "index": 423,
      "start": 568.53,
      "end": 572.53,
      "text": "誒"
    },
    {
      "index": 424,
      "start": 572.53,
      "end": 573.53,
      "text": "方向已經中卻"
    },
    {
      "index": 425,
      "start": 573.53,
      "end": 575.53,
      "text": "方向錯了"
    },
    {
      "index": 426,
      "start": 575.53,
      "end": 576.53,
      "text": "努力白費"
    }
  ]
}