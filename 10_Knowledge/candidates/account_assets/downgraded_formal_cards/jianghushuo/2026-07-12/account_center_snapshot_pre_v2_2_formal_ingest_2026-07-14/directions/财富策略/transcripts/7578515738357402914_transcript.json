    },
    {
      "index": 3,
      "start": 60.0,
      "end": 61.54,
      "text": "这个数就值钱"
    },
    {
      "index": 4,
      "start": 62.3,
      "end": 64.6,
      "text": "所以各位你平时读书的笔记"
    },
    {
      "index": 5,
