    {
      "index": 115,
      "start": 299.76,
      "end": 303.32,
      "text": "或者你哪一章只跟着我来处理"
    },
    {
      "index": 116,
      "start": 303.32,
      "end": 307.09,
      "text": "你有哪些镜能"
