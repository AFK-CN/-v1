      "end": 133.14,
      "text": "包一枪"
    },
    {
      "index": 84,
      "start": 133.14,
      "end": 134.14,
      "text": "准备打中"
    },
    {
      "index": 85,
      "start": 134.14,
      "end": 134.94,
      "text": "还是哪个枪"
    },
    {
      "index": 86,
      "start": 134.94,
      "end": 136.18,
      "text": "帮帮帮帮帮帮"
    },
    {
      "index": 87,
      "start": 136.18,
      "end": 136.9,
      "text": "一顿乱枪"
