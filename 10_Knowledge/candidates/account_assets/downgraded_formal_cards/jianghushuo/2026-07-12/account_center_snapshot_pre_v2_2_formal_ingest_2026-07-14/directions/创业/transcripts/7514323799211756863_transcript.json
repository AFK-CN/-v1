    {
      "index": 99,
      "start": 152.58,
      "end": 153.34,
      "text": "后天在地"
    },
    {
      "index": 100,
      "start": 153.34,
      "end": 153.98,
      "text": "就没事"
    },
    {
      "index": 101,
      "start": 153.98,
      "end": 154.94,
      "text": "有空的时候"
    },
    {
      "index": 102,
      "start": 154.94,
      "end": 156.06,
      "text": "花个三分钟五分钟"
    },
    {
      "index": 103,
      "start": 156.06,
      "end": 156.94,
      "text": "就赶那个事"
    },
    {
      "index": 104,
      "start": 156.94,
