{
  "language": "zh",
  "duration": 229.05125,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 2.0,
      "text": "我真的是很討厭戀"
    },
    {
      "index": 2,
      "start": 2.0,
      "end": 4.74,
      "text": "上同時出現又有又乾乾"
    },
    {
      "index": 3,
      "start": 4.74,
      "end": 6.32,
      "text": "而且是略空的乾"
    },
    {
      "index": 4,
      "start": 6.32,
      "end": 7.2,
      "text": "略度越有"
    },
    {
      "index": 5,
      "start": 7.2,
      "end": 8.32,
      "text": "她不知道我就想真的"
    },
    {
      "index": 6,
      "start": 8.32,
      "end": 9.76,
      "text": "零一今天跟小麥有"
    },
    {
      "index": 7,
      "start": 9.76,
      "end": 10.8,
      "text": "那一乾或不輸入"
    },
    {
      "index": 8,
      "start": 10.8,
      "end": 11.76,
      "text": "其實這個時候"
    },
    {
      "index": 9,
      "start": 11.76,
      "end": 13.76,
      "text": "臉上並不是水油不平衡"
    },
    {
      "index": 10,
      "start": 13.76,
      "end": 16.0,
      "text": "而是我們的平常受損了"
    },
    {
      "index": 11,
      "start": 16.0,
      "end": 17.76,
      "text": "所以這個時候單純的空油"
    },
    {
      "index": 12,
      "start": 17.76,
      "end": 18.6,
      "text": "或者是不水"
    },
    {
      "index": 13,
      "start": 18.6,
      "end": 20.24,
      "text": "都起不到任何的作用"
    },
    {
      "index": 14,
      "start": 20.24,
      "end": 20.96,
      "text": "反而會讓臉"
    },
    {
      "index": 15,
      "start": 20.96,
      "end": 22.16,
      "text": "覺得願意滅了一個乾"
    },
    {
      "index": 16,
      "start": 22.16,
      "end": 22.8,
      "text": "這個就有"
    },
    {
      "index": 17,
      "start": 22.8,
      "end": 24.08,
      "text": "這個時候你就可以按照"
    },
    {
      "index": 18,
      "start": 24.08,
      "end": 25.76,
      "text": "我今天分享這個方法來做"
    },
    {
      "index": 19,
      "start": 25.76,
      "end": 27.2,
      "text": "外有那乾的感覺"
    },
    {
      "index": 20,
      "start": 27.2,
      "end": 28.88,
      "text": "真的是能環節的很快"
    },
    {
      "index": 21,
      "start": 28.88,
      "end": 30.08,
      "text": "它先說一個冷靜"
    },
    {
      "index": 22,
      "start": 30.08,
      "end": 31.12,
      "text": "很多萬有那乾"
    },
    {
      "index": 23,
      "start": 31.12,
      "end": 33.12,
      "text": "其實都是因為洗臉不當早冷的"
    },
    {
      "index": 24,
      "start": 33.12,
      "end": 34.32,
      "text": "要我們就是用那種"
    },
    {
      "index": 25,
      "start": 34.32,
      "end": 35.6,
      "text": "大碗造季節"
    },
    {
      "index": 26,
      "start": 35.6,
      "end": 37.2,
      "text": "要我們就是切碗裝蟲"
    },
    {
      "index": 27,
      "start": 37.2,
      "end": 38.48,
      "text": "還要二次清潔"
    },
    {
      "index": 28,
      "start": 38.48,
      "end": 39.76,
      "text": "導致過度清潔了"
    },
    {
      "index": 29,
      "start": 39.76,
      "end": 40.96,
      "text": "要我們就是把臉"
    },
    {
      "index": 30,
      "start": 40.96,
      "end": 42.72,
      "text": "幫助盤子一樣來挖"
    },
    {
      "index": 31,
      "start": 42.72,
      "end": 44.0,
      "text": "把臉挖的通口"
    },
    {
      "index": 32,
      "start": 44.0,
      "end": 44.8,
      "text": "正確的方法"
    },
    {
      "index": 33,
      "start": 44.8,
      "end": 46.24,
      "text": "應該是用這種洗油"
    },
    {
      "index": 34,
      "start": 46.24,
      "end": 47.68,
      "text": "不洗致的節的來洗"
    },
    {
      "index": 35,
      "start": 47.68,
      "end": 48.48,
      "text": "這個我分享的"
    },
    {
      "index": 36,
      "start": 48.48,
      "end": 49.36,
      "text": "他們全部都是"
    },
    {
      "index": 37,
      "start": 49.36,
      "end": 50.48,
      "text": "APPG的飆火腿"
    },
    {
      "index": 38,
      "start": 50.48,
      "end": 51.68,
      "text": "非常非常溫和"
    },
    {
      "index": 39,
      "start": 51.68,
      "end": 53.28,
      "text": "但是又可以把臉洗乾子"
    },
    {
      "index": 40,
      "start": 53.28,
      "end": 54.4,
      "text": "四個時候水溫"
    },
    {
      "index": 41,
      "start": 54.4,
      "end": 55.12,
      "text": "不要太高"
    },
    {
      "index": 42,
      "start": 55.12,
      "end": 57.12,
      "text": "然後手在臉上清清的"
    },
    {
      "index": 43,
      "start": 57.12,
      "end": 58.08,
      "text": "按壓就可以了"
    },
    {
      "index": 44,
      "start": 58.08,
      "end": 59.28,
      "text": "不要來回地去做"
    },
    {
      "index": 45,
      "start": 59.28,
      "end": 60.08,
      "text": "這兩次洗臉"
    },
    {
      "index": 46,
      "start": 60.08,
      "end": 61.28,
      "text": "就是又乾淨"
    },
    {
      "index": 47,
      "start": 61.28,
      "end": 62.88,
      "text": "但是又不會傷害的病"
    },
    {
      "index": 48,
      "start": 62.88,
      "end": 63.28,
      "text": "你知道"
    },
    {
      "index": 49,
      "start": 63.28,
      "end": 64.08,
      "text": "跟在我"
    },
    {
      "index": 50,
      "start": 64.08,
      "end": 65.68,
      "text": "從洗乾淨之後"
    },
    {
      "index": 51,
      "start": 65.68,
      "end": 66.8,
      "text": "就可以用一個"
    },
    {
      "index": 52,
      "start": 66.8,
      "end": 67.52,
      "text": "濾露精華"
    },
    {
      "index": 53,
      "start": 67.52,
      "end": 68.88,
      "text": "跟土量三棒來打底"
    },
    {
      "index": 54,
      "start": 68.88,
      "end": 70.48,
      "text": "給我的皮膚做一個"
    },
    {
      "index": 55,
      "start": 70.48,
      "end": 71.76,
      "text": "三層的補水"
    },
    {
      "index": 56,
      "start": 71.76,
      "end": 72.88,
      "text": "和微溫球"
    },
    {
      "index": 57,
      "start": 72.88,
      "end": 74.0,
      "text": "再點一個這種"
    },
    {
      "index": 58,
      "start": 74.0,
      "end": 74.64,
      "text": "又清漲"
    },
    {
      "index": 59,
      "start": 74.64,
      "end": 76.4,
      "text": "但是修過濾有非常好"
    },
    {
      "index": 60,
      "start": 76.4,
      "end": 77.28,
      "text": "土墨裡面的"
    },
    {
      "index": 61,
      "start": 77.28,
      "end": 77.92,
      "text": "那蔥墨是因為我"
    },
    {
      "index": 62,
      "start": 77.92,
      "end": 78.96,
      "text": "這個一個納分漲"
    },
    {
      "index": 63,
      "start": 78.96,
      "end": 81.12,
      "text": "我它很適合我們有命比"
    },
    {
      "index": 64,
      "start": 81.12,
      "end": 82.32,
      "text": "就是外有那一乾"
    },
    {
      "index": 65,
      "start": 82.32,
      "end": 83.6,
      "text": "它其實就是有命比"
    },
    {
      "index": 66,
      "start": 83.6,
      "end": 84.96,
      "text": "外有那一乾的飽門"
    },
    {
      "index": 67,
      "start": 84.96,
      "end": 85.68,
      "text": "或服補一樣"
    },
    {
      "index": 68,
      "start": 85.68,
      "end": 86.72,
      "text": "注意三個重點"
    },
    {
      "index": 69,
      "start": 86.72,
      "end": 87.28,
      "text": "修護品"
    },
    {
      "index": 70,
      "start": 87.28,
      "end": 88.48,
      "text": "這樣蒸層補水"
    },
    {
      "index": 71,
      "start": 88.48,
      "end": 89.76,
      "text": "以及改善活活"
    },
    {
      "index": 72,
      "start": 89.76,
      "end": 90.24,
      "text": "這一次"
    },
    {
      "index": 73,
      "start": 90.24,
      "end": 91.36,
      "text": "它只是這三點"
    },
    {
      "index": 74,
      "start": 91.36,
      "end": 92.16,
      "text": "全部都能活到"
    },
    {
      "index": 75,
      "start": 92.16,
      "end": 92.8,
      "text": "它是這種"
    },
    {
      "index": 76,
      "start": 92.8,
      "end": 94.48,
      "text": "非常清淨的"
    },
    {
      "index": 77,
      "start": 94.48,
      "end": 95.28,
      "text": "就有一個意思"
    },
    {
      "index": 78,
      "start": 95.28,
      "end": 95.92,
      "text": "而此"
    },
    {
      "index": 79,
      "start": 95.92,
      "end": 97.28,
      "text": "還是無油配方"
    },
    {
      "index": 80,
      "start": 97.28,
      "end": 99.28,
      "text": "所以非常適合我們有命比"
    },
    {
      "index": 81,
      "start": 99.28,
      "end": 99.76,
      "text": "負責的人"
    },
    {
      "index": 82,
      "start": 99.76,
      "end": 100.4,
      "text": "雖然是那種"
    },
    {
      "index": 83,
      "start": 100.4,
      "end": 101.76,
      "text": "冰冰涼涼的"
    },
    {
      "index": 84,
      "start": 101.76,
      "end": 103.28,
      "text": "它透氣很透氣"
    },
    {
      "index": 85,
      "start": 103.28,
      "end": 104.08,
      "text": "就是我感覺現在"
    },
    {
      "index": 86,
      "start": 104.08,
      "end": 104.96,
      "text": "我補到的一方"
    },
    {
      "index": 87,
      "start": 104.96,
      "end": 105.6,
      "text": "就覺得它"
    },
    {
      "index": 88,
      "start": 105.6,
      "end": 106.56,
      "text": "在大口的喝水"
    },
    {
      "index": 89,
      "start": 106.56,
      "end": 107.28,
      "text": "很舒服"
    },
    {
      "index": 90,
      "start": 107.28,
      "end": 108.0,
      "text": "不用擔心說"
    },
    {
      "index": 91,
      "start": 108.0,
      "end": 108.72,
      "text": "用這個土墨"
    },
    {
      "index": 92,
      "start": 108.72,
      "end": 110.32,
      "text": "是因為我會讓我們弄動"
    },
    {
      "index": 93,
      "start": 110.32,
      "end": 111.52,
      "text": "現在就是感覺像"
    },
    {
      "index": 94,
      "start": 111.52,
      "end": 112.56,
      "text": "造了一層水"
    },
    {
      "index": 95,
      "start": 112.56,
      "end": 113.28,
      "text": "我在臉上"
    },
    {
      "index": 96,
      "start": 113.28,
      "end": 114.72,
      "text": "原本不斷的皮膚"
    },
    {
      "index": 97,
      "start": 114.72,
      "end": 115.68,
      "text": "灌水一天去"
    },
    {
      "index": 98,
      "start": 115.68,
      "end": 116.64,
      "text": "它裡面會有力"
    },
    {
      "index": 99,
      "start": 116.64,
      "end": 117.52,
      "text": "丟丟的酸"
    },
    {
      "index": 100,
      "start": 117.52,
      "end": 118.08,
      "text": "但是又了"
    },
    {
      "index": 101,
      "start": 118.08,
      "end": 120.16,
      "text": "很多的修護層分來包裹"
    },
    {
      "index": 102,
      "start": 120.16,
      "end": 121.12,
      "text": "目的是為了"
    },
    {
      "index": 103,
      "start": 121.12,
      "end": 123.12,
      "text": "幫我們打開皮膚的通道"
    },
    {
      "index": 104,
      "start": 123.12,
      "end": 123.84,
      "text": "讓後續的"
    },
    {
      "index": 105,
      "start": 123.84,
      "end": 124.96,
      "text": "會不會更好的"
    },
    {
      "index": 106,
      "start": 124.96,
      "end": 126.4,
      "text": "被我們的皮膚吃起來"
    },
    {
      "index": 107,
      "start": 126.4,
      "end": 127.12,
      "text": "所以不用擔心"
    },
    {
      "index": 108,
      "start": 127.12,
      "end": 127.76,
      "text": "會刺激"
    },
    {
      "index": 109,
      "start": 127.76,
      "end": 128.88,
      "text": "平時經常吃完"
    },
    {
      "index": 110,
      "start": 128.88,
      "end": 129.84,
      "text": "命度臉的剪的"
    },
    {
      "index": 111,
      "start": 129.84,
      "end": 130.96,
      "text": "也可以常被一品"
    },
    {
      "index": 112,
      "start": 130.96,
      "end": 131.76,
      "text": "這個在家裡面"
    },
    {
      "index": 113,
      "start": 131.76,
      "end": 132.4,
      "text": "既然光電"
    },
    {
      "index": 114,
      "start": 132.4,
      "end": 133.2,
      "text": "可以用看一些"
    },
    {
      "index": 115,
      "start": 133.2,
      "end": 134.08,
      "text": "快速修護"
    },
    {
      "index": 116,
      "start": 134.08,
      "end": 134.8,
      "text": "我們副食道"
    },
    {
      "index": 117,
      "start": 134.8,
      "end": 135.36,
      "text": "是我分鐘"
    },
    {
      "index": 118,
      "start": 135.36,
      "end": 136.8,
      "text": "之後就可以去洗掉的話"
    },
    {
      "index": 119,
      "start": 136.8,
      "end": 138.0,
      "text": "其實完了之後"
    },
    {
      "index": 120,
      "start": 138.0,
      "end": 139.2,
      "text": "我絕對我的這個皮膚"
    },
    {
      "index": 121,
      "start": 139.2,
      "end": 139.84,
      "text": "真的是"
    },
    {
      "index": 122,
      "start": 139.84,
      "end": 140.64,
      "text": "基於軟"
    },
    {
      "index": 123,
      "start": 140.64,
      "end": 142.0,
      "text": "QQ彈彈的"
    },
    {
      "index": 124,
      "start": 142.0,
      "end": 142.72,
      "text": "接下來就是"
    },
    {
      "index": 125,
      "start": 142.72,
      "end": 144.08,
      "text": "我們的後續護膚軟"
    },
    {
      "index": 126,
      "start": 144.08,
      "end": 144.8,
      "text": "洗完臉之後"
    },
    {
      "index": 127,
      "start": 144.8,
      "end": 145.84,
      "text": "我們一定要抓緊"
    },
    {
      "index": 128,
      "start": 145.84,
      "end": 146.72,
      "text": "時間難附服"
    },
    {
      "index": 129,
      "start": 146.72,
      "end": 147.68,
      "text": "我發現有很多節目"
    },
    {
      "index": 130,
      "start": 147.68,
      "end": 148.32,
      "text": "洗完早"
    },
    {
      "index": 131,
      "start": 148.32,
      "end": 149.28,
      "text": "洗完臉的時候"
    },
    {
      "index": 132,
      "start": 149.28,
      "end": 149.84,
      "text": "先是"
    },
    {
      "index": 133,
      "start": 149.84,
      "end": 150.96,
      "text": "慢用的吹一頭放"
    },
    {
      "index": 134,
      "start": 150.96,
      "end": 152.24,
      "text": "然後再塗個身體"
    },
    {
      "index": 135,
      "start": 152.24,
      "end": 153.28,
      "text": "爐帶來護膚"
    },
    {
      "index": 136,
      "start": 153.28,
      "end": 154.4,
      "text": "如果有這個洗完的話"
    },
    {
      "index": 137,
      "start": 154.4,
      "end": 155.04,
      "text": "一定要改"
    },
    {
      "index": 138,
      "start": 155.04,
      "end": 156.72,
      "text": "尤其是平常受損的節目"
    },
    {
      "index": 139,
      "start": 156.72,
      "end": 157.92,
      "text": "它會加上水分"
    },
    {
      "index": 140,
      "start": 157.92,
      "end": 158.48,
      "text": "蒸發到"
    },
    {
      "index": 141,
      "start": 158.48,
      "end": 160.08,
      "text": "我們基地更乾脆的水"
    },
    {
      "index": 142,
      "start": 160.08,
      "end": 161.92,
      "text": "後續護膚清量水的清涉"
    },
    {
      "index": 143,
      "start": 161.92,
      "end": 162.96,
      "text": "洗休護你槍的"
    },
    {
      "index": 144,
      "start": 162.96,
      "end": 164.56,
      "text": "不要用那種很有潤的"
    },
    {
      "index": 145,
      "start": 164.56,
      "end": 166.08,
      "text": "哪怕它的休護你再好"
    },
    {
      "index": 146,
      "start": 166.08,
      "end": 167.36,
      "text": "在我們有血的臉上"
    },
    {
      "index": 147,
      "start": 167.36,
      "end": 168.96,
      "text": "也很容易溫重一點對我來"
    },
    {
      "index": 148,
      "start": 168.96,
      "end": 170.48,
      "text": "果分身有綠州精華"
    },
    {
      "index": 149,
      "start": 170.48,
      "end": 171.88,
      "text": "來進行全臉搭"
    },
    {
      "index": 150,
      "start": 171.88,
      "end": 173.92,
      "text": "它是一款非常厲害的"
    },
    {
      "index": 151,
      "start": 173.92,
      "end": 175.04,
      "text": "修護水精華"
    },
    {
      "index": 152,
      "start": 175.04,
      "end": 176.08,
      "text": "堅持用的話"
    },
    {
      "index": 153,
      "start": 176.08,
      "end": 177.36,
      "text": "可以給我們的皮膚進行"
    },
    {
      "index": 154,
      "start": 177.36,
      "end": 178.4,
      "text": "深度的無血"
    },
    {
      "index": 155,
      "start": 178.4,
      "end": 180.0,
      "text": "也可以把我的平髒"
    },
    {
      "index": 156,
      "start": 180.0,
      "end": 180.88,
      "text": "兩碼和厚食"
    },
    {
      "index": 157,
      "start": 180.88,
      "end": 181.6,
      "text": "這款聽話"
    },
    {
      "index": 158,
      "start": 181.6,
      "end": 182.8,
      "text": "我覺得這就是外有"
    },
    {
      "index": 159,
      "start": 182.8,
      "end": 183.68,
      "text": "那一乾寶貝的"
    },
    {
      "index": 160,
      "start": 183.68,
      "end": 184.8,
      "text": "鮮水精華"
    },
    {
      "index": 161,
      "start": 184.8,
      "end": 186.48,
      "text": "精華是受了差不多了"
    },
    {
      "index": 162,
      "start": 186.48,
      "end": 187.04,
      "text": "我們再來"
    },
    {
      "index": 163,
      "start": 187.04,
      "end": 188.0,
      "text": "從一個都底白"
    },
    {
      "index": 164,
      "start": 188.0,
      "end": 189.04,
      "text": "三層都底"
    },
    {
      "index": 165,
      "start": 189.04,
      "end": 189.68,
      "text": "給你們看一下"
    },
    {
      "index": 166,
      "start": 189.68,
      "end": 190.64,
      "text": "看了這種風感"
    },
    {
      "index": 167,
      "start": 190.64,
      "end": 192.0,
      "text": "不是這種特點"
    },
    {
      "index": 168,
      "start": 192.0,
      "end": 193.52,
      "text": "就有的清爽特點水"
    },
    {
      "index": 169,
      "start": 193.52,
      "end": 195.04,
      "text": "因為外有那一乾七身品"
    },
    {
      "index": 170,
      "start": 195.04,
      "end": 196.24,
      "text": "上上其實有很多"
    },
    {
      "index": 171,
      "start": 196.24,
      "end": 197.92,
      "text": "我們讓我一點看見的香口"
    },
    {
      "index": 172,
      "start": 197.92,
      "end": 198.8,
      "text": "因為裡面的水分"
    },
    {
      "index": 173,
      "start": 198.8,
      "end": 200.08,
      "text": "就會從小口"
    },
    {
      "index": 174,
      "start": 200.08,
      "end": 200.96,
      "text": "慢慢有時"
    },
    {
      "index": 175,
      "start": 200.96,
      "end": 202.08,
      "text": "那都底"
    },
    {
      "index": 176,
      "start": 202.08,
      "end": 204.16,
      "text": "就相當於是給我們的皮膚"
    },
    {
      "index": 177,
      "start": 204.16,
      "end": 206.16,
      "text": "我們外在加外一層金鐘照"
    },
    {
      "index": 178,
      "start": 206.16,
      "end": 207.6,
      "text": "把一樣程度和水分"
    },
    {
      "index": 179,
      "start": 207.6,
      "end": 209.84,
      "text": "都老老的服風飲在我們皮膚裡"
    },
    {
      "index": 180,
      "start": 209.84,
      "end": 210.56,
      "text": "你只要用的話"
    },
    {
      "index": 181,
      "start": 210.56,
      "end": 211.2,
      "text": "外有那一乾"
    },
    {
      "index": 182,
      "start": 211.2,
      "end": 212.48,
      "text": "就會感上很多"
    },
    {
      "index": 183,
      "start": 212.48,
      "end": 214.32,
      "text": "今天的護膚跟練士品"
    },
    {
      "index": 184,
      "start": 214.32,
      "end": 215.2,
      "text": "就到這裡囉"
    },
    {
      "index": 185,
      "start": 215.2,
      "end": 216.24,
      "text": "我們趕著一下"
    },
    {
      "index": 186,
      "start": 216.24,
      "end": 217.2,
      "text": "現在的皮膚就是"
    },
    {
      "index": 187,
      "start": 217.2,
      "end": 218.08,
      "text": "感覺又是水"
    },
    {
      "index": 188,
      "start": 218.08,
      "end": 219.12,
      "text": "但是又不有你"
    },
    {
      "index": 189,
      "start": 219.12,
      "end": 220.88,
      "text": "我之前的在護群面分享過"
    },
    {
      "index": 190,
      "start": 220.88,
      "end": 222.0,
      "text": "好幾個姐妹"
    },
    {
      "index": 191,
      "start": 222.0,
      "end": 223.36,
      "text": "大快說效果很好"
    },
    {
      "index": 192,
      "start": 223.36,
      "end": 224.08,
      "text": "最短的"
    },
    {
      "index": 193,
      "start": 224.08,
      "end": 224.88,
      "text": "一個月除內"
    },
    {
      "index": 194,
      "start": 224.88,
      "end": 226.0,
      "text": "他們的這種型號"
    },
    {
      "index": 195,
      "start": 226.0,
      "end": 227.04,
      "text": "就感受了很多"
    },
    {
      "index": 196,
      "start": 227.04,
      "end": 228.16,
      "text": "所以外有那乾淨姐妹"
    },
    {
      "index": 197,
      "start": 228.16,
      "end": 229.04,
      "text": "一定要試試看"
    }
  ]
}