{
  "language": "zh",
  "duration": 347.3486875,
  "segments": [
    {
      "index": 1,
      "start": 0.72,
      "end": 2.46,
      "text": "歡迎收看小森林"
    },
    {
      "index": 2,
      "start": 2.46,
      "end": 4.36,
      "text": "叫東京吃什麼Vlog"
    },
    {
      "index": 3,
      "start": 4.36,
      "end": 10.54,
      "text": "下飛機放下行李飛站就是有面"
    },
    {
      "index": 4,
      "start": 10.54,
      "end": 11.66,
      "text": "我朋友說"
    },
    {
      "index": 5,
      "start": 11.66,
      "end": 14.86,
      "text": "色谷這家他們感覺是最好吃的"
    },
    {
      "index": 6,
      "start": 14.86,
      "end": 16.94,
      "text": "我們當天晚上是九點多多道的"
    },
    {
      "index": 7,
      "start": 16.94,
      "end": 18.54,
      "text": "這是門口的排隊情況"
    },
    {
      "index": 8,
      "start": 18.54,
      "end": 20.14,
      "text": "大家感受一下它的呼吸"
    },
    {
      "index": 9,
      "start": 20.14,
      "end": 22.62,
      "text": "我們晚上跟他排了一枚多小時"
    },
    {
      "index": 10,
      "start": 22.62,
      "end": 26.62,
      "text": "終於是吃上它有一點類似日本的熱感面"
    },
    {
      "index": 11,
      "start": 26.62,
      "end": 27.86,
      "text": "我點的辣的"
    },
    {
      "index": 12,
      "start": 27.86,
      "end": 29.78,
      "text": "然後蘿蔔又加了一個湯心膽"
    },
    {
      "index": 13,
      "start": 29.78,
      "end": 31.1,
      "text": "按在一起吃"
    },
    {
      "index": 14,
      "start": 31.1,
      "end": 32.66,
      "text": "本公內人覺得很過位"
    },
    {
      "index": 15,
      "start": 32.66,
      "end": 34.38,
      "text": "其實我是林陳梁念中"
    },
    {
      "index": 16,
      "start": 34.38,
      "end": 37.62,
      "text": "配得給你我的咳細膽量流出來了"
    },
    {
      "index": 17,
      "start": 37.62,
      "end": 39.66,
      "text": "它的面真的非常驚到"
    },
    {
      "index": 18,
      "start": 39.66,
      "end": 42.14,
      "text": "在家上一杯冰可烙"
    },
    {
      "index": 19,
      "start": 42.14,
      "end": 43.42,
      "text": "是忘了"
    },
    {
      "index": 20,
      "start": 43.42,
      "end": 45.54,
      "text": "就有面是我每次來的必吃吧"
    },
    {
      "index": 21,
      "start": 45.54,
      "end": 48.02,
      "text": "吃完就去附近的店裡店逛了一下"
    },
    {
      "index": 22,
      "start": 48.02,
      "end": 50.58,
      "text": "這個據說是能提升睡眠的女兒"
    },
    {
      "index": 23,
      "start": 50.58,
      "end": 52.26,
      "text": "我一口乾了"
    },
    {
      "index": 24,
      "start": 52.26,
      "end": 53.98,
      "text": "然後給大家回報一下"
    },
    {
      "index": 25,
      "start": 53.98,
      "end": 55.22,
      "text": "某用沒有"
    },
    {
      "index": 26,
      "start": 55.22,
      "end": 57.02,
      "text": "我當我還是睡眠了"
    },
    {
      "index": 27,
      "start": 57.14,
      "end": 58.82,
      "text": "就睡那種"
    },
    {
      "index": 28,
      "start": 58.82,
      "end": 60.62,
      "text": "魯酸菌的味道"
    },
    {
      "index": 29,
      "start": 60.62,
      "end": 62.3,
      "text": "烏烏烏的"
    },
    {
      "index": 30,
      "start": 62.3,
      "end": 63.82,
      "text": "第一次搞這麼酷"
    },
    {
      "index": 31,
      "start": 63.82,
      "end": 66.38,
      "text": "我們去打卡了一架網紅布上去"
    },
    {
      "index": 32,
      "start": 66.38,
      "end": 68.02,
      "text": "是一架面包店"
    },
    {
      "index": 33,
      "start": 68.02,
      "end": 69.98,
      "text": "拋幸運就要六排隊"
    },
    {
      "index": 34,
      "start": 69.98,
      "end": 71.1,
      "text": "就是要點四的"
    },
    {
      "index": 35,
      "start": 71.1,
      "end": 73.98,
      "text": "所以我們三個人點了十二個面包"
    },
    {
      "index": 36,
      "start": 73.98,
      "end": 75.18,
      "text": "這裡的看上面包"
    },
    {
      "index": 37,
      "start": 75.18,
      "end": 76.74,
      "text": "大概真的很好吃"
    },
    {
      "index": 38,
      "start": 76.74,
      "end": 79.02,
      "text": "他們家會有外的眼費的"
    },
    {
      "index": 39,
      "start": 79.02,
      "end": 81.58,
      "text": "在配一些湯和沙拉這類的店"
    },
    {
      "index": 40,
      "start": 81.58,
      "end": 84.18,
      "text": "其實我覺得湯沙拉什麼都還好"
    },
    {
      "index": 41,
      "start": 84.18,
      "end": 85.5,
      "text": "但他們家這個送的"
    },
    {
      "index": 42,
      "start": 85.5,
      "end": 87.66,
      "text": "這個小杯的肉會奶茶"
    },
    {
      "index": 43,
      "start": 87.66,
      "end": 88.86,
      "text": "好好喝"
    },
    {
      "index": 44,
      "start": 88.86,
      "end": 90.86,
      "text": "他們每個人就送這麼一小杯"
    },
    {
      "index": 45,
      "start": 90.86,
      "end": 92.74,
      "text": "不想要單點一個大杯的"
    },
    {
      "index": 46,
      "start": 92.74,
      "end": 93.9,
      "text": "覺得沒有啊"
    },
    {
      "index": 47,
      "start": 93.9,
      "end": 94.66,
      "text": "別人不行"
    },
    {
      "index": 48,
      "start": 94.66,
      "end": 95.74,
      "text": "轉成轉成"
    },
    {
      "index": 49,
      "start": 95.74,
      "end": 97.9,
      "text": "吃完就來擺關山消失了"
    },
    {
      "index": 50,
      "start": 99.1,
      "end": 100.78,
      "text": "逛了一下啥都沒買找"
    },
    {
      "index": 51,
      "start": 100.78,
      "end": 102.22,
      "text": "下午就來這邊"
    },
    {
      "index": 52,
      "start": 102.22,
      "end": 104.5,
      "text": "一架排隊往吃一個下午餐"
    },
    {
      "index": 53,
      "start": 104.5,
      "end": 106.26,
      "text": "不用排隊真的"
    },
    {
      "index": 54,
      "start": 106.26,
      "end": 109.26,
      "text": "我訂了一個熱果茶和酸餅"
    },
    {
      "index": 55,
      "start": 109.26,
      "end": 110.82,
      "text": "但是我感覺是家一般"
    },
    {
      "index": 56,
      "start": 110.82,
      "end": 113.54,
      "text": "還沒有深圳的不利死好吃"
    },
    {
      "index": 57,
      "start": 113.54,
      "end": 115.46,
      "text": "但他們家環境很好很漂亮"
    },
    {
      "index": 58,
      "start": 115.46,
      "end": 116.78,
      "text": "就是很出偏的那種"
    },
    {
      "index": 59,
      "start": 116.78,
      "end": 118.58,
      "text": "晚上約了一家受洗燒"
    },
    {
      "index": 60,
      "start": 118.58,
      "end": 121.7,
      "text": "還是開在一家非常小的小銷子裡面的"
    },
    {
      "index": 61,
      "start": 121.7,
      "end": 124.54,
      "text": "他家的肉是我吃過的受洗燒"
    },
    {
      "index": 62,
      "start": 124.54,
      "end": 125.7,
      "text": "做一大的"
    },
    {
      "index": 63,
      "start": 125.7,
      "end": 126.58,
      "text": "就一片"
    },
    {
      "index": 64,
      "start": 126.58,
      "end": 128.18,
      "text": "頂人家好幾片"
    },
    {
      "index": 65,
      "start": 128.18,
      "end": 129.46,
      "text": "翻一場非常嫩"
    },
    {
      "index": 66,
      "start": 129.46,
      "end": 130.98,
      "text": "入口疑化"
    },
    {
      "index": 67,
      "start": 130.98,
      "end": 132.66,
      "text": "我們好像是訂的泡餐"
    },
    {
      "index": 68,
      "start": 132.66,
      "end": 134.3,
      "text": "一個人會有兩片"
    },
    {
      "index": 69,
      "start": 134.3,
      "end": 135.18,
      "text": "如果不夠的話"
    },
    {
      "index": 70,
      "start": 135.18,
      "end": 136.42,
      "text": "可以再額外的店"
    },
    {
      "index": 71,
      "start": 136.42,
      "end": 137.78,
      "text": "但是對我來說"
    },
    {
      "index": 72,
      "start": 137.78,
      "end": 140.18,
      "text": "兩片盒牛在家一些蔬菜"
    },
    {
      "index": 73,
      "start": 140.18,
      "end": 141.5,
      "text": "你現在之類的"
    },
    {
      "index": 74,
      "start": 141.5,
      "end": 143.66,
      "text": "就已經吃到福強走了"
    },
    {
      "index": 75,
      "start": 143.66,
      "end": 145.74,
      "text": "最後給我上的這一片肉"
    },
    {
      "index": 76,
      "start": 145.74,
      "end": 147.26,
      "text": "我只吃了一半"
    },
    {
      "index": 77,
      "start": 147.26,
      "end": 149.74,
      "text": "因為朋友吃多了還是有點日子"
    },
    {
      "index": 78,
      "start": 149.74,
      "end": 151.66,
      "text": "分享一下子上的海景"
    },
    {
      "index": 79,
      "start": 151.66,
      "end": 153.58,
      "text": "今天我準備換一家酒店"
    },
    {
      "index": 80,
      "start": 153.58,
      "end": 155.02,
      "text": "這次做的酒店"
    },
    {
      "index": 81,
      "start": 155.02,
      "end": 157.9,
      "text": "一出來就可以看到東京卡"
    },
    {
      "index": 82,
      "start": 157.9,
      "end": 160.22,
      "text": "中午就在酒店附近隨便找了一家"
    },
    {
      "index": 83,
      "start": 160.22,
      "end": 160.86,
      "text": "那一店"
    },
    {
      "index": 84,
      "start": 160.86,
      "end": 163.1,
      "text": "我店的這個又此風味的"
    },
    {
      "index": 85,
      "start": 163.1,
      "end": 165.58,
      "text": "這裡沒有一個選項是焦源球"
    },
    {
      "index": 86,
      "start": 165.58,
      "end": 167.58,
      "text": "很好奇是什麼東西"
    },
    {
      "index": 87,
      "start": 167.58,
      "end": 169.5,
      "text": "但的時候發現自己長的動"
    },
    {
      "index": 88,
      "start": 169.5,
      "end": 171.58,
      "text": "公布的等等"
    },
    {
      "index": 89,
      "start": 171.58,
      "end": 173.74,
      "text": "像古董一樣的東西"
    },
    {
      "index": 90,
      "start": 173.74,
      "end": 175.34,
      "text": "就是焦源球"
    },
    {
      "index": 91,
      "start": 175.34,
      "end": 176.94,
      "text": "直接把它倒進去"
    },
    {
      "index": 92,
      "start": 176.94,
      "end": 178.86,
      "text": "其實我覺得日本拉麵都有練習"
    },
    {
      "index": 93,
      "start": 178.86,
      "end": 179.58,
      "text": "可能不行"
    },
    {
      "index": 94,
      "start": 179.58,
      "end": 180.7,
      "text": "就不夠入味吧"
    },
    {
      "index": 95,
      "start": 180.7,
      "end": 182.62,
      "text": "晚上吃的一家歐麥咖啡"
    },
    {
      "index": 96,
      "start": 182.62,
      "end": 185.42,
      "text": "他們家的血頭是好像餐具"
    },
    {
      "index": 97,
      "start": 185.42,
      "end": 186.78,
      "text": "都用的是愛馬士的"
    },
    {
      "index": 98,
      "start": 186.78,
      "end": 188.54,
      "text": "其實我訂之前我覺得這種網紅"
    },
    {
      "index": 99,
      "start": 188.54,
      "end": 189.66,
      "text": "電話會不會不好吃"
    },
    {
      "index": 100,
      "start": 189.66,
      "end": 190.94,
      "text": "畢竟我是來吃美食的"
    },
    {
      "index": 101,
      "start": 190.94,
      "end": 192.3,
      "text": "我又不是來吃愛馬士的"
    },
    {
      "index": 102,
      "start": 192.3,
      "end": 194.54,
      "text": "但是我多率吧"
    },
    {
      "index": 103,
      "start": 194.54,
      "end": 195.1,
      "text": "真的"
    },
    {
      "index": 104,
      "start": 195.1,
      "end": 196.86,
      "text": "之後幾好吃"
    },
    {
      "index": 105,
      "start": 196.86,
      "end": 199.9,
      "text": "這個是我做出來的東西非常特別"
    },
    {
      "index": 106,
      "start": 199.9,
      "end": 202.22,
      "text": "而且它的原理特別的油目"
    },
    {
      "index": 107,
      "start": 202.22,
      "end": 203.9,
      "text": "我就一直一直在用它"
    },
    {
      "index": 108,
      "start": 203.9,
      "end": 206.94,
      "text": "幾真的那一點中文共說話"
    },
    {
      "index": 109,
      "start": 206.94,
      "end": 208.7,
      "text": "然後它知道我愛吃海膽"
    },
    {
      "index": 110,
      "start": 208.7,
      "end": 210.62,
      "text": "給我那麼一個超級的"
    },
    {
      "index": 111,
      "start": 210.62,
      "end": 213.1,
      "text": "具有霸海膽的受呼"
    },
    {
      "index": 112,
      "start": 213.1,
      "end": 214.7,
      "text": "一口下去"
    },
    {
      "index": 113,
      "start": 214.7,
      "end": 216.7,
      "text": "最後還好吃完了"
    },
    {
      "index": 114,
      "start": 216.7,
      "end": 217.02,
      "text": "是吧"
    },
    {
      "index": 115,
      "start": 217.02,
      "end": 219.66,
      "text": "我們剛才我就去散布了兩個小時"
    },
    {
      "index": 116,
      "start": 219.66,
      "end": 221.9,
      "text": "味的就是吃這家網紅"
    },
    {
      "index": 117,
      "start": 221.9,
      "end": 223.42,
      "text": "又子拉麵店"
    },
    {
      "index": 118,
      "start": 223.42,
      "end": 224.62,
      "text": "不店了兩種口味的"
    },
    {
      "index": 119,
      "start": 224.62,
      "end": 225.26,
      "text": "這個是拉味的"
    },
    {
      "index": 120,
      "start": 225.26,
      "end": 226.86,
      "text": "還有一個是他們的招牌"
    },
    {
      "index": 121,
      "start": 226.86,
      "end": 228.22,
      "text": "這個騰舞幼稚的"
    },
    {
      "index": 122,
      "start": 228.22,
      "end": 230.3,
      "text": "我個人覺得是拉的"
    },
    {
      "index": 123,
      "start": 230.3,
      "end": 231.66,
      "text": "會更好吃一些"
    },
    {
      "index": 124,
      "start": 231.66,
      "end": 233.82,
      "text": "第三天歐湖吐燉了"
    },
    {
      "index": 125,
      "start": 233.82,
      "end": 235.42,
      "text": "昨天買了一點高帽子"
    },
    {
      "index": 126,
      "start": 235.42,
      "end": 237.34,
      "text": "馬上帶上一頓拍"
    },
    {
      "index": 127,
      "start": 237.34,
      "end": 240.06,
      "text": "給大家分享一下歐湖的超越幼稚"
    },
    {
      "index": 128,
      "start": 240.06,
      "end": 241.34,
      "text": "懶掉時刻"
    },
    {
      "index": 129,
      "start": 241.34,
      "end": 243.58,
      "text": "今晚吃的是我們每次來的"
    },
    {
      "index": 130,
      "start": 243.58,
      "end": 245.42,
      "text": "壁吃店漫与飯"
    },
    {
      "index": 131,
      "start": 245.42,
      "end": 248.54,
      "text": "這家是我2019年隨便吃的家"
    },
    {
      "index": 132,
      "start": 248.54,
      "end": 249.42,
      "text": "沒想到"
    },
    {
      "index": 133,
      "start": 249.42,
      "end": 251.74,
      "text": "以戰風省直接變成了"
    },
    {
      "index": 134,
      "start": 251.74,
      "end": 253.26,
      "text": "我現在心中漫与飯"
    },
    {
      "index": 135,
      "start": 253.26,
      "end": 256.06,
      "text": "第一就是這家讓我以為日本的"
    },
    {
      "index": 136,
      "start": 256.06,
      "end": 258.38,
      "text": "每一家漫与飯都沒有那麼好吃"
    },
    {
      "index": 137,
      "start": 258.38,
      "end": 260.06,
      "text": "那我後面就吃了幾家別的"
    },
    {
      "index": 138,
      "start": 260.06,
      "end": 263.26,
      "text": "我發現好像都沒有這家好吃"
    },
    {
      "index": 139,
      "start": 263.26,
      "end": 264.7,
      "text": "他們家都是會考的"
    },
    {
      "index": 140,
      "start": 264.7,
      "end": 267.18,
      "text": "外面是那種交交的"
    },
    {
      "index": 141,
      "start": 267.18,
      "end": 268.78,
      "text": "然後你加一點點的"
    },
    {
      "index": 142,
      "start": 268.78,
      "end": 270.62,
      "text": "子書絲的充花"
    },
    {
      "index": 143,
      "start": 270.62,
      "end": 272.7,
      "text": "和他們家米飯辦在一起"
    },
    {
      "index": 144,
      "start": 272.7,
      "end": 273.9,
      "text": "一口下去"
    },
    {
      "index": 145,
      "start": 273.9,
      "end": 274.78,
      "text": "一個字"
    },
    {
      "index": 146,
      "start": 274.78,
      "end": 275.5,
      "text": "絕"
    },
    {
      "index": 147,
      "start": 275.5,
      "end": 278.22,
      "text": "就地牌妹妹本來說他不樂不吃"
    },
    {
      "index": 148,
      "start": 278.22,
      "end": 279.58,
      "text": "我說你真的要試試"
    },
    {
      "index": 149,
      "start": 279.58,
      "end": 281.02,
      "text": "這家來的來了"
    },
    {
      "index": 150,
      "start": 281.02,
      "end": 284.38,
      "text": "結果他光盤的比我還好快"
    },
    {
      "index": 151,
      "start": 284.38,
      "end": 286.38,
      "text": "吃完就在這家商場"
    },
    {
      "index": 152,
      "start": 286.38,
      "end": 287.18,
      "text": "你逛了一下"
    },
    {
      "index": 153,
      "start": 287.18,
      "end": 288.62,
      "text": "買了這家是你"
    },
    {
      "index": 154,
      "start": 288.62,
      "end": 290.38,
      "text": "看起來好可愛"
    },
    {
      "index": 155,
      "start": 290.38,
      "end": 291.82,
      "text": "面料要好舒服"
    },
    {
      "index": 156,
      "start": 291.82,
      "end": 292.78,
      "text": "結果回來之後"
    },
    {
      "index": 157,
      "start": 292.78,
      "end": 295.02,
      "text": "我在想說直播刷到只要"
    },
    {
      "index": 158,
      "start": 295.02,
      "end": 298.38,
      "text": "100多還是200多一件"
    },
    {
      "index": 159,
      "start": 298.38,
      "end": 299.1,
      "text": "算了"
    },
    {
      "index": 160,
      "start": 299.1,
      "end": 301.98,
      "text": "人家送了一個超可愛的水金球"
    },
    {
      "index": 161,
      "start": 301.98,
      "end": 303.74,
      "text": "這個情緒價值還是給到了"
    },
    {
      "index": 162,
      "start": 303.74,
      "end": 305.82,
      "text": "現在做地鐵去吃一家網工"
    },
    {
      "index": 163,
      "start": 305.82,
      "end": 308.06,
      "text": "並且因為我運車實在是"
    },
    {
      "index": 164,
      "start": 308.06,
      "end": 309.9,
      "text": "太難收了"
    },
    {
      "index": 165,
      "start": 309.9,
      "end": 310.78,
      "text": "這個地鐵站"
    },
    {
      "index": 166,
      "start": 310.78,
      "end": 312.7,
      "text": "我往我走下去好恐怖"
    },
    {
      "index": 167,
      "start": 312.7,
      "end": 314.38,
      "text": "他一個人都沒有"
    },
    {
      "index": 168,
      "start": 314.38,
      "end": 315.42,
      "text": "如果不是地牌妹妹"
    },
    {
      "index": 169,
      "start": 315.42,
      "end": 316.38,
      "text": "他的朋友可以跟我"
    },
    {
      "index": 170,
      "start": 316.38,
      "end": 318.06,
      "text": "我一定不敢走下去了"
    },
    {
      "index": 171,
      "start": 318.06,
      "end": 319.18,
      "text": "這個網工"
    },
    {
      "index": 172,
      "start": 319.18,
      "end": 320.38,
      "text": "並期令來了"
    },
    {
      "index": 173,
      "start": 320.38,
      "end": 322.38,
      "text": "我店的雙瓶"
    },
    {
      "index": 174,
      "start": 322.38,
      "end": 325.34,
      "text": "這個是交討的"
    },
    {
      "index": 175,
      "start": 325.34,
      "end": 326.7,
      "text": "留一點太甜了"
    },
    {
      "index": 176,
      "start": 326.7,
      "end": 328.38,
      "text": "但是並且你就是吃甜甜了吧"
    },
    {
      "index": 177,
      "start": 328.38,
      "end": 330.46,
      "text": "走到這個店真的地方了"
    },
    {
      "index": 178,
      "start": 330.46,
      "end": 331.58,
      "text": "還要馬來呀"
    },
    {
      "index": 179,
      "start": 331.58,
      "end": 334.14,
      "text": "全是人超極多的人"
    },
    {
      "index": 180,
      "start": 334.14,
      "end": 335.34,
      "text": "我用食拍了幾張照片"
    },
    {
      "index": 181,
      "start": 335.34,
      "end": 335.98,
      "text": "讓他們都懂了"
    },
    {
      "index": 182,
      "start": 335.98,
      "end": 337.02,
      "text": "實在是人太多了"
    },
    {
      "index": 183,
      "start": 337.02,
      "end": 338.3,
      "text": "點兩個大好"
    },
    {
      "index": 184,
      "start": 338.3,
      "end": 340.3,
      "text": "去這場之前又帶朋友"
    },
    {
      "index": 185,
      "start": 340.3,
      "end": 342.86,
      "text": "就吃了一個辣辣的又子辣面"
    },
    {
      "index": 186,
      "start": 342.86,
      "end": 343.58,
      "text": "嗯"
    },
    {
      "index": 187,
      "start": 343.58,
      "end": 344.62,
      "text": "都很滿意"
    },
    {
      "index": 188,
      "start": 344.62,
      "end": 347.26,
      "text": "然後就去機場回家囉"
    }
  ]
}