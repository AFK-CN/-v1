    {
      "index": 34,
      "start": 72.88,
      "end": 75.2,
      "text": "接下來一共是22個禮盒"
    },
    {
      "index": 35,
      "start": 75.2,
      "end": 76.96,
      "text": "我就直接給大家看一看"
    },
    {
      "index": 36,
      "start": 76.96,
      "end": 78.88,
      "text": "首先是一個戰演的"
