{"profile_id": "xiaosenlin_xiaoshijie", "platform": "xhs", "content_type": "image_text", "account_name": "小森林的小世界", "source_id": "67c95f12000000002a00da9d", "source_url": "https://www.xiaohongshu.com/explore/67c95f12000000002a00da9d?xsec_token=ABKxeHgWT5zegIHehiVTlqGB0_kQ-FHnB0LxcR94dXDWU=&xsec_source=pc_search", "published_at": "", "title": "油痘敏肌爱用面膜分享", "topic_summary": "每次听到大家跟我说，美容院的人说她外油内干是因为皮肤肌底缺水需要补水、美容院的人说她皮肤油长痘痘是因为水油不平衡需要补水，我就特别着急。因为真的会有姐妹相信这些制造焦虑的话术而“病急乱投医”买一堆补水面膜回家，结果皮肤没有变好反正越来越敏。 皮肤敏的时候，尤其不能乱敷面膜。而每天敷面膜对皮肤也没有什么好处，反而会容易造", "topic_tags": ["油痘肌护肤", "我的护肤年度总结", "面膜推荐", "油痘肌面膜", "油皮", "油痘敏肌"], "asset_learning_scope": {"title": true, "body_or_caption": true, "topic_tags": true, "comment_text": false}, "text_sources": ["metadata"], "metrics": {"likes": 1152, "collects": 596, "comments": 59, "shares": 37}, "heat_score": 625.25, "material_status": "metadata_only", "is_deep_learning_target": false, "deep_learning_status": "not_selected", "confirmed_learned": false, "primary_direction": "护肤功效", "secondary_directions": ["好物测评"], "classification_scores": {"护肤功效": 55, "毛孔清洁": 0, "刷酸焕肤": 0, "抗老修护": 0, "美容项目平替": 0, "好物测评": 49, "变美经验": 0, "生活方式": 0, "账号运营": 0}, "classification_confidence": 0.1091, "needs_review": true, "review_reason": "low_score_margin", "review_note": "", "rough_scan_value": "low", "candidate_deep_learning": false, "defer_reason": "相关度或热度未进入本轮候补范围"}
{"profile_id": "xiaosenlin_xiaoshijie", "platform": "xhs", "content_type": "image_text", "account_name": "小森林的小世界", "source_id": "68df50330000000004014436", "source_url": "https://www.xiaohongshu.com/explore/68df50330000000004014436?xsec_token=ABB9lohRIF6oTgam616F_AP0exs7epUTA0PX5m7bEKWpQ=&xsec_source=pc_search", "published_at": "", "title": "🍠1年1度油痘肌爱用1.0  抢先播报", "topic_summary": "hello大家，2025年度爱用第一篇来了。（好早…[暗中观察R]） 胶原炮： 第一个放它，用了2个月直接冲到爱用榜一。真的能让我变丰盈！皮肤感觉嫩很多！30岁我最大的痛点是凹陷，面部明显不如20出头那会流畅，皮肤看着不水灵、干瘪。这是我目前用到的补胶原方面坠有效果的产品（比我啃鸡爪猪蹄快多了！）录视频拍照的时候感觉脸", "topic_tags": ["1年1度爱用大公开", "小红书1年1度购物狂欢", "护肤好物", "油痘肌护肤", "我的双十一人脉", "我的双11人脉"], "asset_learning_scope": {"title": true, "body_or_caption": true, "topic_tags": true, "comment_text": false}, "text_sources": ["metadata"], "metrics": {"likes": 715, "collects": 330, "comments": 74, "shares": 20}, "heat_score": 373.4, "material_status": "metadata_only", "is_deep_learning_target": false, "deep_learning_status": "not_selected", "confirmed_learned": false, "primary_direction": "护肤功效", "secondary_directions": ["好物测评", "毛孔清洁", "抗老修护", "账号运营", "美容项目平替", "变美经验"], "classification_scores": {"护肤功效": 57, "毛孔清洁": 14, "刷酸焕肤": 0, "抗老修护": 13, "美容项目平替": 7, "好物测评": 57, "变美经验": 2, "生活方式": 0, "账号运营": 13}, "classification_confidence": 0.0, "needs_review": true, "review_reason": "top_score_tied", "review_note": "", "rough_scan_value": "low", "candidate_deep_learning": false, "defer_reason": "相关度或热度未进入本轮候补范围"}
