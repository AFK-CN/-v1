{"profile_id": "xiaosenlin_xiaoshijie", "platform": "xhs", "content_type": "image_text", "account_name": "小森林的小世界", "source_id": "63f095db0000000013036d96", "source_url": "https://www.xiaohongshu.com/explore/63f095db0000000013036d96?xsec_token=ABIkZUUftDVfTnNRU5AdEvZDhLQnMu7invuVgvKuaHV3M=&xsec_source=pc_search", "published_at": "", "title": "油痘肌1-2月爱用，面膜、粉霜、防晒、爽肤水", "topic_summary": "虽迟但到！油痘肌、混油皮，分享一些能看到效果并且不闷痘的好用物～自用🈚️广，爱买不买🤣 1⃣️这个面膜意外的发现它更像嫩肤面膜，因为敷它那几天皮肤真感觉变嫩了，上妆非常服帖以前还要用海绵蛋现在用手就能抹匀，也挺补水的，比很多贵妇面膜效果更直接！（很多贵妇面膜用的是一个心理安慰而已） 2⃣️MD防晒：我叫它“空气防晒”，", "topic_tags": ["油痘肌护肤", "好用物分享", "我的平价好物", "防晒分享", "好皮肤养成记"], "asset_learning_scope": {"title": true, "body_or_caption": true, "topic_tags": true, "comment_text": false}, "text_sources": ["metadata"], "metrics": {"likes": 721, "collects": 440, "comments": 155, "shares": 19}, "heat_score": 432.65, "material_status": "metadata_only", "is_deep_learning_target": false, "deep_learning_status": "not_selected", "confirmed_learned": false, "primary_direction": "护肤功效", "secondary_directions": ["好物测评", "毛孔清洁", "抗老修护", "美容项目平替", "生活方式"], "classification_scores": {"护肤功效": 72, "毛孔清洁": 11, "刷酸焕肤": 0, "抗老修护": 4, "美容项目平替": 4, "好物测评": 70, "变美经验": 0, "生活方式": 3, "账号运营": 0}, "classification_confidence": 0.0278, "needs_review": true, "review_reason": "low_score_margin", "review_note": "", "rough_scan_value": "low", "candidate_deep_learning": false, "defer_reason": "相关度或热度未进入本轮候补范围"}
