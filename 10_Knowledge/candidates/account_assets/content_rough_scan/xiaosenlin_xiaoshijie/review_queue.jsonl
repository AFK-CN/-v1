{"profile_id": "xiaosenlin_xiaoshijie", "platform": "xhs", "content_type": "image_text", "account_name": "小森林的小世界", "source_id": "65ba1bed000000000702875c", "source_url": "https://www.xiaohongshu.com/explore/65ba1bed000000000702875c?xsec_token=ABjmdFjy9UP_vlmDuVbuYvQYKGXuGJCE8i1l0DwuzoUis=&xsec_source=pc_search", "published_at": "", "title": "这真的是一晚上的效果吗？我直接爱了！", "topic_summary": "前段时间高强度直播+姨妈突袭 我整个人直接累垮了 回到家卸完妆后那个皮肤干瘪又粗糙 摸起来还不平整 于是我尝试了一套密集修护护理 先用去角质水带走老废角质 再用YSL藏金面霜密集修护 隔天起来的皮肤状态真的很满意 饱满又Q弹摸起来还嫩嫩的~ 迫不及待分享给各位姐妹 #贵妇面霜[话题]# #油皮护肤[话题]# #YSL藏", "topic_tags": ["贵妇面霜", "油皮护肤", "YSL藏金面霜", "抗老", "抗老好物"], "asset_learning_scope": {"title": true, "body_or_caption": true, "topic_tags": true, "comment_text": false}, "text_sources": ["metadata"], "metrics": {"likes": 1680, "collects": 474, "comments": 129, "shares": 14}, "heat_score": 732.3, "material_status": "metadata_only", "is_deep_learning_target": false, "deep_learning_status": "not_selected", "confirmed_learned": false, "primary_direction": "抗老修护", "secondary_directions": ["护肤功效", "好物测评", "毛孔清洁", "刷酸焕肤"], "classification_scores": {"护肤功效": 29, "毛孔清洁": 2, "刷酸焕肤": 2, "抗老修护": 31, "美容项目平替": 0, "好物测评": 24, "变美经验": 0, "生活方式": 0, "账号运营": 0}, "classification_confidence": 0.0645, "needs_review": true, "review_reason": "low_score_margin", "review_note": "", "rough_scan_value": "medium", "candidate_deep_learning": true, "defer_reason": "本轮深学范围外，保留为方向候补"}
