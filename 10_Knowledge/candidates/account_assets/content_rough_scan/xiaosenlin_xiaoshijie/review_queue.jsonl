{"profile_id": "xiaosenlin_xiaoshijie", "platform": "xhs", "content_type": "image_text", "account_name": "小森林的小世界", "source_id": "65a652690000000029030c8d", "source_url": "https://www.xiaohongshu.com/explore/65a652690000000029030c8d?xsec_token=AB-97Ekh6qVsSgdrunTwts64BkbV7mdadJud4c6DpqhFM=&xsec_source=pc_search", "published_at": "", "title": "总算把油痘肌k老缩毛孔搞明白了", "topic_summary": "这下真搞懂了！ 原来缩毛孔和K老并不需要一味地追求猛， 也有更温和高效的选择 宝拉珍选这支20%烟酰胺精华我用下来真的惊艳 它是高浓度➕高纯度烟酰胺 修护、控油、K老一步到位 让皮肤状态肉眼可见地变好～ 强力推荐给想要嫩肤细毛孔的姐妹！ #烟酰胺精华[话题]# #早P晚R[话题]# #油敏肌抗老[话题]# #宝拉童颜瓶", "topic_tags": ["烟酰胺精华", "早P晚R", "油敏肌抗老", "宝拉童颜瓶", "油痘肌护肤"], "asset_learning_scope": {"title": true, "body_or_caption": true, "topic_tags": true, "comment_text": false}, "text_sources": ["metadata"], "metrics": {"likes": 620, "collects": 297, "comments": 189, "shares": 16}, "heat_score": 340.95, "material_status": "metadata_only", "is_deep_learning_target": false, "deep_learning_status": "not_selected", "confirmed_learned": false, "primary_direction": "毛孔清洁", "secondary_directions": ["护肤功效", "抗老修护", "好物测评"], "classification_scores": {"护肤功效": 19, "毛孔清洁": 21, "刷酸焕肤": 0, "抗老修护": 15, "美容项目平替": 0, "好物测评": 5, "变美经验": 0, "生活方式": 0, "账号运营": 0}, "classification_confidence": 0.0952, "needs_review": true, "review_reason": "low_score_margin", "review_note": "", "rough_scan_value": "low", "candidate_deep_learning": false, "defer_reason": "相关度或热度未进入本轮候补范围"}
{"profile_id": "xiaosenlin_xiaoshijie", "platform": "xhs", "content_type": "image_text", "account_name": "小森林的小世界", "source_id": "676501d40000000009017e2e", "source_url": "https://www.xiaohongshu.com/explore/676501d40000000009017e2e?xsec_token=ABVhfw1dudZhubDhr0Wz6deyY-Ynx0OhLTUYyBNYhXTYQ=&xsec_source=pc_search", "published_at": "", "title": "家庭版毛孔深层清洁后续护肤分享", "topic_summary": "我11年油痘肌，毛孔粗大、草莓鼻、脸上很多痘和闭口。但自从在家一周做一次家庭版毛孔清洁之后皮肤就像开挂一样，变得又细腻又通透！ 油痘肌的问题根源基本上都是来自出油量大毛孔堵塞。毛孔深层清洁的原理就是在油脂还未形成闭口造成大面积堵塞时，就先清出来。里面有两个清洁步骤，先打开皮肤通道，再清理毛孔里的深层油脂。毛孔干净，自然", "topic_tags": ["油痘肌", "如何拯救痘痘肌", "我的护肤年度总结", "年度护肤报告", "小森林家庭版毛孔深层清洁"], "asset_learning_scope": {"title": true, "body_or_caption": true, "topic_tags": true, "comment_text": false}, "text_sources": ["metadata"], "metrics": {"likes": 1766, "collects": 1311, "comments": 86, "shares": 47}, "heat_score": 1135.4, "material_status": "metadata_only", "is_deep_learning_target": false, "deep_learning_status": "not_selected", "confirmed_learned": false, "primary_direction": "毛孔清洁", "secondary_directions": ["护肤功效", "美容项目平替", "好物测评", "抗老修护", "生活方式"], "classification_scores": {"护肤功效": 127, "毛孔清洁": 152, "刷酸焕肤": 0, "抗老修护": 19, "美容项目平替": 35, "好物测评": 27, "变美经验": 0, "生活方式": 2, "账号运营": 0}, "classification_confidence": 0.1645, "needs_review": true, "review_reason": "low_score_margin", "review_note": "", "rough_scan_value": "medium", "candidate_deep_learning": true, "defer_reason": "本轮深学范围外，保留为方向候补"}
