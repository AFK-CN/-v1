{"schema_version": "2.1", "learning_method_revision": "xiaosenlin_unified_deep_relearn_v3_0", "batch_id": "batch_03", "source_id": "69eb26ec000000002301df3f", "title": "3个！油皮体面过夏天的神物", "content_type": "video", "nas_item_root": "/Volumes/AFK/zhishikushuju/xhs/accounts/xhs_5a201295e8ac2b0dbae9063a/xhs_69eb26ec000000002301df3f", "topic_family": "毛孔与清洁", "mechanism_key": "step_sequence", "commercial_axis": "产品/商业决策内容", "evidence_status": "complete", "evidence_source_chars": 1459, "evidence_unit_count": 43, "original_evidence_unit_count": 43, "visual_review_unit_count": 0, "timeline_segment_count": 107, "transcript_available": true, "evidence_basis": "video_transcript_and_frames", "traceable_anchors": ["作为13年的大油皮我真的太明白咱们油皮想要在夏天保持一个白镜体面有多难", "它升级之后的这个敷感也是更适合我们油皮了 是这种很轻薄的乳液质地", "一步就给我搞定了非常的惊艰 我的脸上也非常的清爽 化妆的时候就拿它当妆前用", "被我用的盖子都找到了 它很适合我们这种爱命的油皮 换起明明或者是夏天被晒得红红热热", "我还很喜欢用它搭配那个免片去做水抹 出完之后整个皮肤真的就是又嫩又水灵", "舒通毛控 所以我们如果是长期的坚持去用这一只 还可以让我们的皮肤越来越细腻", "就变黄变黑 看起来非常非常险脏 但是我发现我现在早上如果有用了它"], "retained_quotes": ["舒通毛控 所以我们如果是长期的坚持去用这一只 还可以让我们的皮肤越来越细腻", "就变黄变黑 看起来非常非常险脏 但是我发现我现在早上如果有用了它"], "source_paths": {"text": "/Volumes/AFK/zhishikushuju/xhs/accounts/xhs_5a201295e8ac2b0dbae9063a/xhs_69eb26ec000000002301df3f/video/transcript.txt", "source": "/Volumes/AFK/zhishikushuju/xhs/accounts/xhs_5a201295e8ac2b0dbae9063a/xhs_69eb26ec000000002301df3f/source.json", "media": "/Volumes/AFK/zhishikushuju/xhs/accounts/xhs_5a201295e8ac2b0dbae9063a/xhs_69eb26ec000000002301df3f/video/source.mp4", "visual": "/Volumes/AFK/zhishikushuju/xhs/accounts/xhs_5a201295e8ac2b0dbae9063a/xhs_69eb26ec000000002301df3f/video/frames", "visual_override": "/Users/lao_wu/codexAI/知识库/10_Knowledge/candidates/account_learning_workflows/xiaosenlin-xiaoshijie-v2-full/VISUAL_EVIDENCE_OVERRIDES.json"}, "source_text_hash": "0929b38ce6f5dc0a6ec034eff899184061c0aaa7b391bccb199ff77654e52019", "card_hash": "a2c394c07ed5194989f33e3d1ab35224ff62f7d6983808c1148a9585264eff81", "callable": false, "status": "candidate_learned"}
