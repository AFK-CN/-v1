{
  "language": "zh",
  "duration": 153.3691875,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.32,
      "text": "Hello 我是小森林"
    },
    {
      "index": 2,
      "start": 1.32,
      "end": 3.36,
      "text": "大家应该都知道我是一个游斗机博主"
    },
    {
      "index": 3,
      "start": 3.36,
      "end": 4.12,
      "text": "但你们不知道"
    },
    {
      "index": 4,
      "start": 4.12,
      "end": 5.72,
      "text": "我以前还是一个游斗头"
    },
    {
      "index": 5,
      "start": 5.72,
      "end": 7.04,
      "text": "大概高中开始"
    },
    {
      "index": 6,
      "start": 7.04,
      "end": 8.48,
      "text": "头养 头血气"
    },
    {
      "index": 7,
      "start": 8.48,
      "end": 10.12,
      "text": "都一直困扰着我"
    },
    {
      "index": 8,
      "start": 10.12,
      "end": 13.04,
      "text": "后来我又在深圳这种湿度爆表的城市工作"
    },
    {
      "index": 9,
      "start": 13.04,
      "end": 14.36,
      "text": "一年有六七个月"
    },
    {
      "index": 10,
      "start": 14.36,
      "end": 15.96,
      "text": "我的头皮都在蒸丧哪"
    },
    {
      "index": 11,
      "start": 15.96,
      "end": 17.24,
      "text": "就很容易焖成嘴型"
    },
    {
      "index": 12,
      "start": 17.24,
      "end": 18.68,
      "text": "但现在经过我的调理"
    },
    {
      "index": 13,
      "start": 18.68,
      "end": 20.32,
      "text": "头皮已经可以维持在一个"
    },
    {
      "index": 14,
      "start": 20.32,
      "end": 22.24,
      "text": "比较健康 甘爽的状态了"
    },
    {
      "index": 15,
      "start": 22.24,
      "end": 25.08,
      "text": "现在我就马上把我的经验分享给大家"
    },
    {
      "index": 16,
      "start": 25.08,
      "end": 28.32,
      "text": "首先生活上一定要避免用太烫的水洗头"
    },
    {
      "index": 17,
      "start": 28.32,
      "end": 31.0,
      "text": "日常尽量少熬夜 少辛辣饮食"
    },
    {
      "index": 18,
      "start": 31.0,
      "end": 32.32,
      "text": "这个大家应该都知道"
    },
    {
      "index": 19,
      "start": 32.32,
      "end": 34.32,
      "text": "还有一点就是少闹头"
    },
    {
      "index": 20,
      "start": 34.32,
      "end": 37.28,
      "text": "咱们上课爱闹头的那一波人现在又长大了"
    },
    {
      "index": 21,
      "start": 37.28,
      "end": 39.36,
      "text": "是不是工作压力大了也爱闹头呢"
    },
    {
      "index": 22,
      "start": 39.36,
      "end": 40.0,
      "text": "我自己就是"
    },
    {
      "index": 23,
      "start": 40.0,
      "end": 41.2,
      "text": "所以我要控制住我的手"
    },
    {
      "index": 24,
      "start": 41.2,
      "end": 43.44,
      "text": "那如果头皮现在已经出现了"
    },
    {
      "index": 25,
      "start": 43.44,
      "end": 44.8,
      "text": "非常不适的症状了"
    },
    {
      "index": 26,
      "start": 44.8,
      "end": 46.08,
      "text": "那马上咱们就去看"
    },
    {
      "index": 27,
      "start": 46.76,
      "end": 48.28,
      "text": "确诊一下是不是只一般"
    },
    {
      "index": 28,
      "start": 48.28,
      "end": 49.76,
      "text": "它会给你开一些洗几网"
    },
    {
      "index": 29,
      "start": 49.76,
      "end": 51.24,
      "text": "但是这个是不能长期使用的"
    },
    {
      "index": 30,
      "start": 51.24,
      "end": 52.28,
      "text": "可能会有些依赖性"
    },
    {
      "index": 31,
      "start": 52.28,
      "end": 54.4,
      "text": "接下来后期定期维护头皮"
    },
    {
      "index": 32,
      "start": 54.4,
      "end": 56.04,
      "text": "健康是非常重要的"
    },
    {
      "index": 33,
      "start": 56.04,
      "end": 58.92,
      "text": "这个毛病你得过一次那种难受和痛苦"
    },
    {
      "index": 34,
      "start": 58.92,
      "end": 61.4,
      "text": "就会让你非常注重头皮的维护"
    },
    {
      "index": 35,
      "start": 61.4,
      "end": 62.76,
      "text": "那调理头皮健康"
    },
    {
      "index": 36,
      "start": 62.76,
      "end": 65.44,
      "text": "跟咱们有斗鸡护肤的远利其实是一样的"
    },
    {
      "index": 37,
      "start": 65.44,
      "end": 66.84,
      "text": "那我们的解决思路就是"
    },
    {
      "index": 38,
      "start": 66.84,
      "end": 67.92,
      "text": "先消"
    },
    {
      "index": 39,
      "start": 67.92,
      "end": 69.44,
      "text": "再控油再修护"
    },
    {
      "index": 40,
      "start": 69.44,
      "end": 71.96,
      "text": "头里有一些姐妹因为头皮过肝"
    },
    {
      "index": 41,
      "start": 71.96,
      "end": 74.36,
      "text": "而导致的头穴就不能用这个方法"
    },
    {
      "index": 42,
      "start": 74.36,
      "end": 76.4,
      "text": "皮肤过肝导致的脱皮需要的是"
    },
    {
      "index": 43,
      "start": 76.4,
      "end": 77.56,
      "text": "滋养和修护"
    },
    {
      "index": 44,
      "start": 77.56,
      "end": 78.68,
      "text": "就和肝皮护肤一样"
    },
    {
      "index": 45,
      "start": 78.68,
      "end": 80.36,
      "text": "像我日常为了预防之一"
    },
    {
      "index": 46,
      "start": 80.36,
      "end": 83.0,
      "text": "我的浴室里面会常被一瓶有二流化溪"
    },
    {
      "index": 47,
      "start": 83.0,
      "end": 84.04,
      "text": "这个成分的洗发水"
    },
    {
      "index": 48,
      "start": 84.04,
      "end": 87.12,
      "text": "这个成分是很多去泄洗发水里面有的成分"
    },
    {
      "index": 49,
      "start": 87.12,
      "end": 88.8,
      "text": "它可以抑制马拉色增长"
    },
    {
      "index": 50,
      "start": 88.8,
      "end": 90.84,
      "text": "还可以调节头皮油脂的分泌"
    },
    {
      "index": 51,
      "start": 90.84,
      "end": 92.16,
      "text": "包括很多护肤频率里面"
    },
    {
      "index": 52,
      "start": 92.16,
      "end": 93.08,
      "text": "其实都有这个成分"
    },
    {
      "index": 53,
      "start": 93.08,
      "end": 95.44,
      "text": "那大家只要找同款有这个成分的洗发水"
    },
    {
      "index": 54,
      "start": 95.44,
      "end": 96.08,
      "text": "就可以了"
    },
    {
      "index": 55,
      "start": 96.08,
      "end": 98.2,
      "text": "我自己用的是微姿的这个"
    },
    {
      "index": 56,
      "start": 98.2,
      "end": 99.36,
      "text": "这是我的第四瓶了"
    },
    {
      "index": 57,
      "start": 99.36,
      "end": 101.96,
      "text": "因为一到夏天我用它的频率就非常的"
    },
    {
      "index": 58,
      "start": 101.96,
      "end": 103.92,
      "text": "高深圳又常年在夏天"
    },
    {
      "index": 59,
      "start": 103.92,
      "end": 105.36,
      "text": "我喜欢用这瓶是因为它里面"
    },
    {
      "index": 60,
      "start": 105.36,
      "end": 107.52,
      "text": "还附配了水洋酸和神经鲜安"
    },
    {
      "index": 61,
      "start": 107.52,
      "end": 109.48,
      "text": "就洗完之后头发又蓬松"
    },
    {
      "index": 62,
      "start": 109.48,
      "end": 110.68,
      "text": "但又不会很干燥"
    },
    {
      "index": 63,
      "start": 110.68,
      "end": 112.2,
      "text": "出油又明显减少了"
    },
    {
      "index": 64,
      "start": 112.24,
      "end": 114.24,
      "text": "那像这种洗发水在初期头皮"
    },
    {
      "index": 65,
      "start": 114.24,
      "end": 115.12,
      "text": "感觉有问题的时候"
    },
    {
      "index": 66,
      "start": 115.12,
      "end": 116.44,
      "text": "可以使用频率稍微高一点"
    },
    {
      "index": 67,
      "start": 116.44,
      "end": 117.88,
      "text": "一周可以用个三四次"
    },
    {
      "index": 68,
      "start": 117.88,
      "end": 119.76,
      "text": "后面当头皮可以长时间稳定"
    },
    {
      "index": 69,
      "start": 119.76,
      "end": 121.84,
      "text": "在一个相对比较健康的环境的时候"
    },
    {
      "index": 70,
      "start": 121.84,
      "end": 123.04,
      "text": "就不需要用那么轻快了"
    },
    {
      "index": 71,
      "start": 123.04,
      "end": 125.24,
      "text": "一周用一到两次巩固一下就可以了"
    },
    {
      "index": 72,
      "start": 125.24,
      "end": 126.2,
      "text": "哦 还有一个"
    },
    {
      "index": 73,
      "start": 126.2,
      "end": 127.68,
      "text": "我会在洗头之前"
    },
    {
      "index": 74,
      "start": 127.68,
      "end": 129.08,
      "text": "用这种苦练紫油"
    },
    {
      "index": 75,
      "start": 129.08,
      "end": 130.56,
      "text": "滴在头皮上去按摩"
    },
    {
      "index": 76,
      "start": 130.56,
      "end": 132.12,
      "text": "油柔油清洁头皮"
    },
    {
      "index": 77,
      "start": 132.12,
      "end": 134.04,
      "text": "苦练紫油对于这个"
    },
    {
      "index": 78,
      "start": 134.04,
      "end": 134.84,
      "text": "是蛮好的"
    },
    {
      "index": 79,
      "start": 134.84,
      "end": 136.2,
      "text": "这个我是跟张晓辉学的"
    },
    {
      "index": 80,
      "start": 136.2,
      "end": 138.24,
      "text": "对我这种油豆头效果也还蛮好的"
    },
    {
      "index": 81,
      "start": 138.24,
      "end": 139.6,
      "text": "最后最后还有一个"
    },
    {
      "index": 82,
      "start": 139.6,
      "end": 141.48,
      "text": "很容易被忽视的注意事项"
    },
    {
      "index": 83,
      "start": 141.48,
      "end": 144.04,
      "text": "就是不要和别人混用书子"
    },
    {
      "index": 84,
      "start": 144.04,
      "end": 146.6,
      "text": "尤其是头油爱掉发的家人们"
    },
    {
      "index": 85,
      "start": 146.6,
      "end": 148.48,
      "text": "因为马拉斯会传染的"
    },
    {
      "index": 86,
      "start": 148.48,
      "end": 150.48,
      "text": "然后定期要给自己的书子消消毒"
    },
    {
      "index": 87,
      "start": 150.48,
      "end": 151.8,
      "text": "那希望大家都有一个"
    },
    {
      "index": 88,
      "start": 151.8,
      "end": 153.32,
      "text": "健康干涨的头皮"
    }
  ]
}