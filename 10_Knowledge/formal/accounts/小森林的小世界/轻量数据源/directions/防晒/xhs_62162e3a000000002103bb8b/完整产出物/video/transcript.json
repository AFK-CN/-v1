{
  "language": "zh",
  "duration": 96.1088125,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.08,
      "text": "Hello 大家好"
    },
    {
      "index": 2,
      "start": 1.08,
      "end": 2.24,
      "text": "我是小森林"
    },
    {
      "index": 3,
      "start": 2.24,
      "end": 5.68,
      "text": "今天想给你们推荐一款我非常喜欢的防晒"
    },
    {
      "index": 4,
      "start": 5.68,
      "end": 8.04,
      "text": "我已经用它用了三年多了"
    },
    {
      "index": 5,
      "start": 8.04,
      "end": 9.76,
      "text": "就是这个防晒"
    },
    {
      "index": 6,
      "start": 9.76,
      "end": 12.92,
      "text": "它是这种涂感液的质地"
    },
    {
      "index": 7,
      "start": 12.92,
      "end": 14.64,
      "text": "非常非常的清爽"
    },
    {
      "index": 8,
      "start": 14.64,
      "end": 15.88,
      "text": "一点都不油腻"
    },
    {
      "index": 9,
      "start": 15.88,
      "end": 16.96,
      "text": "上连也不会错"
    },
    {
      "index": 10,
      "start": 16.96,
      "end": 19.2,
      "text": "你后续跟装也非常的好"
    },
    {
      "index": 11,
      "start": 19.2,
      "end": 20.72,
      "text": "有四个档位"
    },
    {
      "index": 12,
      "start": 20.72,
      "end": 22.12,
      "text": "一档是最清爽"
    },
    {
      "index": 13,
      "start": 22.12,
      "end": 23.76,
      "text": "四档是最滋润"
    },
    {
      "index": 14,
      "start": 23.76,
      "end": 25.36,
      "text": "我这个是二档的"
    },
    {
      "index": 15,
      "start": 25.36,
      "end": 26.6,
      "text": "我一般就是买一二档"
    },
    {
      "index": 16,
      "start": 26.6,
      "end": 27.92,
      "text": "我建议一混有皮的女生"
    },
    {
      "index": 17,
      "start": 27.92,
      "end": 29.8,
      "text": "一般买一二档就OK了"
    },
    {
      "index": 18,
      "start": 29.84,
      "end": 32.64,
      "text": "它还有一点点的控油效果"
    },
    {
      "index": 19,
      "start": 32.64,
      "end": 33.72,
      "text": "我最喜欢它一点"
    },
    {
      "index": 20,
      "start": 33.72,
      "end": 35.92,
      "text": "就是它的提料效果非常的好"
    },
    {
      "index": 21,
      "start": 35.92,
      "end": 38.44,
      "text": "有时候我们只是想下楼买个东西"
    },
    {
      "index": 22,
      "start": 38.44,
      "end": 40.44,
      "text": "或者是去健身房健身"
    },
    {
      "index": 23,
      "start": 40.44,
      "end": 42.28,
      "text": "但是这时候不想化妆"
    },
    {
      "index": 24,
      "start": 42.28,
      "end": 45.16,
      "text": "可是又想要自己的气色能够好一点"
    },
    {
      "index": 25,
      "start": 45.16,
      "end": 47.04,
      "text": "就会选择用这支防晒了"
    },
    {
      "index": 26,
      "start": 47.04,
      "end": 48.64,
      "text": "它上脸是会让我们的脸"
    },
    {
      "index": 27,
      "start": 48.64,
      "end": 50.04,
      "text": "提亮一个色号的"
    },
    {
      "index": 28,
      "start": 50.04,
      "end": 52.44,
      "text": "脸看起来会是白白静静的"
    },
    {
      "index": 29,
      "start": 52.44,
      "end": 55.36,
      "text": "现在它是会防止脸部暗沉的"
    },
    {
      "index": 30,
      "start": 55.36,
      "end": 56.68,
      "text": "就是粉底都会暗沉"
    },
    {
      "index": 31,
      "start": 56.68,
      "end": 58.04,
      "text": "可是它不会暗沉"
    },
    {
      "index": 32,
      "start": 58.04,
      "end": 59.28,
      "text": "你早上除了它"
    },
    {
      "index": 33,
      "start": 59.28,
      "end": 61.4,
      "text": "晚上回到家你去照镜子"
    },
    {
      "index": 34,
      "start": 61.4,
      "end": 63.2,
      "text": "脸上还是白白静静的"
    },
    {
      "index": 35,
      "start": 63.2,
      "end": 66.64,
      "text": "我也很推荐一些上班族用这一支防晒"
    },
    {
      "index": 36,
      "start": 66.64,
      "end": 69.8,
      "text": "像平时早上上班通勤比较感"
    },
    {
      "index": 37,
      "start": 69.8,
      "end": 71.08,
      "text": "没有时间化妆"
    },
    {
      "index": 38,
      "start": 71.08,
      "end": 72.88,
      "text": "你皮肤好你就擦一个这个"
    },
    {
      "index": 39,
      "start": 72.88,
      "end": 74.4,
      "text": "然后再擦一个口红"
    },
    {
      "index": 40,
      "start": 74.4,
      "end": 75.4,
      "text": "就OK了"
    },
    {
      "index": 41,
      "start": 75.4,
      "end": 77.08,
      "text": "气色就会显得很好"
    },
    {
      "index": 42,
      "start": 77.08,
      "end": 79.08,
      "text": "而且它是没有粉感的"
    },
    {
      "index": 43,
      "start": 79.08,
      "end": 80.64,
      "text": "那你同事就会觉得"
    },
    {
      "index": 44,
      "start": 80.64,
      "end": 83.28,
      "text": "你的皮肤是不是素颜就这么好"
    },
    {
      "index": 45,
      "start": 83.28,
      "end": 84.76,
      "text": "就是这么白净"
    },
    {
      "index": 46,
      "start": 84.84,
      "end": 88.64,
      "text": "很心机的一款为素颜神器"
    },
    {
      "index": 47,
      "start": 88.64,
      "end": 89.96,
      "text": "天天给你们用"
    }
  ]
}