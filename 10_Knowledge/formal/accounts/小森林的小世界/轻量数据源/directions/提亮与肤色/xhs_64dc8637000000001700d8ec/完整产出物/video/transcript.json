{
  "language": "zh",
  "duration": 157.038,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.86,
      "text": "先给你们看一下我之前的样子"
    },
    {
      "index": 2,
      "start": 1.86,
      "end": 3.9,
      "text": "跟现在完全是派对我两人"
    },
    {
      "index": 3,
      "start": 3.9,
      "end": 6.7,
      "text": "以前的素颜看起来就是那种土黑土黑的"
    },
    {
      "index": 4,
      "start": 6.7,
      "end": 7.74,
      "text": "但其实不是黑"
    },
    {
      "index": 5,
      "start": 7.74,
      "end": 9.34,
      "text": "是辣黄 暗淡不光"
    },
    {
      "index": 6,
      "start": 9.34,
      "end": 12.3,
      "text": "但我现在的素颜真的是比之前要透亮很多"
    },
    {
      "index": 7,
      "start": 12.3,
      "end": 14.54,
      "text": "以前也用了很多变白的护肤品"
    },
    {
      "index": 8,
      "start": 14.54,
      "end": 15.66,
      "text": "但就是没有用的"
    },
    {
      "index": 9,
      "start": 15.66,
      "end": 18.04,
      "text": "因为我是暗沉式黄气种"
    },
    {
      "index": 10,
      "start": 18.04,
      "end": 19.9,
      "text": "直到我开始用原型VC之后"
    },
    {
      "index": 11,
      "start": 19.9,
      "end": 22.5,
      "text": "很明显的一个感受就是我的毛孔变小了"
    },
    {
      "index": 12,
      "start": 22.5,
      "end": 24.4,
      "text": "然后屏速变得很亮 很有光泽"
    },
    {
      "index": 13,
      "start": 24.4,
      "end": 25.94,
      "text": "就像刚做SPA那样"
    },
    {
      "index": 14,
      "start": 25.94,
      "end": 28.34,
      "text": "我才发现原来之前我用什么都不白"
    },
    {
      "index": 15,
      "start": 28.34,
      "end": 29.98,
      "text": "是因为我靠氧化的做好"
    },
    {
      "index": 16,
      "start": 29.98,
      "end": 31.78,
      "text": "特别是在夏天早上洗完脸"
    },
    {
      "index": 17,
      "start": 31.78,
      "end": 33.18,
      "text": "还感觉白白静静的"
    },
    {
      "index": 18,
      "start": 33.18,
      "end": 35.38,
      "text": "但是一到下午那个脸色看起来"
    },
    {
      "index": 19,
      "start": 35.38,
      "end": 37.64,
      "text": "就像是刚去田地干活回来"
    },
    {
      "index": 20,
      "start": 37.64,
      "end": 38.94,
      "text": "因为夏天温度特别高"
    },
    {
      "index": 21,
      "start": 38.94,
      "end": 40.88,
      "text": "我们油皮的出油量就是更猛了"
    },
    {
      "index": 22,
      "start": 40.88,
      "end": 41.94,
      "text": "油脂氧化之后呢"
    },
    {
      "index": 23,
      "start": 41.94,
      "end": 44.24,
      "text": "我们的脸上就会显得暗沉发黄"
    },
    {
      "index": 24,
      "start": 44.24,
      "end": 46.08,
      "text": "而且毛孔还会显得特别粗淡"
    },
    {
      "index": 25,
      "start": 46.08,
      "end": 47.38,
      "text": "然后紫外线又特别强"
    },
    {
      "index": 26,
      "start": 47.38,
      "end": 49.54,
      "text": "会让我们皮肤产生过量的自由机"
    },
    {
      "index": 27,
      "start": 49.54,
      "end": 50.44,
      "text": "导致衰老"
    },
    {
      "index": 28,
      "start": 50.44,
      "end": 51.58,
      "text": "这就是光老坏"
    },
    {
      "index": 29,
      "start": 51.58,
      "end": 52.38,
      "text": "过不去管它"
    },
    {
      "index": 30,
      "start": 52.38,
      "end": 54.08,
      "text": "我们的皮肤也会随着神间"
    },
    {
      "index": 31,
      "start": 54.08,
      "end": 55.74,
      "text": "像被切开的苹果一样"
    },
    {
      "index": 32,
      "start": 55.74,
      "end": 57.74,
      "text": "慢慢的暗淡没有光泽"
    },
    {
      "index": 33,
      "start": 57.74,
      "end": 59.54,
      "text": "那原型迷思呢就能帮助我们"
    },
    {
      "index": 34,
      "start": 59.54,
      "end": 60.44,
      "text": "对抗自由机"
    },
    {
      "index": 35,
      "start": 60.44,
      "end": 61.64,
      "text": "防止皮肤氧化"
    },
    {
      "index": 36,
      "start": 61.64,
      "end": 63.14,
      "text": "所以我们如果想要精洁"
    },
    {
      "index": 37,
      "start": 63.14,
      "end": 63.94,
      "text": "有效的护肤"
    },
    {
      "index": 38,
      "start": 63.94,
      "end": 65.74,
      "text": "原型迷思是一定要用的"
    },
    {
      "index": 39,
      "start": 65.74,
      "end": 66.64,
      "text": "因为用了它之后呢"
    },
    {
      "index": 40,
      "start": 66.64,
      "end": 68.14,
      "text": "那个收益太多了"
    },
    {
      "index": 41,
      "start": 68.14,
      "end": 69.64,
      "text": "这个欧达雅的针资品"
    },
    {
      "index": 42,
      "start": 69.64,
      "end": 71.64,
      "text": "是我这个夏天非常喜欢用的"
    },
    {
      "index": 43,
      "start": 71.64,
      "end": 74.04,
      "text": "在护肤群评论区都安利过好多次"
    },
    {
      "index": 44,
      "start": 74.04,
      "end": 75.94,
      "text": "因为之前我也分享过一些原型迷思"
    },
    {
      "index": 45,
      "start": 75.94,
      "end": 78.14,
      "text": "但是在夏天真的不想用它们"
    },
    {
      "index": 46,
      "start": 78.14,
      "end": 79.04,
      "text": "太油腻了"
    },
    {
      "index": 47,
      "start": 79.04,
      "end": 80.94,
      "text": "就感觉整个脸都会呼起来了"
    },
    {
      "index": 48,
      "start": 80.94,
      "end": 81.84,
      "text": "这个原型迷思"
    },
    {
      "index": 49,
      "start": 81.84,
      "end": 83.34,
      "text": "我拿到手真的惊呆了"
    },
    {
      "index": 50,
      "start": 83.34,
      "end": 85.34,
      "text": "就两百多块钱完全不输"
    },
    {
      "index": 51,
      "start": 85.34,
      "end": 87.04,
      "text": "我那些上千元的原型迷思"
    },
    {
      "index": 52,
      "start": 87.04,
      "end": 88.44,
      "text": "七八月我都在用它"
    },
    {
      "index": 53,
      "start": 88.44,
      "end": 89.24,
      "text": "很舒服"
    },
    {
      "index": 54,
      "start": 89.24,
      "end": 90.64,
      "text": "我上脸吸收得很快"
    },
    {
      "index": 55,
      "start": 90.64,
      "end": 91.54,
      "text": "而且吸收完之后"
    },
    {
      "index": 56,
      "start": 91.54,
      "end": 92.64,
      "text": "我的脸是干爽的"
    },
    {
      "index": 57,
      "start": 92.64,
      "end": 94.04,
      "text": "它的这个质地呢"
    },
    {
      "index": 58,
      "start": 94.04,
      "end": 96.44,
      "text": "就像一个窝尿酸的圆叶一样"
    },
    {
      "index": 59,
      "start": 97.04,
      "end": 98.34,
      "text": "很轻爽的"
    },
    {
      "index": 60,
      "start": 98.34,
      "end": 100.14,
      "text": "而且它用了一个索鲜技术保鲜"
    },
    {
      "index": 61,
      "start": 100.14,
      "end": 101.14,
      "text": "做得特别好"
    },
    {
      "index": 62,
      "start": 101.14,
      "end": 103.64,
      "text": "原型迷思肯定是要越新鲜越好的"
    },
    {
      "index": 63,
      "start": 103.64,
      "end": 104.54,
      "text": "很多原型迷思"
    },
    {
      "index": 64,
      "start": 104.54,
      "end": 105.84,
      "text": "拿到手就已经还了"
    },
    {
      "index": 65,
      "start": 105.84,
      "end": 107.54,
      "text": "但这个我已经用了一个多月了"
    },
    {
      "index": 66,
      "start": 107.54,
      "end": 109.14,
      "text": "你们看它的这个颜色"
    },
    {
      "index": 67,
      "start": 109.94,
      "end": 111.34,
      "text": "还几乎是透明的"
    },
    {
      "index": 68,
      "start": 111.34,
      "end": 113.44,
      "text": "而且它的浓度设计很巧妙"
    },
    {
      "index": 69,
      "start": 113.44,
      "end": 115.24,
      "text": "百分之十二的黄金浓度"
    },
    {
      "index": 70,
      "start": 115.34,
      "end": 116.84,
      "text": "既能够帮我们看养化"
    },
    {
      "index": 71,
      "start": 116.84,
      "end": 117.64,
      "text": "提亮肤色"
    },
    {
      "index": 72,
      "start": 117.64,
      "end": 118.74,
      "text": "还可以K老"
    },
    {
      "index": 73,
      "start": 118.74,
      "end": 120.74,
      "text": "帮我们促进交易单白的身长"
    },
    {
      "index": 74,
      "start": 120.74,
      "end": 121.64,
      "text": "所以用了它之后呢"
    },
    {
      "index": 75,
      "start": 121.64,
      "end": 122.94,
      "text": "会感觉肤色变亮"
    },
    {
      "index": 76,
      "start": 122.94,
      "end": 124.34,
      "text": "毛孔会更细腻一点"
    },
    {
      "index": 77,
      "start": 124.34,
      "end": 125.74,
      "text": "脸也会紧致一些"
    },
    {
      "index": 78,
      "start": 125.74,
      "end": 127.64,
      "text": "而且它淡化多余的效果也不错"
    },
    {
      "index": 79,
      "start": 127.64,
      "end": 129.24,
      "text": "同时呢它还很温和"
    },
    {
      "index": 80,
      "start": 129.24,
      "end": 130.54,
      "text": "PH值为6"
    },
    {
      "index": 81,
      "start": 130.54,
      "end": 132.74,
      "text": "接近于我们皮肤本身的PH值"
    },
    {
      "index": 82,
      "start": 132.74,
      "end": 134.44,
      "text": "就不用担心用起来会刺痛"
    },
    {
      "index": 83,
      "start": 134.44,
      "end": 136.24,
      "text": "因为很多高浓度的原型迷思"
    },
    {
      "index": 84,
      "start": 136.24,
      "end": 138.04,
      "text": "我用起来会感觉脸痛痛的"
    },
    {
      "index": 85,
      "start": 138.04,
      "end": 139.34,
      "text": "然后会容易红"
    },
    {
      "index": 86,
      "start": 139.34,
      "end": 140.34,
      "text": "但这个就不会"
    },
    {
      "index": 87,
      "start": 140.34,
      "end": 141.84,
      "text": "所以你们真的可以试试它"
    },
    {
      "index": 88,
      "start": 141.84,
      "end": 142.94,
      "text": "功效很多面"
    },
    {
      "index": 89,
      "start": 142.94,
      "end": 143.84,
      "text": "肤感又好"
    },
    {
      "index": 90,
      "start": 143.84,
      "end": 145.24,
      "text": "那我们在护肤步骤上面"
    },
    {
      "index": 91,
      "start": 145.24,
      "end": 146.24,
      "text": "就可以更精减"
    },
    {
      "index": 92,
      "start": 146.24,
      "end": 147.44,
      "text": "皮肤负担少的同时"
    },
    {
      "index": 93,
      "start": 147.44,
      "end": 149.04,
      "text": "能用进行了有效的护肤"
    },
    {
      "index": 94,
      "start": 149.04,
      "end": 150.04,
      "text": "像控油"
    },
    {
      "index": 95,
      "start": 150.04,
      "end": 150.54,
      "text": "K老"
    },
    {
      "index": 96,
      "start": 150.54,
      "end": 151.24,
      "text": "抗氧化"
    },
    {
      "index": 97,
      "start": 151.24,
      "end": 152.44,
      "text": "淡化多余提亮肤色"
    },
    {
      "index": 98,
      "start": 152.44,
      "end": 153.54,
      "text": "它都可以做到"
    },
    {
      "index": 99,
      "start": 153.54,
      "end": 155.14,
      "text": "这一瓶可以解决我们油"
    },
    {
      "index": 100,
      "start": 155.14,
      "end": 156.74,
      "text": "到期很多的护肤需求"
    }
  ]
}