{
  "language": "zh",
  "duration": 40.008,
  "segments": [
    {
      "index": 1,
      "start": 0.08,
      "end": 3.48,
      "text": "最近我收到很多私信和评论"
    },
    {
      "index": 2,
      "start": 3.48,
      "end": 6.08,
      "text": "都是说我这个作品像这个春暖小品"
    },
    {
      "index": 3,
      "start": 6.08,
      "end": 7.88,
      "text": "然后我的作品现在咱人不看"
    },
    {
      "index": 4,
      "start": 7.88,
      "end": 9.48,
      "text": "留着过年当小品看"
    },
    {
      "index": 5,
      "start": 9.48,
      "end": 12.68,
      "text": "有人说这个你现在演完了我春暖小品怎么办"
    },
    {
      "index": 6,
      "start": 13.68,
      "end": 16.68,
      "text": "其实我想真正的替春暖小品说两句话"
    },
    {
      "index": 7,
      "start": 16.68,
      "end": 18.68,
      "text": "小品真的是很难创造"
    },
    {
      "index": 8,
      "start": 18.68,
      "end": 21.28,
      "text": "你看小品是十几分钟的那么一个体谅"
    },
    {
      "index": 9,
      "start": 21.28,
      "end": 23.08,
      "text": "需要讲一个完整的故事"
    },
    {
      "index": 10,
      "start": 23.08,
      "end": 25.28,
      "text": "还要在里面加包裹真的是很难"
    },
    {
      "index": 11,
      "start": 25.28,
      "end": 27.88,
      "text": "所以今年我给大家演了三个位置的春暖小品"
    },
    {
      "index": 12,
      "start": 27.88,
      "end": 29.08,
      "text": "来镜头过来一下"
    },
    {
      "index": 13,
      "start": 29.08,
      "end": 30.48,
      "text": "这个是辽宁卫视的"
    },
    {
      "index": 14,
      "start": 30.48,
      "end": 31.48,
      "text": "这个是北京卫视的"
    },
    {
      "index": 15,
      "start": 31.48,
      "end": 33.48,
      "text": "这个是东方卫视的"
    },
    {
      "index": 16,
      "start": 33.48,
      "end": 34.68,
      "text": "一定要记得看"
    },
    {
      "index": 17,
      "start": 34.68,
      "end": 37.08,
      "text": "这是一个促不及防的个人自我宣传"
    }
  ]
}