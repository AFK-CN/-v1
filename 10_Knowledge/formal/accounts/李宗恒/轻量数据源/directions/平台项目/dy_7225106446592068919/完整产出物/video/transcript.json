{
  "language": "zh",
  "duration": 41.261875,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.48,
      "text": "但我第一次走红毯"
    },
    {
      "index": 2,
      "start": 1.48,
      "end": 3.2,
      "text": "一位曹山汉车车车"
    },
    {
      "index": 3,
      "start": 3.2,
      "end": 5.24,
      "text": "你叫张静然"
    },
    {
      "index": 4,
      "start": 5.24,
      "end": 6.68,
      "text": "李宗豪"
    },
    {
      "index": 5,
      "start": 6.68,
      "end": 8.12,
      "text": "欢迎一个位置成功"
    },
    {
      "index": 6,
      "start": 8.12,
      "end": 9.48,
      "text": "出于四季的过程里"
    },
    {
      "index": 7,
      "start": 9.48,
      "end": 11.16,
      "text": "依静一路走"
    },
    {
      "index": 8,
      "start": 13.6,
      "end": 14.48,
      "text": "来 东豪呢"
    },
    {
      "index": 9,
      "start": 15.6,
      "end": 17.8,
      "text": "这部戏挑战对我最大的点"
    },
    {
      "index": 10,
      "start": 17.8,
      "end": 28.36,
      "text": "是我养个偷游贼"
    },
    {
      "index": 11,
      "start": 28.36,
      "end": 30.92,
      "text": "咱以后终于能开炮车偷游了"
    },
    {
      "index": 12,
      "start": 30.92,
      "end": 33.16,
      "text": "但我后前有两只鸡肉就会回复了"
    },
    {
      "index": 13,
      "start": 33.16,
      "end": 33.92,
      "text": "回贼了"
    },
    {
      "index": 14,
      "start": 34.72,
      "end": 35.28,
      "text": "好"
    },
    {
      "index": 15,
      "start": 38.11,
      "end": 39.79,
      "text": "咱们动作目标是不演员吗"
    },
    {
      "index": 16,
      "start": 39.79,
      "end": 40.63,
      "text": "不够了"
    }
  ]
}