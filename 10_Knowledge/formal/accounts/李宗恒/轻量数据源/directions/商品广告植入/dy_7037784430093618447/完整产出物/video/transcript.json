{
  "language": "zh",
  "duration": 55.936875,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.2,
      "text": "大姨到大师对爱情变化"
    },
    {
      "index": 2,
      "start": 1.2,
      "end": 1.8,
      "text": "大姨"
    },
    {
      "index": 3,
      "start": 1.8,
      "end": 3.8,
      "text": "学弟我喜欢你"
    },
    {
      "index": 4,
      "start": 4.8,
      "end": 5.6,
      "text": "对不起 学姐"
    },
    {
      "index": 5,
      "start": 5.6,
      "end": 6.6,
      "text": "我还要学习"
    },
    {
      "index": 6,
      "start": 6.6,
      "end": 7.4,
      "text": "不能谈恋爱"
    },
    {
      "index": 7,
      "start": 10.11,
      "end": 10.51,
      "text": "大二"
    },
    {
      "index": 8,
      "start": 10.51,
      "end": 11.91,
      "text": "学妹 你好 我帮你拿学妹吧"
    },
    {
      "index": 9,
      "start": 11.91,
      "end": 12.71,
      "text": "你有男朋友吗"
    },
    {
      "index": 10,
      "start": 12.71,
      "end": 13.51,
      "text": "没有"
    },
    {
      "index": 11,
      "start": 13.51,
      "end": 14.71,
      "text": "太沉了 都拿不动"
    },
    {
      "index": 12,
      "start": 14.71,
      "end": 15.71,
      "text": "还真是空的"
    },
    {
      "index": 13,
      "start": 15.71,
      "end": 16.71,
      "text": "拿不动"
    },
    {
      "index": 14,
      "start": 16.71,
      "end": 17.11,
      "text": "大三"
    },
    {
      "index": 15,
      "start": 17.11,
      "end": 17.91,
      "text": "我追你这么久了"
    },
    {
      "index": 16,
      "start": 17.91,
      "end": 19.11,
      "text": "你到底同不同意跟我在一起"
    },
    {
      "index": 17,
      "start": 19.11,
      "end": 20.31,
      "text": "能不能给我个答复"
    },
    {
      "index": 18,
      "start": 20.31,
      "end": 21.51,
      "text": "别这一句耍我的情谋"
    },
    {
      "index": 19,
      "start": 21.51,
      "end": 23.11,
      "text": "别拿我到天走了"
    },
    {
      "index": 20,
      "start": 23.11,
      "end": 24.11,
      "text": "我有点饿了"
    },
    {
      "index": 21,
      "start": 24.11,
      "end": 25.11,
      "text": "等我啊 我马上给你买饭"
    },
    {
      "index": 22,
      "start": 25.11,
      "end": 25.71,
      "text": "哎"
    },
    {
      "index": 23,
      "start": 27.31,
      "end": 28.71,
      "text": "哎 买到这两件衣服哪个好了"
    },
    {
      "index": 24,
      "start": 28.71,
      "end": 29.91,
      "text": "这也好看有卖新衣服了"
    },
    {
      "index": 25,
      "start": 29.91,
      "end": 31.31,
      "text": "这是我特意在时务里逼着买的"
    },
    {
      "index": 26,
      "start": 31.31,
      "end": 32.91,
      "text": "这里名冠军的礼物图外造法"
    },
    {
      "index": 27,
      "start": 32.91,
      "end": 33.71,
      "text": "证据篮理法度"
    },
    {
      "index": 28,
      "start": 33.71,
      "end": 34.31,
      "text": "博强更便宜"
    },
    {
      "index": 29,
      "start": 34.31,
      "end": 35.51,
      "text": "其他人们都没这整天"
    },
    {
      "index": 30,
      "start": 35.51,
      "end": 36.31,
      "text": "你签个电话评论剧"
    },
    {
      "index": 31,
      "start": 36.31,
      "end": 37.51,
      "text": "再拿个月88元补兵"
    },
    {
      "index": 32,
      "start": 37.51,
      "end": 38.11,
      "text": "不跟你说了"
    },
    {
      "index": 33,
      "start": 38.11,
      "end": 39.11,
      "text": "我给我女神送发水"
    },
    {
      "index": 34,
      "start": 39.11,
      "end": 40.71,
      "text": "中皇的她其实喜欢张国愿"
    },
    {
      "index": 35,
      "start": 40.71,
      "end": 41.11,
      "text": "啊"
    },
    {
      "index": 36,
      "start": 41.11,
      "end": 42.71,
      "text": "那我给张国愿买份发水吧"
    },
    {
      "index": 37,
      "start": 42.71,
      "end": 43.11,
      "text": "大师"
    },
    {
      "index": 38,
      "start": 43.11,
      "end": 43.91,
      "text": "大姨就是追你"
    },
    {
      "index": 39,
      "start": 43.91,
      "end": 44.71,
      "text": "都大师也没出了"
    },
    {
      "index": 40,
      "start": 44.71,
      "end": 45.71,
      "text": "你们这啥玩意"
    },
    {
      "index": 41,
      "start": 45.71,
      "end": 46.31,
      "text": "不跟咱们同学出补"
    },
    {
      "index": 42,
      "start": 46.31,
      "end": 47.11,
      "text": "牙上跟人家看"
    },
    {
      "index": 43,
      "start": 47.11,
      "end": 47.71,
      "text": "哎"
    },
    {
      "index": 44,
      "start": 47.71,
      "end": 48.71,
      "text": "牙上我喜欢你"
    },
    {
      "index": 45,
      "start": 48.71,
      "end": 50.51,
      "text": "不好意思 我有对象了"
    },
    {
      "index": 46,
      "start": 50.51,
      "end": 50.91,
      "text": "你好"
    },
    {
      "index": 47,
      "start": 50.91,
      "end": 51.51,
      "text": "你谁的"
    },
    {
      "index": 48,
      "start": 51.51,
      "end": 52.31,
      "text": "我是大姨学弟"
    }
  ]
}