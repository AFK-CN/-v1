{
  "language": "zh",
  "duration": 90.5578125,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.6,
      "text": "欢迎收看将你做暖男"
    },
    {
      "index": 2,
      "start": 1.6,
      "end": 3.44,
      "text": "这期教室里面有一位阳光暖男"
    },
    {
      "index": 3,
      "start": 3.44,
      "end": 4.96,
      "text": "我们来采访一下暖男先生"
    },
    {
      "index": 4,
      "start": 4.96,
      "end": 5.64,
      "text": "我是暖男"
    },
    {
      "index": 5,
      "start": 5.64,
      "end": 6.2,
      "text": "你暖不暖"
    },
    {
      "index": 6,
      "start": 6.2,
      "end": 7.72,
      "text": "在大三日之间你是不是有病啊"
    },
    {
      "index": 7,
      "start": 7.72,
      "end": 8.88,
      "text": "我暖的一天"
    },
    {
      "index": 8,
      "start": 8.88,
      "end": 9.84,
      "text": "打两个电话来"
    },
    {
      "index": 9,
      "start": 9.84,
      "end": 10.8,
      "text": "我打三个电话"
    },
    {
      "index": 10,
      "start": 10.8,
      "end": 11.76,
      "text": "你再带我50度"
    },
    {
      "index": 11,
      "start": 11.76,
      "end": 13.32,
      "text": "你平时是怎么暖暖女生"
    },
    {
      "index": 12,
      "start": 13.32,
      "end": 15.04,
      "text": "我每天给她发气来闷"
    },
    {
      "index": 13,
      "start": 15.04,
      "end": 15.68,
      "text": "多喝热水"
    },
    {
      "index": 14,
      "start": 15.68,
      "end": 17.04,
      "text": "我打游戏得早点睡"
    },
    {
      "index": 15,
      "start": 17.04,
      "end": 18.56,
      "text": "四句话暖她一整天"
    },
    {
      "index": 16,
      "start": 18.56,
      "end": 19.68,
      "text": "而且我跟她看电视"
    },
    {
      "index": 17,
      "start": 19.68,
      "end": 20.92,
      "text": "从来都是分开的"
    },
    {
      "index": 18,
      "start": 20.92,
      "end": 22.16,
      "text": "我给她买5排20号"
    },
    {
      "index": 19,
      "start": 22.16,
      "end": 24.0,
      "text": "给我自己买13排14号"
    },
    {
      "index": 20,
      "start": 24.0,
      "end": 28.28,
      "text": "意味着5201314浪漫致死不属于"
    },
    {
      "index": 21,
      "start": 28.28,
      "end": 29.76,
      "text": "女生上机了你是怎么解决的"
    },
    {
      "index": 22,
      "start": 29.76,
      "end": 30.72,
      "text": "我会跟她讲道理"
    },
    {
      "index": 23,
      "start": 30.72,
      "end": 31.72,
      "text": "如果她不讲理"
    },
    {
      "index": 24,
      "start": 31.72,
      "end": 32.36,
      "text": "那我没招"
    },
    {
      "index": 25,
      "start": 32.36,
      "end": 33.0,
      "text": "你有招吗"
    },
    {
      "index": 26,
      "start": 33.0,
      "end": 33.72,
      "text": "我会哄的"
    },
    {
      "index": 27,
      "start": 33.72,
      "end": 34.44,
      "text": "你个天狗"
    },
    {
      "index": 28,
      "start": 34.44,
      "end": 35.24,
      "text": "你什么啊"
    },
    {
      "index": 29,
      "start": 35.24,
      "end": 36.24,
      "text": "你天狗我不要别说啊"
    },
    {
      "index": 30,
      "start": 36.24,
      "end": 37.2,
      "text": "那你是钢铁直暖的"
    },
    {
      "index": 31,
      "start": 37.2,
      "end": 37.8,
      "text": "你要夸我"
    },
    {
      "index": 32,
      "start": 37.8,
      "end": 38.4,
      "text": "那我没话可讲"
    },
    {
      "index": 33,
      "start": 38.4,
      "end": 39.2,
      "text": "我夸你"
    },
    {
      "index": 34,
      "start": 39.2,
      "end": 40.28,
      "text": "钢铁直暖"
    },
    {
      "index": 35,
      "start": 40.28,
      "end": 41.76,
      "text": "就是有钢铁般意志"
    },
    {
      "index": 36,
      "start": 41.76,
      "end": 43.24,
      "text": "勇往直前的男人"
    },
    {
      "index": 37,
      "start": 43.24,
      "end": 44.12,
      "text": "她是这么一样"
    },
    {
      "index": 38,
      "start": 44.12,
      "end": 45.04,
      "text": "你给我回来"
    },
    {
      "index": 39,
      "start": 45.04,
      "end": 46.16,
      "text": "哎呦 我也给我回来"
    },
    {
      "index": 40,
      "start": 46.16,
      "end": 47.2,
      "text": "你根本就没对象"
    },
    {
      "index": 41,
      "start": 47.2,
      "end": 47.8,
      "text": "什么话"
    },
    {
      "index": 42,
      "start": 47.8,
      "end": 48.72,
      "text": "什么话这是"
    },
    {
      "index": 43,
      "start": 48.72,
      "end": 49.68,
      "text": "我给我律师打电话"
    },
    {
      "index": 44,
      "start": 49.68,
      "end": 50.4,
      "text": "见我联系"
    },
    {
      "index": 45,
      "start": 50.4,
      "end": 52.76,
      "text": "我没有对象能够心动日常吗"
    },
    {
      "index": 46,
      "start": 52.76,
      "end": 53.44,
      "text": "镜头看一下"
    },
    {
      "index": 47,
      "start": 53.44,
      "end": 55.12,
      "text": "能迟迟看了她的位置和轨迹"
    },
    {
      "index": 48,
      "start": 55.12,
      "end": 56.96,
      "text": "她正拿着鲜花来找我的路上"
    },
    {
      "index": 49,
      "start": 56.96,
      "end": 58.16,
      "text": "就是最近很火的心动日常"
    },
    {
      "index": 50,
      "start": 58.16,
      "end": 59.24,
      "text": "可以查她对象的定位"
    },
    {
      "index": 51,
      "start": 59.24,
      "end": 59.92,
      "text": "我还会在这上面"
    },
    {
      "index": 52,
      "start": 59.92,
      "end": 61.24,
      "text": "跟她一起别聊天变化电影"
    },
    {
      "index": 53,
      "start": 61.24,
      "end": 61.88,
      "text": "怎么会显平"
    },
    {
      "index": 54,
      "start": 61.88,
      "end": 62.92,
      "text": "她还跟我一起互动呢"
    },
    {
      "index": 55,
      "start": 62.92,
      "end": 63.88,
      "text": "哎 这好玩啊"
    },
    {
      "index": 56,
      "start": 63.88,
      "end": 64.36,
      "text": "好玩吧"
    },
    {
      "index": 57,
      "start": 64.36,
      "end": 65.32,
      "text": "赶快点击我评论区"
    },
    {
      "index": 58,
      "start": 65.32,
      "end": 66.6,
      "text": "和对象一起玩吧"
    },
    {
      "index": 59,
      "start": 66.6,
      "end": 67.64,
      "text": "哎 你干啥呢"
    },
    {
      "index": 60,
      "start": 67.64,
      "end": 68.24,
      "text": "什么玩意儿啊"
    },
    {
      "index": 61,
      "start": 68.24,
      "end": 69.48,
      "text": "我自己行动呢"
    },
    {
      "index": 62,
      "start": 69.48,
      "end": 70.28,
      "text": "她不会用手机"
    },
    {
      "index": 63,
      "start": 70.28,
      "end": 71.2,
      "text": "她把手机放过来"
    },
    {
      "index": 64,
      "start": 71.2,
      "end": 73.36,
      "text": "她也心里她是能去跟闺蜜"
    },
    {
      "index": 65,
      "start": 73.36,
      "end": 74.2,
      "text": "你们出去了"
    },
    {
      "index": 66,
      "start": 74.2,
      "end": 75.44,
      "text": "这上来就"
    },
    {
      "index": 67,
      "start": 75.44,
      "end": 76.04,
      "text": "问别人"
    },
    {
      "index": 68,
      "start": 76.04,
      "end": 76.92,
      "text": "这心脏呢"
    },
    {
      "index": 69,
      "start": 76.92,
      "end": 77.96,
      "text": "就是欣赏你"
    },
    {
      "index": 70,
      "start": 77.96,
      "end": 79.08,
      "text": "照谣是要有证据的"
    },
    {
      "index": 71,
      "start": 79.08,
      "end": 80.2,
      "text": "一点你也不懂女士"
    },
    {
      "index": 72,
      "start": 80.2,
      "end": 81.08,
      "text": "你吃一下生鸡啊"
    },
    {
      "index": 73,
      "start": 81.08,
      "end": 81.56,
      "text": "老师 老师"
    },
    {
      "index": 74,
      "start": 81.56,
      "end": 82.88,
      "text": "你直接一起吃个饭"
    },
    {
      "index": 75,
      "start": 82.88,
      "end": 83.6,
      "text": "你想吃什么呀"
    },
    {
      "index": 76,
      "start": 83.6,
      "end": 84.92,
      "text": "我想吃吃的饱子里"
    },
    {
      "index": 77,
      "start": 84.92,
      "end": 85.76,
      "text": "应该有一家"
    },
    {
      "index": 78,
      "start": 85.76,
      "end": 86.32,
      "text": "披萨鸭"
    },
    {
      "index": 79,
      "start": 86.32,
      "end": 87.2,
      "text": "你怎么会这么认真"
    },
    {
      "index": 80,
      "start": 87.2,
      "end": 88.12,
      "text": "她长得好看"
    },
    {
      "index": 81,
      "start": 88.12,
      "end": 88.6,
      "text": "啊"
    }
  ]
}