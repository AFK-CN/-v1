{
  "language": "zh",
  "duration": 84.2884375,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.08,
      "text": "哎别嘴啊"
    },
    {
      "index": 2,
      "start": 1.08,
      "end": 2.88,
      "text": "哎呦这手机卡怎么挖不出来了呢"
    },
    {
      "index": 3,
      "start": 2.88,
      "end": 4.28,
      "text": "哥们儿这是别嘴吧"
    },
    {
      "index": 4,
      "start": 4.28,
      "end": 5.48,
      "text": "我拿包子给你换"
    },
    {
      "index": 5,
      "start": 5.48,
      "end": 6.0,
      "text": "坐着"
    },
    {
      "index": 6,
      "start": 6.0,
      "end": 6.56,
      "text": "谢谢"
    },
    {
      "index": 7,
      "start": 6.56,
      "end": 7.88,
      "text": "我不饿呀哥们儿"
    },
    {
      "index": 8,
      "start": 7.88,
      "end": 9.0,
      "text": "这玩意"
    },
    {
      "index": 9,
      "start": 9.0,
      "end": 10.0,
      "text": "哎妈包子"
    },
    {
      "index": 10,
      "start": 10.0,
      "end": 10.84,
      "text": "哥们儿都饿死了"
    },
    {
      "index": 11,
      "start": 10.84,
      "end": 12.0,
      "text": "我拿皮鞋给你换"
    },
    {
      "index": 12,
      "start": 14.0,
      "end": 14.68,
      "text": "哥们儿"
    },
    {
      "index": 13,
      "start": 15.44,
      "end": 16.48,
      "text": "皮鞋有啥用呢"
    },
    {
      "index": 14,
      "start": 16.48,
      "end": 17.92,
      "text": "谁要能确保皮鞋啊"
    },
    {
      "index": 15,
      "start": 17.92,
      "end": 19.48,
      "text": "擦上皮鞋就不能结婚了"
    },
    {
      "index": 16,
      "start": 19.48,
      "end": 20.44,
      "text": "我不是问满的什么的"
    },
    {
      "index": 17,
      "start": 20.44,
      "end": 21.0,
      "text": "他上哪"
    },
    {
      "index": 18,
      "start": 21.0,
      "end": 21.84,
      "text": "找了嘴"
    },
    {
      "index": 19,
      "start": 22.84,
      "end": 23.76,
      "text": "我能这样给你换"
    },
    {
      "index": 20,
      "start": 23.76,
      "end": 25.0,
      "text": "我今天结婚"
    },
    {
      "index": 21,
      "start": 25.0,
      "end": 25.96,
      "text": "我们新闻快乐"
    },
    {
      "index": 22,
      "start": 26.96,
      "end": 28.48,
      "text": "儿子妈58才有的你呀"
    },
    {
      "index": 23,
      "start": 28.48,
      "end": 29.24,
      "text": "老习他你了"
    },
    {
      "index": 24,
      "start": 29.24,
      "end": 31.0,
      "text": "你要啥妈都给你整啊"
    },
    {
      "index": 25,
      "start": 31.0,
      "end": 32.44,
      "text": "我要电脑"
    },
    {
      "index": 26,
      "start": 32.44,
      "end": 33.4,
      "text": "还能要电脑啊"
    },
    {
      "index": 27,
      "start": 33.4,
      "end": 34.88,
      "text": "哎呀这电脑还是有点显"
    },
    {
      "index": 28,
      "start": 34.88,
      "end": 36.36,
      "text": "老弟爷我还得先弄电脑了"
    },
    {
      "index": 29,
      "start": 36.36,
      "end": 37.68,
      "text": "结这包新的一款二十万的"
    },
    {
      "index": 30,
      "start": 37.68,
      "end": 38.52,
      "text": "给你换了"
    },
    {
      "index": 31,
      "start": 38.52,
      "end": 39.0,
      "text": "就给你换了"
    },
    {
      "index": 32,
      "start": 39.0,
      "end": 39.36,
      "text": "谢谢啊"
    },
    {
      "index": 33,
      "start": 39.36,
      "end": 40.32,
      "text": "谢谢老弟啊"
    },
    {
      "index": 34,
      "start": 40.32,
      "end": 41.56,
      "text": "我说这三十万的"
    },
    {
      "index": 35,
      "start": 41.56,
      "end": 42.56,
      "text": "哥们儿这啥东西啊"
    },
    {
      "index": 36,
      "start": 42.56,
      "end": 44.44,
      "text": "这是新的一家AZ158超级神充"
    },
    {
      "index": 37,
      "start": 44.44,
      "end": 45.32,
      "text": "充电素质快玩一下"
    },
    {
      "index": 38,
      "start": 45.32,
      "end": 47.0,
      "text": "还稳充点一分钟就能玩一整局联盟"
    },
    {
      "index": 39,
      "start": 47.0,
      "end": 47.76,
      "text": "哎这手机好"
    },
    {
      "index": 40,
      "start": 47.76,
      "end": 48.88,
      "text": "你怎么就知道大游戏啊"
    },
    {
      "index": 41,
      "start": 48.88,
      "end": 49.76,
      "text": "我让你买包呢"
    },
    {
      "index": 42,
      "start": 49.76,
      "end": 51.2,
      "text": "那包特别难买买不着"
    },
    {
      "index": 43,
      "start": 51.2,
      "end": 52.4,
      "text": "这这两包怎么都买不着"
    },
    {
      "index": 44,
      "start": 52.4,
      "end": 53.56,
      "text": "他就是买不着嘛"
    },
    {
      "index": 45,
      "start": 53.68,
      "end": 54.48,
      "text": "哎这包给我了"
    },
    {
      "index": 46,
      "start": 54.48,
      "end": 55.16,
      "text": "这车给你"
    },
    {
      "index": 47,
      "start": 55.16,
      "end": 56.0,
      "text": "这车二百万"
    },
    {
      "index": 48,
      "start": 56.0,
      "end": 57.16,
      "text": "咱俩给我了"
    },
    {
      "index": 49,
      "start": 57.16,
      "end": 57.8,
      "text": "不是"
    },
    {
      "index": 50,
      "start": 57.8,
      "end": 58.4,
      "text": "谢谢老哥"
    },
    {
      "index": 51,
      "start": 58.4,
      "end": 59.72,
      "text": "不是咱们一个一的合作"
    },
    {
      "index": 52,
      "start": 59.72,
      "end": 60.52,
      "text": "你们不拍车机"
    },
    {
      "index": 53,
      "start": 60.52,
      "end": 61.24,
      "text": "你们咋想"
    },
    {
      "index": 54,
      "start": 61.24,
      "end": 62.84,
      "text": "哥们儿我这有车"
    },
    {
      "index": 55,
      "start": 62.84,
      "end": 63.44,
      "text": "这我的车"
    },
    {
      "index": 56,
      "start": 63.44,
      "end": 64.44,
      "text": "哎太好了"
    },
    {
      "index": 57,
      "start": 64.44,
      "end": 65.56,
      "text": "这样的话我愿意把我的词书"
    },
    {
      "index": 58,
      "start": 65.56,
      "end": 66.0,
      "text": "给你"
    },
    {
      "index": 59,
      "start": 66.0,
      "end": 66.56,
      "text": "这是房载证"
    },
    {
      "index": 60,
      "start": 66.56,
      "end": 67.16,
      "text": "我可以啊"
    },
    {
      "index": 61,
      "start": 67.16,
      "end": 68.0,
      "text": "谢谢你的小伙子"
    },
    {
      "index": 62,
      "start": 68.0,
      "end": 68.64,
      "text": "再见啊"
    },
    {
      "index": 63,
      "start": 68.64,
      "end": 69.32,
      "text": "什么房载证"
    },
    {
      "index": 64,
      "start": 69.32,
      "end": 70.32,
      "text": "这不白纸吗"
    },
    {
      "index": 65,
      "start": 70.32,
      "end": 70.92,
      "text": "不白纸吗"
    },
    {
      "index": 66,
      "start": 70.92,
      "end": 72.36,
      "text": "他就是我们这一惊人面啊"
    },
    {
      "index": 67,
      "start": 72.36,
      "end": 73.84,
      "text": "哎我肚好疼啊"
    },
    {
      "index": 68,
      "start": 73.84,
      "end": 74.88,
      "text": "你这白纸也没有用了"
    },
    {
      "index": 69,
      "start": 74.88,
      "end": 75.84,
      "text": "我拿别人给你换"
    },
    {
      "index": 70,
      "start": 75.84,
      "end": 76.16,
      "text": "我说"
    },
    {
      "index": 71,
      "start": 76.16,
      "end": 76.88,
      "text": "哎怎么换"
    },
    {
      "index": 72,
      "start": 76.88,
      "end": 77.56,
      "text": "来来来 哥们儿"
    },
    {
      "index": 73,
      "start": 77.56,
      "end": 77.96,
      "text": "我说"
    },
    {
      "index": 74,
      "start": 77.96,
      "end": 78.84,
      "text": "别吃"
    },
    {
      "index": 75,
      "start": 78.88,
      "end": 79.92,
      "text": "哥们儿我拿包子给你换"
    },
    {
      "index": 76,
      "start": 79.92,
      "end": 80.84,
      "text": "我不换"
    }
  ]
}