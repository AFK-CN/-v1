    {
      "index": 2,
      "start": 1.0,
      "end": 1.6,
      "text": "哎"
    },
    {
      "index": 3,
      "start": 1.6,
      "end": 2.2,
      "text": "谁啊"
    },
    {
      "index": 4,
      "start": 2.2,
      "end": 3.0,
      "text": "你干啥呢"
    },
    {
      "index": 5,
      "start": 3.0,
      "end": 3.6,
      "text": "先生您好"
    },
    {
      "index": 6,
      "start": 3.6,
      "end": 5.0,
      "text": "我们是全职所当有情综艺"
    },
    {
      "index": 7,
