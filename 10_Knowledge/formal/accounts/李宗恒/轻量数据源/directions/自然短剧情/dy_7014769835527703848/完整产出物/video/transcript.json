  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 2.0,
      "text": "当你上课吃东西时,别人的同桌"
    },
    {
      "index": 2,
      "start": 2.0,
      "end": 3.4,
      "text": "今天我们学的这种食战"
    },
    {
      "index": 3,
      "start": 3.4,
      "end": 5.4,
      "text": "你不一定要躺猫的背诵"
    },
    {
      "index": 4,
      "start": 5.4,
      "end": 7.0,
      "text": "你会抄写,知道吗?"
    },
    {
      "index": 5,
      "start": 7.0,
      "end": 8.6,
      "text": "黑板上现在写的"
    },
    {
      "index": 6,
      "start": 8.6,
      "end": 10.0,
      "text": "班长已经是刚刚说"
    },
    {
      "index": 7,
      "start": 10.0,
      "end": 11.8,
      "text": "做好了"
    },
    {
      "index": 8,
      "start": 11.8,
      "end": 12.9,
      "text": "你们知道吧?"
    },
    {
      "index": 9,
      "start": 12.9,
      "end": 13.9,
      "text": "明白"
    },
    {
      "index": 10,
      "start": 13.9,
      "end": 14.5,
      "text": "你的同桌"
    },
    {
      "index": 11,
      "start": 14.5,
      "end": 15.9,
      "text": "我们家还是要背诵"
    },
    {
      "index": 12,
      "start": 15.9,
      "end": 16.7,
      "text": "班长给咱们说"
    },
    {
      "index": 13,
      "start": 16.7,
      "end": 18.6,
      "text": "吃爽了吗?"
    }
  ]
