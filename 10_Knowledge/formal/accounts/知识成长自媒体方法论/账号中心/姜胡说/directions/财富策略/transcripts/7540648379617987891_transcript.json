      "end": 328.8,
      "text": "对吧"
    },
    {
      "index": 169,
      "start": 328.8,
      "end": 331.32,
      "text": "一百万钱的起动"
    },
    {
      "index": 170,
      "start": 331.32,
      "end": 333.0,
      "text": "就在一百米级的起动"
