    {
      "index": 159,
      "start": 316.08,
      "end": 317.6,
      "text": "没什么成本的"
    },
    {
      "index": 160,
      "start": 317.6,
      "end": 319.68,
      "text": "或者成本很低的"
    },
    {
      "index": 161,
      "start": 319.68,
      "end": 321.4,
      "text": "然后去尝试"
    },
    {
      "index": 162,
      "start": 321.4,
      "end": 322.72,
      "text": "你可以先先中吧"
