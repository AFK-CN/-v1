    {
      "index": 154,
      "start": 310.88,
      "end": 311.36,
      "text": "对吧"
    },
    {
      "index": 155,
      "start": 311.36,
      "end": 312.12,
      "text": "那么一千种的话"
    },
    {
      "index": 156,
      "start": 312.12,
      "end": 313.6,
      "text": "你可以去尝试"
    },
    {
      "index": 157,
      "start": 313.6,
      "end": 315.0,
      "text": "对吧"
    },
    {
      "index": 158,
      "start": 315.0,
      "end": 316.08,
      "text": "去找那种"
