    {
      "index": 149,
      "start": 304.2,
      "end": 305.88,
      "text": "你也不需要一上来中十万"
    },
    {
      "index": 150,
      "start": 305.88,
      "end": 306.72,
      "text": "特别一万"
    },
    {
      "index": 151,
      "start": 306.72,
      "end": 307.8,
      "text": "你可以先中"
    },
    {
      "index": 152,
      "start": 307.8,
      "end": 309.72,
      "text": "先从一千块钱开始"
    },
    {
      "index": 153,
      "start": 309.72,
      "end": 310.88,
      "text": "然后是一万"
