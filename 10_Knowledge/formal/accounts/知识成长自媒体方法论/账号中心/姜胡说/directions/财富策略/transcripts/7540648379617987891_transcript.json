    {
      "index": 163,
      "start": 322.72,
      "end": 323.96,
      "text": "对吧"
    },
    {
      "index": 164,
      "start": 323.96,
      "end": 324.44,
      "text": "那"
    },
    {
      "index": 165,
      "start": 324.44,
      "end": 326.0,
      "text": "从了书里子来还有很多书"
    },
    {
      "index": 166,
      "start": 326.0,
      "end": 326.64,
      "text": "比如说什么"
    },
    {
      "index": 167,
      "start": 326.64,
      "end": 328.24,
