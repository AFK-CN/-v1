      "end": 364.72,
      "text": "他们想有个人"
    },
    {
      "index": 197,
      "start": 364.72,
      "end": 366.64,
      "text": "实现成功有高速的"
    },
    {
      "index": 198,
      "start": 366.64,
      "end": 368.24,
      "text": "那你就去干净的事情吧"
