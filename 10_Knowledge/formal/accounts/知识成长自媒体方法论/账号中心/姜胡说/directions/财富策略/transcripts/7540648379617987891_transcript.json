    {
      "index": 191,
      "start": 357.24,
      "end": 358.08,
      "text": "就获得去关注"
    },
    {
      "index": 192,
      "start": 358.08,
      "end": 358.52,
      "text": "你要知道"
    },
    {
      "index": 193,
      "start": 358.52,
      "end": 361.0,
      "text": "很多人都想干这个事"
    },
    {
      "index": 194,
