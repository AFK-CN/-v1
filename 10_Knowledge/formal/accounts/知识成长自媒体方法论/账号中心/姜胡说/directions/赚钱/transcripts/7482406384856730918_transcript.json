    {
      "index": 54,
      "start": 80.24,
      "end": 81.24,
      "text": "就是小企业主"
    },
    {
      "index": 55,
      "start": 81.24,
      "end": 82.24,
      "text": "就他们就知道了"
    },
    {
      "index": 56,
      "start": 82.24,
      "end": 83.24,
