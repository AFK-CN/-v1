    {
      "index": 36,
      "start": 57.24,
      "end": 58.24,
      "text": "在你原来那个领域是不知简单的"
    },
    {
      "index": 37,
      "start": 58.24,
      "end": 60.24,
      "text": "你换一个领域就知显了"
    },
    {
      "index": 38,
      "start": 60.24,
      "end": 61.24,
      "text": "给大家几个小利子"
    },
    {
      "index": 39,
      "start": 61.24,
      "end": 62.24,
      "text": "多一钱是成学员"
    },
    {
      "index": 40,
      "start": 62.24,
      "end": 63.24,
      "text": "水平呢"
    },
    {
      "index": 41,
      "start": 63.24,
      "end": 64.24,
      "text": "中两天上嘛"
    },
    {
      "index": 42,
      "start": 64.24,
      "end": 65.24,
      "text": "你不成唱"
