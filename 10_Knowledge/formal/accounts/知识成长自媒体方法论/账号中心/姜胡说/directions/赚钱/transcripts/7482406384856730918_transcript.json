    },
    {
      "index": 69,
      "start": 97.24,
      "end": 98.24,
      "text": "我就帮他们做了一个"
    },
    {
      "index": 70,
      "start": 98.24,
      "end": 99.24,
      "text": "没当初事"
    },
    {
      "index": 71,
      "start": 99.24,
      "end": 100.24,
      "text": "審守的嘛"
    },
    {
      "index": 72,
      "start": 100.24,
      "end": 101.24,
      "text": "你也帮忙别人"
    },
    {
      "index": 73,
      "start": 101.24,
      "end": 102.24,
      "text": "什么忙人家"
