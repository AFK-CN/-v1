      "text": "有些时候"
    },
    {
      "index": 159,
      "start": 205.24,
      "end": 207.24,
      "text": "你要是"
    },
    {
      "index": 160,
      "start": 207.24,
      "end": 208.24,
      "text": "不对外"
    },
    {
      "index": 161,
      "start": 208.24,
