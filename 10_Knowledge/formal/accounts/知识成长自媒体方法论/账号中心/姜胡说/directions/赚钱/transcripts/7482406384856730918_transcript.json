  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.72,
      "text": "接着聊聊咱们正在小歇吧"
    },
    {
      "index": 2,
      "start": 1.72,
      "end": 3.28,
      "text": "其实很多事情真的很简单"
    },
    {
      "index": 3,
      "start": 3.28,
      "end": 4.76,
      "text": "我们很多人是被自己卡着"
    },
    {
      "index": 4,
      "start": 4.76,
      "end": 5.72,
      "text": "就递步"
    },
    {
      "index": 5,
      "start": 5.72,
      "end": 7.08,
      "text": "就把自己个下手了"
    },
    {
      "index": 6,
      "start": 7.08,
      "end": 8.96,
      "text": "给大家分享一个特别小的故事"
    },
    {
      "index": 7,
      "start": 8.96,
      "end": 10.76,
      "text": "你可以去尝试一下"
    },
    {
      "index": 8,
      "start": 10.76,
      "end": 11.68,
      "text": "华大师兄"
    },
    {
      "index": 9,
      "start": 11.68,
      "end": 13.04,
