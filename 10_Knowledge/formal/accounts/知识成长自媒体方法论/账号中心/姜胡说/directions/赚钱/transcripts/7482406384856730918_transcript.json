    {
      "index": 155,
      "start": 200.24,
      "end": 202.24,
      "text": "就有一个两个人看到的"
    },
    {
      "index": 156,
      "start": 202.24,
      "end": 203.24,
      "text": "那就是"
    },
    {
      "index": 157,
      "start": 203.24,
      "end": 204.24,
      "text": "手里的来的"
    },
    {
      "index": 158,
      "start": 204.24,
