    {
      "index": 118,
      "start": 160.24,
      "end": 162.24,
      "text": "那么怎么活得用户呢"
    },
    {
      "index": 119,
      "start": 162.24,
      "end": 163.24,
      "text": "啊"
    },
    {
      "index": 120,
      "start": 163.24,
      "end": 164.24,
      "text": "啊"
    },
    {
      "index": 121,
      "start": 164.24,
      "end": 165.24,
      "text": "这是互联网时代啊"
    },
    {
      "index": 122,
      "start": 165.24,
      "end": 166.24,
      "text": "互联网时代啊"
    },
    {
      "index": 123,
      "start": 166.24,
      "end": 167.24,
      "text": "就你发个文章啊"
