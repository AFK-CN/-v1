    },
    {
      "index": 10,
      "start": 13.04,
      "end": 13.8,
      "text": "回顾一下"
    },
    {
      "index": 11,
      "start": 13.8,
      "end": 15.56,
      "text": "自己曾经做过什么事"
    },
    {
      "index": 12,
      "start": 15.56,
      "end": 18.96,
      "text": "哪些事是自己经过困难"
    },
    {
      "index": 13,
      "start": 18.96,
      "end": 21.24,
      "text": "然后把他解决的"
    },
    {
      "index": 14,
      "start": 21.24,
      "end": 22.52,
      "text": "然后把他一点一点点出来"
    },
    {
      "index": 15,
      "start": 22.52,
      "end": 23.8,
      "text": "走到自己上场"
    },
    {
      "index": 16,
      "start": 23.8,
      "end": 25.2,
      "text": "这个钱是怎么赚呢"
    },
    {
      "index": 17,
      "start": 25.2,
      "end": 26.84,
      "text": "你上场的"
    },
    {
      "index": 18,
      "start": 26.84,
      "end": 29.24,
      "text": "别人需要我的中间"
    },
    {
      "index": 19,
      "start": 29.24,
      "end": 30.24,
      "text": "那个"
