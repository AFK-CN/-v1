    {
      "index": 20,
      "start": 30.24,
      "end": 31.24,
      "text": "那个"
    },
    {
      "index": 21,
      "start": 31.24,
      "end": 33.24,
      "text": "就是共同的那个部分"
    },
    {
      "index": 22,
      "start": 33.24,
