{
  "language": "zh",
  "duration": 293.802125,
  "segments": [
    {
      "index": 1,
      "start": 0.18,
      "end": 1.98,
      "text": "證據話說得太好了"
    },
    {
      "index": 2,
      "start": 1.98,
      "end": 5.82,
      "text": "任何一個還在為溫暴而憤鬥的人"
    },
    {
      "index": 3,
      "start": 5.82,
      "end": 7.74,
      "text": "一定缺乏想像力"
    },
    {
      "index": 4,
      "start": 7.74,
      "end": 9.66,
      "text": "誰說呢奧斯卡班兒子"
    },
    {
      "index": 5,
      "start": 9.66,
      "end": 12.86,
      "text": "昨天有消白國留言說胡澤英"
    },
    {
      "index": 6,
      "start": 12.86,
      "end": 14.26,
      "text": "介紹幾個書啊"
    },
    {
      "index": 7,
      "start": 14.26,
      "end": 15.14,
      "text": "我是好"
    },
    {
      "index": 8,
      "start": 15.14,
      "end": 17.06,
      "text": "但是這次就要說"
    },
    {
      "index": 9,
      "start": 17.06,
      "end": 18.94,
      "text": "和去年前面不一樣"
    },
    {
      "index": 10,
      "start": 18.94,
      "end": 20.42,
      "text": "不是讓你讀幾年"
    },
    {
      "index": 11,
      "start": 20.42,
      "end": 21.7,
      "text": "不是讓你讀一整年"
    },
    {
      "index": 12,
      "start": 21.7,
      "end": 23.74,
      "text": "讓你短短讀幾個月的"
    },
    {
      "index": 13,
      "start": 23.74,
      "end": 26.62,
      "text": "就是從現在開始到過年這段時間讀"
    },
    {
      "index": 14,
      "start": 26.62,
      "end": 28.46,
      "text": "改變現在的思維的"
    },
    {
      "index": 15,
      "start": 28.46,
      "end": 29.86,
      "text": "思維太重要了"
    },
    {
      "index": 16,
      "start": 29.86,
      "end": 31.22,
      "text": "我發現我們很多人"
    },
    {
      "index": 17,
      "start": 31.22,
      "end": 33.18,
      "text": "有完全局限在自己的行業"
    },
    {
      "index": 18,
      "start": 33.18,
      "end": 34.02,
      "text": "自己的領域"
    },
    {
      "index": 19,
      "start": 34.02,
      "end": 35.22,
      "text": "自己的低運"
    },
    {
      "index": 20,
      "start": 35.22,
      "end": 36.9,
      "text": "就被關於那個龍住領"
    },
    {
      "index": 21,
      "start": 36.9,
      "end": 38.94,
      "text": "大腦啊"
    },
    {
      "index": 22,
      "start": 39.94,
      "end": 41.94,
      "text": "嚴重受限"
    },
    {
      "index": 23,
      "start": 41.94,
      "end": 43.3,
      "text": "舉個例子"
    },
    {
      "index": 24,
      "start": 43.3,
      "end": 46.82,
      "text": "我原淡的前一天"
    },
    {
      "index": 25,
      "start": 46.82,
      "end": 48.7,
      "text": "我出了一個計劃"
    },
    {
      "index": 26,
      "start": 48.7,
      "end": 49.34,
      "text": "我說什麼呢"
    },
    {
      "index": 27,
      "start": 49.34,
      "end": 50.7,
      "text": "我說每天抽出"
    },
    {
      "index": 28,
      "start": 50.7,
      "end": 52.74,
      "text": "一到兩小時就做最重要的事"
    },
    {
      "index": 29,
      "start": 52.74,
      "end": 53.7,
      "text": "然後第二個什麼呢"
    },
    {
      "index": 30,
      "start": 53.7,
      "end": 55.06,
      "text": "就是每天所以八個小時"
    },
    {
      "index": 31,
      "start": 55.06,
      "end": 56.74,
      "text": "結果留言最多的事"
    },
    {
      "index": 32,
      "start": 56.74,
      "end": 57.98,
      "text": "不可能"
    },
    {
      "index": 33,
      "start": 57.98,
      "end": 60.94,
      "text": "對吧工作都忙死了都累死了"
    },
    {
      "index": 34,
      "start": 60.94,
      "end": 62.62,
      "text": "怎拿我時間去休息"
    },
    {
      "index": 35,
      "start": 62.62,
      "end": 64.34,
      "text": "你以後發工資"
    },
    {
      "index": 36,
      "start": 64.34,
      "end": 65.54,
      "text": "當我看到"
    },
    {
      "index": 37,
      "start": 65.54,
      "end": 66.78,
      "text": "這樣多留言的時候"
    },
    {
      "index": 38,
      "start": 66.78,
      "end": 67.82,
      "text": "我就知道"
    },
    {
      "index": 39,
      "start": 67.82,
      "end": 69.62,
      "text": "就你的思維是嚴重受限了"
    },
    {
      "index": 40,
      "start": 69.62,
      "end": 71.42,
      "text": "就這些人他經常是把什麼呢"
    },
    {
      "index": 41,
      "start": 71.42,
      "end": 72.94,
      "text": "他在就計劃的時候"
    },
    {
      "index": 42,
      "start": 72.94,
      "end": 74.94,
      "text": "是把一天的工作時間跑出去"
    },
    {
      "index": 43,
      "start": 74.94,
      "end": 75.9,
      "text": "一天工作八小時"
    },
    {
      "index": 44,
      "start": 75.9,
      "end": 76.62,
      "text": "用工的十小時"
    },
    {
      "index": 45,
      "start": 76.62,
      "end": 77.74,
      "text": "用工的十二小時"
    },
    {
      "index": 46,
      "start": 77.74,
      "end": 79.42,
      "text": "然後再去算"
    },
    {
      "index": 47,
      "start": 79.42,
      "end": 81.34,
      "text": "我或者這時間"
    },
    {
      "index": 48,
      "start": 81.34,
      "end": 82.62,
      "text": "我多少用的"
    },
    {
      "index": 49,
      "start": 82.62,
      "end": 84.86,
      "text": "但思考一下"
    },
    {
      "index": 50,
      "start": 84.86,
      "end": 86.26,
      "text": "難道你每天"
    },
    {
      "index": 51,
      "start": 86.26,
      "end": 88.06,
      "text": "每週工作五天"
    },
    {
      "index": 52,
      "start": 88.06,
      "end": 89.78,
      "text": "然後最後就準備了休息兩天"
    },
    {
      "index": 53,
      "start": 89.78,
      "end": 91.22,
      "text": "結果那兩天那個跟狗一樣"
    },
    {
      "index": 54,
      "start": 91.22,
      "end": 92.14,
      "text": "然後天"
    },
    {
      "index": 55,
      "start": 92.14,
      "end": 93.42,
      "text": "第二週接著"
    },
    {
      "index": 56,
      "start": 93.42,
      "end": 94.66,
      "text": "拉姆拉五天"
    },
    {
      "index": 57,
      "start": 94.66,
      "end": 96.86,
      "text": "然後再休息兩天"
    },
    {
      "index": 58,
      "start": 96.86,
      "end": 98.34,
      "text": "所以我推薦的第一本書"
    },
    {
      "index": 59,
      "start": 98.34,
      "end": 99.46,
      "text": "我沒想到我還有"
    },
    {
      "index": 60,
      "start": 99.46,
      "end": 100.02,
      "text": "手臉還有這個"
    },
    {
      "index": 61,
      "start": 100.02,
      "end": 101.18,
      "text": "這本書"
    },
    {
      "index": 62,
      "start": 101.18,
      "end": 102.3,
      "text": "沒有問題"
    },
    {
      "index": 63,
      "start": 102.3,
      "end": 104.62,
      "text": "每週工作四小時"
    },
    {
      "index": 64,
      "start": 104.62,
      "end": 105.9,
      "text": "我覺得大家可以看一下"
    },
    {
      "index": 65,
      "start": 105.9,
      "end": 107.7,
      "text": "就是不是說"
    },
    {
      "index": 66,
      "start": 107.7,
      "end": 108.74,
      "text": "你每天"
    },
    {
      "index": 67,
      "start": 108.74,
      "end": 109.86,
      "text": "必須工作十小時"
    },
    {
      "index": 68,
      "start": 109.86,
      "end": 111.62,
      "text": "才能中到雙後飛"
    },
    {
      "index": 69,
      "start": 111.62,
      "end": 111.94,
      "text": "對吧"
    },
    {
      "index": 70,
      "start": 111.94,
      "end": 113.7,
      "text": "你做了目的不就為了中後飛嗎"
    },
    {
      "index": 71,
      "start": 113.7,
      "end": 114.98,
      "text": "當然有人有更為大的目的"
    },
    {
      "index": 72,
      "start": 114.98,
      "end": 115.82,
      "text": "目前了"
    },
    {
      "index": 73,
      "start": 115.82,
      "end": 116.74,
      "text": "我們說基礎的"
    },
    {
      "index": 74,
      "start": 116.74,
      "end": 117.98,
      "text": "就是不再掌聲我對嗎"
    },
    {
      "index": 75,
      "start": 117.98,
      "end": 121.3,
      "text": "真的需要每一天工作十天嗎"
    },
    {
      "index": 76,
      "start": 121.3,
      "end": 122.02,
      "text": "這本書的話"
    },
    {
      "index": 77,
      "start": 122.02,
      "end": 123.02,
      "text": "告訴你也方法"
    },
    {
      "index": 78,
      "start": 123.02,
      "end": 124.62,
      "text": "每週工作四小時"
    },
    {
      "index": 79,
      "start": 124.62,
      "end": 126.1,
      "text": "當然你是長事的話"
    },
    {
      "index": 80,
      "start": 126.1,
      "end": 127.06,
      "text": "你不一定完全說"
    },
    {
      "index": 81,
      "start": 127.06,
      "end": 128.22,
      "text": "每週四小時"
    },
    {
      "index": 82,
      "start": 128.22,
      "end": 129.58,
      "text": "可能是每週八小時"
    },
    {
      "index": 83,
      "start": 129.58,
      "end": 130.58,
      "text": "可能每週十二小時"
    },
    {
      "index": 84,
      "start": 130.58,
      "end": 132.06,
      "text": "可能每週二十小時"
    },
    {
      "index": 85,
      "start": 132.06,
      "end": 133.62,
      "text": "但是絕對用不了"
    },
    {
      "index": 86,
      "start": 133.62,
      "end": 135.46,
      "text": "每週五十小時就這麼說話費"
    },
    {
      "index": 87,
      "start": 135.46,
      "end": 136.54,
      "text": "我就看一看吧"
    },
    {
      "index": 88,
      "start": 136.54,
      "end": 137.58,
      "text": "對你是有幫助的"
    },
    {
      "index": 89,
      "start": 137.58,
      "end": 139.42,
      "text": "這是第一本書"
    },
    {
      "index": 90,
      "start": 139.42,
      "end": 140.58,
      "text": "第二本書"
    },
    {
      "index": 91,
      "start": 140.58,
      "end": 142.06,
      "text": "完全被書名毀了"
    },
    {
      "index": 92,
      "start": 142.06,
      "end": 143.06,
      "text": "這本書的名叫什麼呢"
    },
    {
      "index": 93,
      "start": 143.06,
      "end": 145.26,
      "text": "叫百萬負問快車道"
    },
    {
      "index": 94,
      "start": 146.26,
      "end": 147.5,
      "text": "你看那名答一看"
    },
    {
      "index": 95,
      "start": 147.5,
      "end": 148.46,
      "text": "什麼就是"
    },
    {
      "index": 96,
      "start": 148.46,
      "end": 149.26,
      "text": "這是"
    },
    {
      "index": 97,
      "start": 149.26,
      "end": 150.82,
      "text": "這是同學嗎"
    },
    {
      "index": 98,
      "start": 150.82,
      "end": 151.46,
      "text": "對吧"
    },
    {
      "index": 99,
      "start": 151.46,
      "end": 152.58,
      "text": "但是這本書"
    },
    {
      "index": 100,
      "start": 152.58,
      "end": 154.06,
      "text": "其實是非常好的一本書"
    },
    {
      "index": 101,
      "start": 154.06,
      "end": 155.38,
      "text": "特別的時候"
    },
    {
      "index": 102,
      "start": 155.38,
      "end": 157.5,
      "text": "就是你開拓事業"
    },
    {
      "index": 103,
      "start": 157.5,
      "end": 158.98,
      "text": "那什麼什麼漫車道呢"
    },
    {
      "index": 104,
      "start": 158.98,
      "end": 160.06,
      "text": "有快車段要漫車道"
    },
    {
      "index": 105,
      "start": 160.06,
      "end": 160.9,
      "text": "漫車道就準備"
    },
    {
      "index": 106,
      "start": 160.9,
      "end": 162.06,
      "text": "你上學"
    },
    {
      "index": 107,
      "start": 162.06,
      "end": 163.5,
      "text": "然後是好學習"
    },
    {
      "index": 108,
      "start": 163.5,
      "end": 164.54,
      "text": "公眾高中"
    },
    {
      "index": 109,
      "start": 164.54,
      "end": 165.38,
      "text": "然後大學"
    },
    {
      "index": 110,
      "start": 165.38,
      "end": 166.1,
      "text": "然後工作"
    },
    {
      "index": 111,
      "start": 166.1,
      "end": 167.54,
      "text": "早工作一直公開去"
    },
    {
      "index": 112,
      "start": 167.54,
      "end": 169.38,
      "text": "他說這個叫漫車道"
    },
    {
      "index": 113,
      "start": 169.38,
      "end": 170.78,
      "text": "但是還有一個很快車道"
    },
    {
      "index": 114,
      "start": 170.78,
      "end": 172.02,
      "text": "就是你很快的"
    },
    {
      "index": 115,
      "start": 172.02,
      "end": 174.5,
      "text": "發現生活中的一些需求"
    },
    {
      "index": 116,
      "start": 174.5,
      "end": 176.1,
      "text": "或者市場的一些機會"
    },
    {
      "index": 117,
      "start": 176.1,
      "end": 177.58,
      "text": "然後快做短短幾年"
    },
    {
      "index": 118,
      "start": 177.58,
      "end": 179.58,
      "text": "你就可以活得一些收益"
    },
    {
      "index": 119,
      "start": 179.58,
      "end": 181.46,
      "text": "就像這個大玩兒在書裡說的"
    },
    {
      "index": 120,
      "start": 181.46,
      "end": 183.3,
      "text": "有些行業啊"
    },
    {
      "index": 121,
      "start": 183.3,
      "end": 185.02,
      "text": "雖然只有短短幾年的時間"
    },
    {
      "index": 122,
      "start": 185.02,
      "end": 186.18,
      "text": "但是就這幾年"
    },
    {
      "index": 123,
      "start": 186.18,
      "end": 187.98,
      "text": "你就抓住了"
    },
    {
      "index": 124,
      "start": 187.98,
      "end": 190.26,
      "text": "那你就可以財富自由了"
    },
    {
      "index": 125,
      "start": 190.26,
      "end": 191.7,
      "text": "我不是說大家一定要做這樣的事情"
    },
    {
      "index": 126,
      "start": 191.7,
      "end": 193.18,
      "text": "但是我建議來好好看一看"
    },
    {
      "index": 127,
      "start": 193.18,
      "end": 195.7,
      "text": "它開過行的思考原來人生"
    },
    {
      "index": 128,
      "start": 195.7,
      "end": 197.62,
      "text": "還可以這麼過"
    },
    {
      "index": 129,
      "start": 197.62,
      "end": 198.78,
      "text": "改變你思議的"
    },
    {
      "index": 130,
      "start": 198.78,
      "end": 200.9,
      "text": "我就得非常好開過思路的"
    },
    {
      "index": 131,
      "start": 200.9,
      "end": 201.82,
      "text": "第三本書"
    },
    {
      "index": 132,
      "start": 201.82,
      "end": 203.18,
      "text": "我以前看了看的時候"
    },
    {
      "index": 133,
      "start": 203.18,
      "end": 203.78,
      "text": "我就特別好"
    },
    {
      "index": 134,
      "start": 203.78,
      "end": 205.82,
      "text": "最近又反而開開"
    },
    {
      "index": 135,
      "start": 205.82,
      "end": 206.82,
      "text": "誰不然分"
    },
    {
      "index": 136,
      "start": 206.82,
      "end": 207.82,
      "text": "我以前航空的一個"
    },
    {
      "index": 137,
      "start": 207.82,
      "end": 208.82,
      "text": "我以前真的那個"
    },
    {
      "index": 138,
      "start": 208.82,
      "end": 209.34,
      "text": "對吧"
    },
    {
      "index": 139,
      "start": 209.34,
      "end": 210.22,
      "text": "但真的的話呢"
    },
    {
      "index": 140,
      "start": 210.22,
      "end": 210.82,
      "text": "它有點數"
    },
    {
      "index": 141,
      "start": 210.82,
      "end": 214.62,
      "text": "叫至所有瘋狂的假好"
    },
    {
      "index": 142,
      "start": 214.62,
      "end": 215.98,
      "text": "我特別喜歡看著這說"
    },
    {
      "index": 143,
      "start": 215.98,
      "end": 216.94,
      "text": "就經常有一些"
    },
    {
      "index": 144,
      "start": 216.94,
      "end": 218.62,
      "text": "就是它平時日常的生活中"
    },
    {
      "index": 145,
      "start": 218.62,
      "end": 219.42,
      "text": "看到的"
    },
    {
      "index": 146,
      "start": 219.42,
      "end": 220.94,
      "text": "就把它總結化成生意了"
    },
    {
      "index": 147,
      "start": 220.94,
      "end": 222.06,
      "text": "比如說有一個小故事"
    },
    {
      "index": 148,
      "start": 222.06,
      "end": 223.58,
      "text": "就它去不多立刻"
    },
    {
      "index": 149,
      "start": 223.58,
      "end": 225.18,
      "text": "結果會多立刻那個飛機"
    },
    {
      "index": 150,
      "start": 225.18,
      "end": 226.14,
      "text": "就是"
    },
    {
      "index": 151,
      "start": 226.14,
      "end": 227.1,
      "text": "就取消了"
    },
    {
      "index": 152,
      "start": 227.1,
      "end": 228.06,
      "text": "結果航案路"
    },
    {
      "index": 153,
      "start": 228.06,
      "end": 229.98,
      "text": "航案路裡全是人"
    },
    {
      "index": 154,
      "start": 229.98,
      "end": 231.26,
      "text": "全是巡的地方"
    },
    {
      "index": 155,
      "start": 231.26,
      "end": 231.66,
      "text": "好了"
    },
    {
      "index": 156,
      "start": 231.66,
      "end": 232.66,
      "text": "這流了嗎"
    },
    {
      "index": 157,
      "start": 232.66,
      "end": 233.42,
      "text": "然後就給那個"
    },
    {
      "index": 158,
      "start": 233.42,
      "end": 235.26,
      "text": "包機公司打電話"
    },
    {
      "index": 159,
      "start": 235.26,
      "end": 235.82,
      "text": "好有一個人"
    },
    {
      "index": 160,
      "start": 235.82,
      "end": 237.18,
      "text": "還找到一個便宜的"
    },
    {
      "index": 161,
      "start": 237.18,
      "end": 238.14,
      "text": "三、兩千塊"
    },
    {
      "index": 162,
      "start": 238.14,
      "end": 239.3,
      "text": "兩千美金"
    },
    {
      "index": 163,
      "start": 239.3,
      "end": 240.46,
      "text": "飛到不得了一個"
    },
    {
      "index": 164,
      "start": 240.46,
      "end": 241.7,
      "text": "它一算作為"
    },
    {
      "index": 165,
      "start": 241.7,
      "end": 242.78,
      "text": "一除"
    },
    {
      "index": 166,
      "start": 242.78,
      "end": 244.62,
      "text": "每個人三十幾萬錢"
    },
    {
      "index": 167,
      "start": 244.62,
      "end": 245.66,
      "text": "它就找個小黑板"
    },
    {
      "index": 168,
      "start": 245.66,
      "end": 246.78,
      "text": "叫個小黑板"
    },
    {
      "index": 169,
      "start": 246.78,
      "end": 247.82,
      "text": "那個拍子"
    },
    {
      "index": 170,
      "start": 247.82,
      "end": 248.86,
      "text": "維遇真航空"
    },
    {
      "index": 171,
      "start": 248.86,
      "end": 250.22,
      "text": "每一個作為三十幾萬錢"
    },
    {
      "index": 172,
      "start": 250.22,
      "end": 251.02,
      "text": "然後做完了"
    },
    {
      "index": 173,
      "start": 251.02,
      "end": 251.98,
      "text": "飛到那邊以後的話"
    },
    {
      "index": 174,
      "start": 251.98,
      "end": 252.94,
      "text": "就人下了飛機"
    },
    {
      "index": 175,
      "start": 252.94,
      "end": 254.14,
      "text": "就可能說"
    },
    {
      "index": 176,
      "start": 254.14,
      "end": 255.98,
      "text": "你這個飛機還是不錯的"
    },
    {
      "index": 177,
      "start": 255.98,
      "end": 257.26,
      "text": "在提升一些服務"
    },
    {
      "index": 178,
      "start": 257.26,
      "end": 258.62,
      "text": "你的航空公司"
    },
    {
      "index": 179,
      "start": 258.62,
      "end": 260.22,
      "text": "就可以開業了"
    },
    {
      "index": 180,
      "start": 260.22,
      "end": 261.02,
      "text": "所以大家可以看"
    },
    {
      "index": 181,
      "start": 261.02,
      "end": 263.1,
      "text": "它整個做生的那個過程"
    },
    {
      "index": 182,
      "start": 263.1,
      "end": 264.3,
      "text": "真的就是"
    },
    {
      "index": 183,
      "start": 264.3,
      "end": 266.14,
      "text": "有些時候就是一些"
    },
    {
      "index": 184,
      "start": 266.14,
      "end": 266.78,
      "text": "一些"
    },
    {
      "index": 185,
      "start": 266.78,
      "end": 268.06,
      "text": "其實生活中都不快樂"
    },
    {
      "index": 186,
      "start": 268.06,
      "end": 269.66,
      "text": "但它把它組合成了一種生意"
    },
    {
      "index": 187,
      "start": 269.66,
      "end": 271.02,
      "text": "組合成了一種機會"
    },
    {
      "index": 188,
      "start": 271.02,
      "end": 272.22,
      "text": "我建議大家"
    },
    {
      "index": 189,
      "start": 272.22,
      "end": 273.42,
      "text": "好看一看"
    },
    {
      "index": 190,
      "start": 273.42,
      "end": 274.22,
      "text": "還那句話"
    },
    {
      "index": 191,
      "start": 274.22,
      "end": 274.86,
      "text": "還那句話"
    },
    {
      "index": 192,
      "start": 274.86,
      "end": 275.9,
      "text": "我那句話怎麼說來的"
    },
    {
      "index": 193,
      "start": 275.9,
      "end": 276.54,
      "text": "來我把句話"
    },
    {
      "index": 194,
      "start": 276.54,
      "end": 277.42,
      "text": "這句話找一找"
    },
    {
      "index": 195,
      "start": 277.42,
      "end": 279.26,
      "text": "任何一個還在為"
    },
    {
      "index": 196,
      "start": 279.26,
      "end": 281.02,
      "text": "文寶而憤怒的人"
    },
    {
      "index": 197,
      "start": 281.02,
      "end": 282.78,
      "text": "一定是缺乏現行李的"
    },
    {
      "index": 198,
      "start": 282.78,
      "end": 283.82,
      "text": "而事實上你的航力"
    },
    {
      "index": 199,
      "start": 283.82,
      "end": 284.78,
      "text": "一家打開"
    },
    {
      "index": 200,
      "start": 284.78,
      "end": 286.14,
      "text": "你的世界又開火了"
    },
    {
      "index": 201,
      "start": 286.14,
      "end": 287.58,
      "text": "所以推薦三本書"
    },
    {
      "index": 202,
      "start": 287.58,
      "end": 288.86,
      "text": "也不是說你看一年"
    },
    {
      "index": 203,
      "start": 288.86,
      "end": 289.66,
      "text": "看幾天"
    },
    {
      "index": 204,
      "start": 289.66,
      "end": 290.94,
      "text": "就是從現在"
    },
    {
      "index": 205,
      "start": 290.94,
      "end": 292.3,
      "text": "到過年段時間"
    },
    {
      "index": 206,
      "start": 292.3,
      "end": 293.5,
      "text": "開多一些事業的"
    }
  ]
}