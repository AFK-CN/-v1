      "index": 126,
      "start": 256.16,
      "end": 257.6,
      "text": "他会有一个结构"
    },
    {
      "index": 127,
      "start": 257.6,
      "end": 259.04,
      "text": "比如说他一上来"
    },
    {
      "index": 128,
      "start": 259.04,
      "end": 260.4,
      "text": "叫追求财富"
    },
