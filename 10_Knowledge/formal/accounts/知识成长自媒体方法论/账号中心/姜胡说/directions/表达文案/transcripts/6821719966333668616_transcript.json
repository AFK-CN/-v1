{
  "language": "zh",
  "duration": 55.751125,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.96,
      "text": "有人说我的文案特别厉害"
    },
    {
      "index": 2,
      "start": 1.96,
      "end": 4.36,
      "text": "那是因为你没有见过我更厉害的文案"
    },
    {
      "index": 3,
      "start": 4.36,
      "end": 5.88,
      "text": "随拜来两句话"
    },
    {
      "index": 4,
      "start": 6.88,
      "end": 8.96,
      "text": "你怪他对你不真实"
    },
    {
      "index": 5,
      "start": 8.96,
      "end": 11.36,
      "text": "可是你给他真实的力量了吗"
    },
    {
      "index": 6,
      "start": 12.36,
      "end": 13.36,
      "text": "有感觉吗"
    },
    {
      "index": 7,
      "start": 13.36,
      "end": 15.6,
      "text": "好,没有,第二句"
    },
    {
      "index": 8,
      "start": 17.08,
      "end": 19.2,
      "text": "让我们把所有的一言难情"
    },
    {
      "index": 9,
      "start": 20.16,
      "end": 21.24,
      "text": "一言耳机"
    },
    {
      "index": 10,
      "start": 21.88,
      "end": 22.88,
      "text": "有没有感觉"
    },
    {
      "index": 11,
      "start": 23.08,
      "end": 23.88,
      "text": "好"
    },
    {
      "index": 12,
      "start": 24.04,
      "end": 25.08,
      "text": "第三句个位"
    },
    {
      "index": 13,
      "start": 25.08,
      "end": 26.24,
      "text": "如果你要是没有感觉的话"
    },
    {
      "index": 14,
      "start": 26.24,
      "end": 28.32,
      "text": "那你的生活就太快法了"
    },
    {
      "index": 15,
      "start": 30.58,
      "end": 32.22,
      "text": "我可以忘记全世界"
    },
    {
      "index": 16,
      "start": 32.94,
      "end": 35.02,
      "text": "但是为独忘记不了你"
    },
    {
      "index": 17,
      "start": 38.02,
      "end": 38.82,
      "text": "第一句"
    },
    {
      "index": 18,
      "start": 38.82,
      "end": 40.1,
      "text": "来自于一部电影"
    },
    {
      "index": 19,
      "start": 41.02,
      "end": 43.02,
      "text": "第二句来自于一部广告"
    },
    {
      "index": 20,
      "start": 43.62,
      "end": 45.86,
      "text": "被三句来自于一首歌"
    },
    {
      "index": 21,
      "start": 46.66,
      "end": 47.94,
      "text": "有一种优秀"
    },
    {
      "index": 22,
      "start": 47.94,
      "end": 50.06,
      "text": "叫做你不知道我从那儿抄的"
    },
    {
      "index": 23,
      "start": 50.5,
      "end": 51.74,
      "text": "有一种牛逼"
    },
    {
      "index": 24,
      "start": 51.74,
      "end": 53.9,
      "text": "叫做你名字到我是从那儿抄的"
    },
    {
      "index": 25,
      "start": 54.3,
      "end": 55.58,
      "text": "那你就是学不来"
    }
  ]
}