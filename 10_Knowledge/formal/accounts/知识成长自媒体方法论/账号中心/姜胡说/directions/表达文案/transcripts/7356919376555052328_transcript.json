{
  "language": "zh",
  "duration": 316.5111875,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 2.96,
      "text": "给大家分享一条干活 要求"
    },
    {
      "index": 2,
      "start": 2.96,
      "end": 6.68,
      "text": "注意我说的是 要求 江湖说的老伙企"
    },
    {
      "index": 3,
      "start": 6.68,
      "end": 8.96,
      "text": "多看两遍 然后完成了一个"
    },
    {
      "index": 4,
      "start": 8.96,
      "end": 12.08,
      "text": "每天写点什么 和其他人无关"
    },
    {
      "index": 5,
      "start": 13.08,
      "end": 14.84,
      "text": "我们先看两个字"
    },
    {
      "index": 6,
      "start": 14.84,
      "end": 18.04,
      "text": "一个字叫窮 一个字叫傅"
    },
    {
      "index": 7,
      "start": 18.04,
      "end": 19.72,
      "text": "窮怎么写呢"
    },
    {
      "index": 8,
      "start": 19.72,
      "end": 22.52,
      "text": "宝贝 现在有一个罢"
    },
    {
      "index": 9,
      "start": 22.52,
      "end": 24.0,
      "text": "有一个利"
    },
    {
      "index": 10,
      "start": 24.72,
      "end": 28.8,
      "text": "这个傅怎么写呢 宝贝一口甜"
    },
    {
      "index": 11,
      "start": 29.12,
      "end": 32.12,
      "text": "如果我们回到风电视社会"
    },
    {
      "index": 12,
      "start": 32.12,
      "end": 35.44,
      "text": "什么是关键资源 土地"
    },
    {
      "index": 13,
      "start": 35.44,
      "end": 37.76,
      "text": "打下去打什么呢 它土地呢"
    },
    {
      "index": 14,
      "start": 37.76,
      "end": 41.72,
      "text": "负人 拥有最关键的核心资源"
    },
    {
      "index": 15,
      "start": 41.72,
      "end": 45.52,
      "text": "以及保护它的能力 土地就是这个天"
    },
    {
      "index": 16,
      "start": 45.52,
      "end": 50.32,
      "text": "窮人的宋材资料是什么呢 是巴和利"
    },
    {
      "index": 17,
      "start": 50.32,
      "end": 53.96,
      "text": "所以呢 这个负人就可以邀请"
    },
    {
      "index": 18,
      "start": 53.96,
      "end": 56.44,
      "text": "我们窮人 巴和利"
    },
    {
      "index": 19,
      "start": 56.44,
      "end": 57.6,
      "text": "来帮自己中天"
    },
    {
      "index": 20,
      "start": 57.6,
      "end": 59.84,
      "text": "然后为他制复工钱"
    },
    {
      "index": 21,
      "start": 59.84,
      "end": 61.32,
      "text": "然后把中小两世"
    },
    {
      "index": 22,
      "start": 61.32,
      "end": 63.44,
      "text": "然后再卖给窮人"
    },
    {
      "index": 23,
      "start": 63.44,
      "end": 66.44,
      "text": "那个负人疼出更多的时间用来思考"
    },
    {
      "index": 24,
      "start": 66.44,
      "end": 69.12,
      "text": "有不要相信那个过去那个意言的这个"
    },
    {
      "index": 25,
      "start": 69.12,
      "end": 71.44,
      "text": "比如说说这个负人"
    },
    {
      "index": 26,
      "start": 71.44,
      "end": 74.16,
      "text": "好傻呀 窮人好聪明的"
    },
    {
      "index": 27,
      "start": 74.16,
      "end": 77.76,
      "text": "你会发现负人从小的时候"
    },
    {
      "index": 28,
      "start": 77.76,
      "end": 79.68,
      "text": "部分家里都有私书"
    },
    {
      "index": 29,
      "start": 79.68,
      "end": 82.16,
      "text": "窮人有几个上的起司书的"
    },
    {
      "index": 30,
      "start": 82.16,
      "end": 85.92,
      "text": "然后往前起锅 尽头公孕月华时来"
    },
    {
      "index": 31,
      "start": 85.92,
      "end": 87.44,
      "text": "公孕华时来"
    },
    {
      "index": 32,
      "start": 87.44,
      "end": 90.96,
      "text": "这个那个时候还就是负早就出来了"
    },
    {
      "index": 33,
      "start": 90.96,
      "end": 96.08,
      "text": "就是天不一定就出香港新的核心资源"
    },
    {
      "index": 34,
      "start": 96.08,
      "end": 99.52,
      "text": "什么呢 资本和使用"
    },
    {
      "index": 35,
      "start": 99.52,
      "end": 102.56,
      "text": "来吧 去哪什么呢 使用的 对吧"
    },
    {
      "index": 36,
      "start": 102.56,
      "end": 106.4,
      "text": "但是窮人好 所以个宋材资料没变"
    },
    {
      "index": 37,
      "start": 106.4,
      "end": 108.16,
      "text": "巴和利"
    },
    {
      "index": 38,
      "start": 108.16,
      "end": 112.0,
      "text": "然后负人就可以请窮人来自一个工厂工作"
    },
    {
      "index": 39,
      "start": 112.0,
      "end": 113.04,
      "text": "负人工钱"
    },
    {
      "index": 40,
      "start": 113.04,
      "end": 114.32,
      "text": "然后宋材主动性"
    },
    {
      "index": 41,
      "start": 114.32,
      "end": 116.16,
      "text": "卖给窮人"
    },
    {
      "index": 42,
      "start": 116.16,
      "end": 119.6,
      "text": "等出更多的时间用来思考"
    },
    {
      "index": 43,
      "start": 119.6,
      "end": 122.16,
      "text": "但是中间有一个分析"
    },
    {
      "index": 44,
      "start": 122.16,
      "end": 124.96,
      "text": "这个分析什么呢 过去无论是土地"
    },
    {
      "index": 45,
      "start": 124.96,
      "end": 128.0,
      "text": "还是资本也好 还是石油也好"
    },
    {
      "index": 46,
      "start": 128.0,
      "end": 129.44,
      "text": "都不是能够轻易获得的"
    },
    {
      "index": 47,
      "start": 129.44,
      "end": 131.28,
      "text": "但是有一个分析 就是软件"
    },
    {
      "index": 48,
      "start": 131.28,
      "end": 133.52,
      "text": "我以前是学建筑的"
    },
    {
      "index": 49,
      "start": 133.52,
      "end": 134.48,
      "text": "后来做软件了"
    },
    {
      "index": 50,
      "start": 134.48,
      "end": 136.08,
      "text": "有软件啊"
    },
    {
      "index": 51,
      "start": 136.08,
      "end": 139.12,
      "text": "他人在没有土地"
    },
    {
      "index": 52,
      "start": 139.12,
      "end": 140.88,
      "text": "没有资源"
    },
    {
      "index": 53,
      "start": 140.88,
      "end": 143.04,
      "text": "没有资本没有石油的情况下"
    },
    {
      "index": 54,
      "start": 143.04,
      "end": 145.84,
      "text": "用窗造力创造一块软件"
    },
    {
      "index": 55,
      "start": 145.84,
      "end": 149.6,
      "text": "让软件为自己出工出力"
    },
    {
      "index": 56,
      "start": 149.6,
      "end": 152.96,
      "text": "然后来展现 哇 这个很棒"
    },
    {
      "index": 57,
      "start": 152.96,
      "end": 156.64,
      "text": "好 我往前推荐 进化到第三个时代"
    },
    {
      "index": 58,
      "start": 156.64,
      "end": 160.32,
      "text": "第三个时代是什么呢 是信息时代"
    },
    {
      "index": 59,
      "start": 160.32,
      "end": 162.4,
      "text": "就很多人生活在信息时代"
    },
    {
      "index": 60,
      "start": 162.4,
      "end": 164.56,
      "text": "但是不理解信息时代的意义"
    },
    {
      "index": 61,
      "start": 164.56,
      "end": 168.24,
      "text": "昨天我就看到有人评论许有个人问我问题"
    },
    {
      "index": 62,
      "start": 168.24,
      "end": 169.84,
      "text": "结果他这个人就回答说"
    },
    {
      "index": 63,
      "start": 169.84,
      "end": 172.64,
      "text": "你脑子就甩了 你有问自媒体人"
    },
    {
      "index": 64,
      "start": 172.64,
      "end": 174.88,
      "text": "他们大部分能在别的行业干点啥"
    },
    {
      "index": 65,
      "start": 174.88,
      "end": 176.88,
      "text": "他也不会做自媒体"
    },
    {
      "index": 66,
      "start": 176.88,
      "end": 177.84,
      "text": "是这样"
    },
    {
      "index": 67,
      "start": 177.84,
      "end": 179.2,
      "text": "前面的就好是同意的"
    },
    {
      "index": 68,
      "start": 179.2,
      "end": 182.0,
      "text": "就人意调独立司法 后半人就好"
    },
    {
      "index": 69,
      "start": 182.0,
      "end": 184.48,
      "text": "我认为很多人和他一样"
    },
    {
      "index": 70,
      "start": 184.48,
      "end": 186.4,
      "text": "没有理解信息时代的本质"
    },
    {
      "index": 71,
      "start": 186.4,
      "end": 189.12,
      "text": "信息是带这个信息啊"
    },
    {
      "index": 72,
      "start": 189.12,
      "end": 190.56,
      "text": "他是消耗品"
    },
    {
      "index": 73,
      "start": 190.56,
      "end": 192.24,
      "text": "他是一种需求"
    },
    {
      "index": 74,
      "start": 192.24,
      "end": 193.6,
      "text": "就什么人都需要信息"
    },
    {
      "index": 75,
      "start": 193.6,
      "end": 195.6,
      "text": "有人需要"
    },
    {
      "index": 76,
      "start": 195.6,
      "end": 197.6,
      "text": "让我快乐 让我爽的"
    },
    {
      "index": 77,
      "start": 197.6,
      "end": 199.36,
      "text": "有人需要让我打到生意的"
    },
    {
      "index": 78,
      "start": 199.36,
      "end": 202.0,
      "text": "让我变得更聪明的更智慧的这个信息"
    },
    {
      "index": 79,
      "start": 202.0,
      "end": 205.28,
      "text": "所以有些信息不给钱"
    },
    {
      "index": 80,
      "start": 205.28,
      "end": 206.56,
      "text": "你都不能看"
    },
    {
      "index": 81,
      "start": 206.56,
      "end": 209.36,
      "text": "有些信息你给了钱"
    },
    {
      "index": 82,
      "start": 209.36,
      "end": 211.12,
      "text": "你都不一定会买得到"
    },
    {
      "index": 83,
      "start": 211.12,
      "end": 212.72,
      "text": "你看我们回到以前啊"
    },
    {
      "index": 84,
      "start": 212.72,
      "end": 213.84,
      "text": "你们负人"
    },
    {
      "index": 85,
      "start": 213.84,
      "end": 216.08,
      "text": "他拥有的生产这个资料什么呢"
    },
    {
      "index": 86,
      "start": 216.08,
      "end": 216.96,
      "text": "是甜"
    },
    {
      "index": 87,
      "start": 216.96,
      "end": 218.56,
      "text": "后来是资本"
    },
    {
      "index": 88,
      "start": 218.56,
      "end": 219.44,
      "text": "后来是什么"
    },
    {
      "index": 89,
      "start": 219.44,
      "end": 221.04,
      "text": "后来是这个"
    },
    {
      "index": 90,
      "start": 221.04,
      "end": 222.0,
      "text": "是有"
    },
    {
      "index": 91,
      "start": 222.0,
      "end": 225.68,
      "text": "信息时代什么东西是核心资源"
    },
    {
      "index": 92,
      "start": 225.68,
      "end": 227.44,
      "text": "是闯造力"
    },
    {
      "index": 93,
      "start": 227.44,
      "end": 230.72,
      "text": "是头脑 头脑变得更重要的"
    },
    {
      "index": 94,
      "start": 230.72,
      "end": 233.76,
      "text": "但是实际上这个手管程序平船"
    },
    {
      "index": 95,
      "start": 233.76,
      "end": 234.96,
      "text": "可以不去体会一下"
    },
    {
      "index": 96,
      "start": 234.96,
      "end": 236.56,
      "text": "窮人呢 没变"
    },
    {
      "index": 97,
      "start": 236.56,
      "end": 237.44,
      "text": "8"
    },
    {
      "index": 98,
      "start": 237.44,
      "end": 239.44,
      "text": "和0"
    },
    {
      "index": 99,
      "start": 239.44,
      "end": 240.8,
      "text": "所以"
    },
    {
      "index": 100,
      "start": 240.8,
      "end": 244.24,
      "text": "在信息时代有一个非常大的变化"
    },
    {
      "index": 101,
      "start": 244.24,
      "end": 246.48,
      "text": "这个变化给了很多窮人一个机会"
    },
    {
      "index": 102,
      "start": 246.48,
      "end": 247.84,
      "text": "什么机会就是你通过"
    },
    {
      "index": 103,
      "start": 247.84,
      "end": 249.68,
      "text": "8和0去完成一个机会"
    },
    {
      "index": 104,
      "start": 249.68,
      "end": 250.72,
      "text": "这个机会就是"
    },
    {
      "index": 105,
      "start": 250.72,
      "end": 252.48,
      "text": "让自己又有头脑"
    },
    {
      "index": 106,
      "start": 252.48,
      "end": 254.08,
      "text": "拥有窗造力"
    },
    {
      "index": 107,
      "start": 254.08,
      "end": 256.32,
      "text": "你去体会机会"
    },
    {
      "index": 108,
      "start": 257.36,
      "end": 258.72,
      "text": "让我们该怎么做呢"
    },
    {
      "index": 109,
      "start": 258.72,
      "end": 260.32,
      "text": "好 我们不说那么多了"
    },
    {
      "index": 110,
      "start": 260.32,
      "end": 261.92,
      "text": "然后给大家一本书"
    },
    {
      "index": 111,
      "start": 261.92,
      "end": 263.12,
      "text": "就是那个纳华尔"
    },
    {
      "index": 112,
      "start": 263.12,
      "end": 264.08,
      "text": "那华尔"
    },
    {
      "index": 113,
      "start": 264.08,
      "end": 265.36,
      "text": "宝殿里面有这么友好"
    },
    {
      "index": 114,
      "start": 265.36,
      "end": 266.16,
      "text": "我给大家读一读"
    },
    {
      "index": 115,
      "start": 266.16,
      "end": 268.32,
      "text": "你去思考一下"
    },
    {
      "index": 116,
      "start": 268.32,
      "end": 269.92,
      "text": "最好的工作"
    },
    {
      "index": 117,
      "start": 269.92,
      "end": 273.92,
      "text": "于委任或学位无关"
    },
    {
      "index": 118,
      "start": 273.92,
      "end": 276.48,
      "text": "昨天有人就在评论去够留言"
    },
    {
      "index": 119,
      "start": 276.48,
      "end": 278.08,
      "text": "有本事你给我门证明一下"
    },
    {
      "index": 120,
      "start": 278.08,
      "end": 279.44,
      "text": "你考个博事后"
    },
    {
      "index": 121,
      "start": 279.44,
      "end": 280.8,
      "text": "对吧"
    },
    {
      "index": 122,
      "start": 280.8,
      "end": 281.92,
      "text": "我们证明一下"
    },
    {
      "index": 123,
      "start": 281.92,
      "end": 282.8,
      "text": "我问问你"
    },
    {
      "index": 124,
      "start": 282.8,
      "end": 284.88,
      "text": "你也问问自己"
    },
    {
      "index": 125,
      "start": 284.88,
      "end": 286.0,
      "text": "我跟你讲"
    },
    {
      "index": 126,
      "start": 286.0,
      "end": 288.32,
      "text": "动气了这个问题本质的人"
    },
    {
      "index": 127,
      "start": 288.32,
      "end": 290.72,
      "text": "根本不需要通过委任的"
    },
    {
      "index": 128,
      "start": 290.72,
      "end": 293.44,
      "text": "或者学位来证明自己"
    },
    {
      "index": 129,
      "start": 293.44,
      "end": 294.72,
      "text": "事上昨天"
    },
    {
      "index": 130,
      "start": 294.72,
      "end": 297.84,
      "text": "你已经燃烧了你大量的时间和经历"
    },
    {
      "index": 131,
      "start": 297.84,
      "end": 299.84,
      "text": "来免税为我提供"
    },
    {
      "index": 132,
      "start": 299.84,
      "end": 300.96,
      "text": "生产资料"
    },
    {
      "index": 133,
      "start": 300.96,
      "end": 302.72,
      "text": "你忠祝吗"
    },
    {
      "index": 134,
      "start": 302.72,
      "end": 304.0,
      "text": "最好的工作"
    },
    {
      "index": 135,
      "start": 304.0,
      "end": 306.8,
      "text": "于委任或学历无关"
    },
    {
      "index": 136,
      "start": 306.8,
      "end": 308.4,
      "text": "最好的工作"
    },
    {
      "index": 137,
      "start": 308.4,
      "end": 310.56,
      "text": "是忠深学习者"
    },
    {
      "index": 138,
      "start": 310.56,
      "end": 315.6,
      "text": "在自由市场中的創造性表达"
    },
    {
      "index": 139,
      "start": 315.6,
      "end": 316.6,
      "text": "伤会"
    }
  ]
}