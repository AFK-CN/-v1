      "end": 210.6,
      "text": "剛上臉"
    },
    {
      "index": 158,
      "start": 210.6,
      "end": 212.08,
      "text": "有種鮮魚水光河"
    },
    {
      "index": 159,
      "start": 212.08,
      "end": 213.24,
      "text": "霧面之間的一種"
    },
    {
      "index": 160,
      "start": 213.24,
      "end": 214.28,
      "text": "微光澤感"
    },
    {
      "index": 161,
      "start": 214.28,
      "end": 215.04,
      "text": "除了有之後"
    },
    {
      "index": 162,
