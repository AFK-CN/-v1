{
  "language": "zh",
  "duration": 220.7753125,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 1.28,
      "text": "我的手是犯着晃的"
    },
    {
      "index": 2,
      "start": 1.28,
      "end": 2.56,
      "text": "但是我的练士感觉是那种"
    },
    {
      "index": 3,
      "start": 2.56,
      "end": 3.76,
      "text": "很通透的白"
    },
    {
      "index": 4,
      "start": 3.76,
      "end": 4.68,
      "text": "他们每个月做出来的"
    },
    {
      "index": 5,
      "start": 4.68,
      "end": 5.8,
      "text": "没有什么区别优"
    },
    {
      "index": 6,
      "start": 5.8,
      "end": 7.48,
      "text": "那里没有发现每一次"
    },
    {
      "index": 7,
      "start": 7.48,
      "end": 9.4,
      "text": "在每个月弄完都不理解"
    },
    {
      "index": 8,
      "start": 9.4,
      "end": 10.52,
      "text": "赶快发的感觉"
    },
    {
      "index": 9,
      "start": 10.52,
      "end": 11.96,
      "text": "但是自己在家里面做"
    },
    {
      "index": 10,
      "start": 11.96,
      "end": 13.76,
      "text": "死发弄到的产品也很好"
    },
    {
      "index": 11,
      "start": 13.76,
      "end": 14.6,
      "text": "这些出带的效果"
    },
    {
      "index": 12,
      "start": 14.6,
      "end": 15.72,
      "text": "就是差了那么一点"
    },
    {
      "index": 13,
      "start": 15.72,
      "end": 17.64,
      "text": "然后我就研究了一下发现"
    },
    {
      "index": 14,
      "start": 17.64,
      "end": 18.44,
      "text": "其实我们说说"
    },
    {
      "index": 15,
      "start": 18.44,
      "end": 19.84,
      "text": "估计了得挺小重点"
    },
    {
      "index": 16,
      "start": 19.84,
      "end": 21.6,
      "text": "就让每个月转到我们那么多的钱"
    },
    {
      "index": 17,
      "start": 21.6,
      "end": 22.92,
      "text": "我们掌握了这个圆密"
    },
    {
      "index": 18,
      "start": 22.92,
      "end": 24.56,
      "text": "也可以自己在家里面做"
    },
    {
      "index": 19,
      "start": 24.56,
      "end": 25.84,
      "text": "我叫他家庭版"
    },
    {
      "index": 20,
      "start": 25.84,
      "end": 26.44,
      "text": "几乎贯住"
    },
    {
      "index": 21,
      "start": 26.44,
      "end": 27.8,
      "text": "你们不需要跟我用一样的产品"
    },
    {
      "index": 22,
      "start": 27.8,
      "end": 29.72,
      "text": "我只是跟你们分享我的这个方法"
    },
    {
      "index": 23,
      "start": 29.72,
      "end": 31.0,
      "text": "你们用自己的产品"
    },
    {
      "index": 24,
      "start": 31.0,
      "end": 31.76,
      "text": "出来的效果"
    },
    {
      "index": 25,
      "start": 31.76,
      "end": 33.12,
      "text": "原谅是融光款的"
    },
    {
      "index": 26,
      "start": 33.12,
      "end": 34.2,
      "text": "马上叫过年了"
    },
    {
      "index": 27,
      "start": 34.2,
      "end": 35.16,
      "text": "赶快试试"
    },
    {
      "index": 28,
      "start": 35.16,
      "end": 35.96,
      "text": "第2天"
    },
    {
      "index": 29,
      "start": 35.96,
      "end": 37.16,
      "text": "虽然你的所有亲戚"
    },
    {
      "index": 30,
      "start": 37.16,
      "end": 38.64,
      "text": "我们做几乎贯住之前"
    },
    {
      "index": 31,
      "start": 38.64,
      "end": 39.52,
      "text": "一定要打开"
    },
    {
      "index": 32,
      "start": 39.52,
      "end": 40.44,
      "text": "皮膚通道"
    },
    {
      "index": 33,
      "start": 40.44,
      "end": 41.84,
      "text": "这个是非常重要"
    },
    {
      "index": 34,
      "start": 41.84,
      "end": 43.32,
      "text": "但是却被我的红绿的衣服"
    },
    {
      "index": 35,
      "start": 43.32,
      "end": 44.68,
      "text": "给你们看一下我现在凉"
    },
    {
      "index": 36,
      "start": 44.68,
      "end": 45.56,
      "text": "就是我的融头"
    },
    {
      "index": 37,
      "start": 45.56,
      "end": 46.44,
      "text": "还有鼻子"
    },
    {
      "index": 38,
      "start": 46.44,
      "end": 48.2,
      "text": "这一圈都被进了"
    },
    {
      "index": 39,
      "start": 48.2,
      "end": 49.88,
      "text": "有指督的言认识试试"
    },
    {
      "index": 40,
      "start": 49.88,
      "end": 50.68,
      "text": "就都是那种"
    },
    {
      "index": 41,
      "start": 50.68,
      "end": 51.88,
      "text": "比例理的感觉"
    },
    {
      "index": 42,
      "start": 51.88,
      "end": 52.76,
      "text": "你们看见的黑头"
    },
    {
      "index": 43,
      "start": 52.76,
      "end": 53.48,
      "text": "这个时候"
    },
    {
      "index": 44,
      "start": 53.48,
      "end": 54.48,
      "text": "你不管是什么"
    },
    {
      "index": 45,
      "start": 54.48,
      "end": 56.12,
      "text": "被你都被觉得很激烈"
    },
    {
      "index": 46,
      "start": 56.12,
      "end": 56.56,
      "text": "没效"
    },
    {
      "index": 47,
      "start": 56.56,
      "end": 57.4,
      "text": "因为婚婚"
    },
    {
      "index": 48,
      "start": 57.4,
      "end": 59.96,
      "text": "它图在里上根本就没有被皮膚吸收"
    },
    {
      "index": 49,
      "start": 59.96,
      "end": 62.12,
      "text": "它都被这些油脂给肚子带带带带带带带带"
    },
    {
      "index": 50,
      "start": 62.12,
      "end": 63.68,
      "text": "我们现在称得起来找毛孔"
    },
    {
      "index": 51,
      "start": 63.68,
      "end": 64.68,
      "text": "是张开的状态"
    },
    {
      "index": 52,
      "start": 64.68,
      "end": 66.24,
      "text": "赶快服务一个黑头导出现"
    },
    {
      "index": 53,
      "start": 66.24,
      "end": 68.8,
      "text": "我会把我毛孔都肚住的地方"
    },
    {
      "index": 54,
      "start": 68.8,
      "end": 70.16,
      "text": "然后都服上这个"
    },
    {
      "index": 55,
      "start": 70.16,
      "end": 70.76,
      "text": "黑头导出现"
    },
    {
      "index": 56,
      "start": 70.76,
      "end": 72.72,
      "text": "我这两边就比较名秘"
    },
    {
      "index": 57,
      "start": 72.72,
      "end": 74.36,
      "text": "所以这两边我都会服"
    },
    {
      "index": 58,
      "start": 74.36,
      "end": 76.56,
      "text": "服的时候一定要来一个热盆"
    },
    {
      "index": 59,
      "start": 76.56,
      "end": 77.76,
      "text": "如果你没有这样的热盆"
    },
    {
      "index": 60,
      "start": 77.76,
      "end": 79.04,
      "text": "已经就去用锅"
    },
    {
      "index": 61,
      "start": 79.04,
      "end": 79.76,
      "text": "稍微点水"
    },
    {
      "index": 62,
      "start": 79.76,
      "end": 81.32,
      "text": "用热气去蒸脸"
    },
    {
      "index": 63,
      "start": 81.32,
      "end": 82.56,
      "text": "但是不以表会他们导入"
    },
    {
      "index": 64,
      "start": 82.56,
      "end": 82.96,
      "text": "好"
    },
    {
      "index": 65,
      "start": 82.96,
      "end": 84.16,
      "text": "大概蒸了个15分钟"
    },
    {
      "index": 66,
      "start": 84.16,
      "end": 87.16,
      "text": "现在开始产脾几分钟"
    },
    {
      "index": 67,
      "start": 87.16,
      "end": 89.24,
      "text": "我们就一定要清清楚了这种产"
    },
    {
      "index": 68,
      "start": 89.24,
      "end": 90.0,
      "text": "就可以了"
    },
    {
      "index": 69,
      "start": 90.0,
      "end": 90.24,
      "text": "好"
    },
    {
      "index": 70,
      "start": 90.24,
      "end": 91.4,
      "text": "我刚刚已经炒完了"
    },
    {
      "index": 71,
      "start": 91.4,
      "end": 93.12,
      "text": "然后已经发炼洗干净了"
    },
    {
      "index": 72,
      "start": 93.12,
      "end": 96.52,
      "text": "现在的皮膚通道已经打开了77%了"
    },
    {
      "index": 73,
      "start": 96.52,
      "end": 98.08,
      "text": "我们现在再用一个"
    },
    {
      "index": 74,
      "start": 98.08,
      "end": 99.28,
      "text": "这种酸的动物"
    },
    {
      "index": 75,
      "start": 99.28,
      "end": 100.28,
      "text": "再来出一下"
    },
    {
      "index": 76,
      "start": 100.28,
      "end": 102.52,
      "text": "这一步其实服务3到5分钟就可以了"
    },
    {
      "index": 77,
      "start": 102.52,
      "end": 105.12,
      "text": "这是为了进步再一次打开"
    },
    {
      "index": 78,
      "start": 105.12,
      "end": 106.08,
      "text": "只有皮膚的通道"
    },
    {
      "index": 79,
      "start": 106.08,
      "end": 107.0,
      "text": "这就不错完了"
    },
    {
      "index": 80,
      "start": 107.0,
      "end": 110.2,
      "text": "我们的皮膚通道采算是真正的被打开"
    },
    {
      "index": 81,
      "start": 110.2,
      "end": 113.2,
      "text": "像那种非常高端的法式院建育法"
    },
    {
      "index": 82,
      "start": 113.2,
      "end": 114.84,
      "text": "他们基本上都有这一步"
    },
    {
      "index": 83,
      "start": 114.84,
      "end": 115.4,
      "text": "这一步的话"
    },
    {
      "index": 84,
      "start": 115.4,
      "end": 116.92,
      "text": "他们是叫做调一脚汁"
    },
    {
      "index": 85,
      "start": 116.92,
      "end": 117.92,
      "text": "调理完了之后"
    },
    {
      "index": 86,
      "start": 117.92,
      "end": 119.52,
      "text": "我们再去冠冲"
    },
    {
      "index": 87,
      "start": 119.52,
      "end": 122.48,
      "text": "就能够把营量全部都冠净皮膚的"
    },
    {
      "index": 88,
      "start": 122.48,
      "end": 124.04,
      "text": "这才是真正的有脚护服"
    },
    {
      "index": 89,
      "start": 124.04,
      "end": 126.32,
      "text": "我们先用一个有酸酥酥反尚火的"
    },
    {
      "index": 90,
      "start": 126.32,
      "end": 126.88,
      "text": "伤不适合"
    },
    {
      "index": 91,
      "start": 128.88,
      "end": 130.28,
      "text": "再来一会"
    },
    {
      "index": 92,
      "start": 130.28,
      "end": 131.88,
      "text": "第三面"
    },
    {
      "index": 93,
      "start": 131.88,
      "end": 133.32,
      "text": "如果是不想拍的话"
    },
    {
      "index": 94,
      "start": 133.32,
      "end": 135.4,
      "text": "也可以用少不适来做一个什么"
    },
    {
      "index": 95,
      "start": 135.4,
      "end": 137.04,
      "text": "第二步在有一个精华做单体"
    },
    {
      "index": 96,
      "start": 137.04,
      "end": 138.84,
      "text": "如果是觉得最近皮膚比较干脏"
    },
    {
      "index": 97,
      "start": 138.84,
      "end": 140.8,
      "text": "就可以用这种皮膚精华油"
    },
    {
      "index": 98,
      "start": 140.8,
      "end": 142.52,
      "text": "如果是感觉皮膚比较安华"
    },
    {
      "index": 99,
      "start": 142.52,
      "end": 145.08,
      "text": "就可以用这种可以体量的精华"
    },
    {
      "index": 100,
      "start": 145.08,
      "end": 147.64,
      "text": "那么我觉得最近皮膚博你也可以用这种修顾精华"
    },
    {
      "index": 101,
      "start": 147.64,
      "end": 149.44,
      "text": "但是这就是切剂这个精华"
    },
    {
      "index": 102,
      "start": 149.44,
      "end": 151.16,
      "text": "不要弄那种很刺激的像是吧"
    },
    {
      "index": 103,
      "start": 151.16,
      "end": 151.68,
      "text": "算啊"
    },
    {
      "index": 104,
      "start": 151.68,
      "end": 154.04,
      "text": "一传的员心被CN这种通通都不可以"
    },
    {
      "index": 105,
      "start": 154.04,
      "end": 156.08,
      "text": "我想想明天放上我的两个白鸡"
    },
    {
      "index": 106,
      "start": 156.08,
      "end": 158.44,
      "text": "所以我刚才就用这种可以这样的精华"
    },
    {
      "index": 107,
      "start": 158.44,
      "end": 161.96,
      "text": "就是在用一个通过面膜"
    },
    {
      "index": 108,
      "start": 161.96,
      "end": 163.04,
      "text": "这个通过面膜"
    },
    {
      "index": 109,
      "start": 163.04,
      "end": 164.16,
      "text": "然后我们可以以后"
    },
    {
      "index": 110,
      "start": 164.16,
      "end": 166.36,
      "text": "一定是我们关锋的重水素"
    },
    {
      "index": 111,
      "start": 166.36,
      "end": 168.92,
      "text": "在来附上一片天片膜"
    },
    {
      "index": 112,
      "start": 168.92,
      "end": 170.56,
      "text": "这个面膜就用那种很甜"
    },
    {
      "index": 113,
      "start": 170.56,
      "end": 171.84,
      "text": "一本那种浮水啊"
    },
    {
      "index": 114,
      "start": 171.84,
      "end": 172.88,
      "text": "就获得那个面膜"
    },
    {
      "index": 115,
      "start": 172.88,
      "end": 175.04,
      "text": "那些过者是用那种广泉水"
    },
    {
      "index": 116,
      "start": 175.04,
      "end": 177.6,
      "text": "配合那个植膜去正式面膜也行"
    },
    {
      "index": 117,
      "start": 177.6,
      "end": 180.68,
      "text": "这也不能主要就是为了增加这个夹茶"
    },
    {
      "index": 118,
      "start": 180.68,
      "end": 183.08,
      "text": "让皮膚感这个營料都"
    },
    {
      "index": 119,
      "start": 183.08,
      "end": 185.16,
      "text": "但是说你千万感觉皮膚全"
    },
    {
      "index": 120,
      "start": 185.16,
      "end": 188.0,
      "text": "不全霍把那些營料都吃进去"
    },
    {
      "index": 121,
      "start": 188.0,
      "end": 189.08,
      "text": "不用皮膚做了"
    },
    {
      "index": 122,
      "start": 189.08,
      "end": 191.8,
      "text": "这种最好还是用清水洗一下"
    },
    {
      "index": 123,
      "start": 191.8,
      "end": 193.92,
      "text": "就是避免營料过程的家庭"
    },
    {
      "index": 124,
      "start": 193.92,
      "end": 194.88,
      "text": "所以放到肯楼"
    },
    {
      "index": 125,
      "start": 194.88,
      "end": 196.92,
      "text": "现在可以开始"
    },
    {
      "index": 126,
      "start": 196.92,
      "end": 197.84,
      "text": "不够去的不够"
    },
    {
      "index": 127,
      "start": 197.84,
      "end": 200.04,
      "text": "看我的面膜的少数是我的少数"
    },
    {
      "index": 128,
      "start": 200.04,
      "end": 202.04,
      "text": "但是我的面膜感觉是那种"
    },
    {
      "index": 129,
      "start": 202.04,
      "end": 203.28,
      "text": "好痛痛的感觉"
    },
    {
      "index": 130,
      "start": 203.28,
      "end": 205.08,
      "text": "刚才已经被换住过了"
    },
    {
      "index": 131,
      "start": 205.08,
      "end": 206.48,
      "text": "现在我们不用水了"
    },
    {
      "index": 132,
      "start": 206.48,
      "end": 208.04,
      "text": "我们现在直接就不用喝"
    },
    {
      "index": 133,
      "start": 208.04,
      "end": 208.6,
      "text": "我还敢说"
    },
    {
      "index": 134,
      "start": 208.6,
      "end": 210.12,
      "text": "就我们开始用的是什么型码"
    },
    {
      "index": 135,
      "start": 210.12,
      "end": 211.52,
      "text": "现在我还是用什么型码"
    },
    {
      "index": 136,
      "start": 211.52,
      "end": 212.84,
      "text": "再用一个你喜欢的"
    },
    {
      "index": 137,
      "start": 212.84,
      "end": 214.52,
      "text": "修护或者是黑老棉生"
    },
    {
      "index": 138,
      "start": 214.52,
      "end": 217.2,
      "text": "还是你通常现在感觉皮膚非常地水"
    },
    {
      "index": 139,
      "start": 217.2,
      "end": 217.8,
      "text": "那很难切"
    },
    {
      "index": 140,
      "start": 217.8,
      "end": 218.56,
      "text": "很有光符"
    },
    {
      "index": 141,
      "start": 218.56,
      "end": 220.64,
      "text": "我每个人做出来的没有什么区别用"
    }
  ]
}