{
  "language": "zh",
  "duration": 217.4563125,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 2.32,
      "text": "帮你试完在韩国当一天韩女"
    },
    {
      "index": 2,
      "start": 2.32,
      "end": 3.36,
      "text": "是什么体验"
    },
    {
      "index": 3,
      "start": 3.36,
      "end": 4.08,
      "text": "哈喽大家"
    },
    {
      "index": 4,
      "start": 4.08,
      "end": 6.32,
      "text": "9月份去韩国的时候体验了"
    },
    {
      "index": 5,
      "start": 6.32,
      "end": 7.6,
      "text": "变每3件套"
    },
    {
      "index": 6,
      "start": 7.6,
      "end": 8.4,
      "text": "剑了头发"
    },
    {
      "index": 7,
      "start": 8.4,
      "end": 9.44,
      "text": "化了韩装"
    },
    {
      "index": 8,
      "start": 9.44,
      "end": 10.64,
      "text": "还拍了美美的"
    },
    {
      "index": 9,
      "start": 10.64,
      "end": 12.32,
      "text": "还是剩一件一照"
    },
    {
      "index": 10,
      "start": 12.32,
      "end": 13.28,
      "text": "12花装"
    },
    {
      "index": 11,
      "start": 13.28,
      "end": 13.92,
      "text": "出发"
    },
    {
      "index": 12,
      "start": 13.92,
      "end": 14.64,
      "text": "每一大早"
    },
    {
      "index": 13,
      "start": 14.64,
      "end": 15.2,
      "text": "顶着这招"
    },
    {
      "index": 14,
      "start": 15.2,
      "end": 16.48,
      "text": "并不给你去化装了"
    },
    {
      "index": 15,
      "start": 16.48,
      "end": 18.8,
      "text": "我预约的这件是新开的化装是"
    },
    {
      "index": 16,
      "start": 18.8,
      "end": 21.6,
      "text": "化装是之前是张元英的化装时"
    },
    {
      "index": 17,
      "start": 21.6,
      "end": 22.4,
      "text": "那我一进去"
    },
    {
      "index": 18,
      "start": 22.4,
      "end": 25.2,
      "text": "就被这个化装品的数量和政企程度"
    },
    {
      "index": 19,
      "start": 25.2,
      "end": 26.24,
      "text": "证判倒了"
    },
    {
      "index": 20,
      "start": 26.24,
      "end": 27.92,
      "text": "强迫这门狂戏又没有"
    },
    {
      "index": 21,
      "start": 27.92,
      "end": 29.28,
      "text": "我给的餐烤装"
    },
    {
      "index": 22,
      "start": 29.28,
      "end": 30.64,
      "text": "这种是小水的这张"
    },
    {
      "index": 23,
      "start": 30.64,
      "end": 33.04,
      "text": "因为很多朋友都说我长得很像小水"
    },
    {
      "index": 24,
      "start": 33.04,
      "end": 34.72,
      "text": "那本人化装门力"
    },
    {
      "index": 25,
      "start": 34.72,
      "end": 35.52,
      "text": "十分有限"
    },
    {
      "index": 26,
      "start": 35.52,
      "end": 37.12,
      "text": "这次来想韩酒之间"
    },
    {
      "index": 27,
      "start": 37.12,
      "end": 38.08,
      "text": "放装一下"
    },
    {
      "index": 28,
      "start": 38.08,
      "end": 38.88,
      "text": "嘿嘿"
    },
    {
      "index": 29,
      "start": 38.88,
      "end": 40.24,
      "text": "化装时节线给我"
    },
    {
      "index": 30,
      "start": 40.24,
      "end": 41.2,
      "text": "修了个美碼"
    },
    {
      "index": 31,
      "start": 41.2,
      "end": 44.24,
      "text": "然后用了一品泡沫面膜来做装前打底"
    },
    {
      "index": 32,
      "start": 44.24,
      "end": 45.28,
      "text": "这次来小韩发现"
    },
    {
      "index": 33,
      "start": 45.28,
      "end": 48.24,
      "text": "他们现在都特别喜欢用这种泡沫面膜"
    },
    {
      "index": 34,
      "start": 48.24,
      "end": 48.96,
      "text": "很方便"
    },
    {
      "index": 35,
      "start": 48.96,
      "end": 49.68,
      "text": "那底装部分"
    },
    {
      "index": 36,
      "start": 49.68,
      "end": 51.04,
      "text": "先用了一个BB雙"
    },
    {
      "index": 37,
      "start": 51.04,
      "end": 51.92,
      "text": "全面打底"
    },
    {
      "index": 38,
      "start": 51.92,
      "end": 53.92,
      "text": "手法真的很溫柔的"
    },
    {
      "index": 39,
      "start": 53.92,
      "end": 55.6,
      "text": "来的我真是要快去找了"
    },
    {
      "index": 40,
      "start": 55.6,
      "end": 56.96,
      "text": "美帽就把它真的花的"
    },
    {
      "index": 41,
      "start": 56.96,
      "end": 58.08,
      "text": "超仔细"
    },
    {
      "index": 42,
      "start": 58.08,
      "end": 60.0,
      "text": "用了美粉美笔"
    },
    {
      "index": 43,
      "start": 60.0,
      "end": 60.64,
      "text": "眼睛"
    },
    {
      "index": 44,
      "start": 60.64,
      "end": 62.32,
      "text": "让美高四种工具"
    },
    {
      "index": 45,
      "start": 62.32,
      "end": 65.28,
      "text": "眼装化装时使用这三盘眼影混合的用的"
    },
    {
      "index": 46,
      "start": 65.28,
      "end": 66.96,
      "text": "都是几分色细的"
    },
    {
      "index": 47,
      "start": 66.96,
      "end": 68.64,
      "text": "那先大面几瀑色之后"
    },
    {
      "index": 48,
      "start": 68.64,
      "end": 69.76,
      "text": "来开始夹签毛"
    },
    {
      "index": 49,
      "start": 69.76,
      "end": 70.88,
      "text": "会先用打火机"
    },
    {
      "index": 50,
      "start": 70.88,
      "end": 71.28,
      "text": "弹了一下"
    },
    {
      "index": 51,
      "start": 71.28,
      "end": 72.32,
      "text": "静毛夹在讲"
    },
    {
      "index": 52,
      "start": 72.32,
      "end": 74.4,
      "text": "弄眼线高完成的整个眼线"
    },
    {
      "index": 53,
      "start": 74.4,
      "end": 74.96,
      "text": "部分之后"
    },
    {
      "index": 54,
      "start": 74.96,
      "end": 77.28,
      "text": "就开始吸化眼影加深运软了"
    },
    {
      "index": 55,
      "start": 77.28,
      "end": 78.72,
      "text": "那化装时给我展示了"
    },
    {
      "index": 56,
      "start": 78.72,
      "end": 79.92,
      "text": "它一抽替"
    },
    {
      "index": 57,
      "start": 79.92,
      "end": 81.92,
      "text": "来自咱们穿那的夹签毛"
    },
    {
      "index": 58,
      "start": 81.92,
      "end": 83.92,
      "text": "说他们现在都非常爱用"
    },
    {
      "index": 59,
      "start": 83.92,
      "end": 84.88,
      "text": "中国的夹签毛"
    },
    {
      "index": 60,
      "start": 84.88,
      "end": 85.76,
      "text": "监一又好用"
    },
    {
      "index": 61,
      "start": 85.76,
      "end": 87.44,
      "text": "那我也适备韩国人反向"
    },
    {
      "index": 62,
      "start": 88.4,
      "end": 90.0,
      "text": "它给我贴的这个夹签毛"
    },
    {
      "index": 63,
      "start": 90.0,
      "end": 91.84,
      "text": "我一开始真的是有点下达"
    },
    {
      "index": 64,
      "start": 91.84,
      "end": 92.88,
      "text": "我有点抗拒"
    },
    {
      "index": 65,
      "start": 92.88,
      "end": 95.2,
      "text": "因为我没有贴过这么长的"
    },
    {
      "index": 66,
      "start": 95.2,
      "end": 96.16,
      "text": "然后一转眼"
    },
    {
      "index": 67,
      "start": 96.16,
      "end": 97.36,
      "text": "我洗几了一个"
    },
    {
      "index": 68,
      "start": 97.36,
      "end": 98.96,
      "text": "韩式大窩产"
    },
    {
      "index": 69,
      "start": 98.96,
      "end": 100.88,
      "text": "我当时看我就觉得"
    },
    {
      "index": 70,
      "start": 100.88,
      "end": 102.56,
      "text": "静子里面的自己超级陌生"
    },
    {
      "index": 71,
      "start": 102.56,
      "end": 103.52,
      "text": "我已经做好了"
    },
    {
      "index": 72,
      "start": 103.52,
      "end": 104.64,
      "text": "翻成的准备了"
    },
    {
      "index": 73,
      "start": 104.64,
      "end": 106.24,
      "text": "不然小韩便美我的心情"
    },
    {
      "index": 74,
      "start": 106.24,
      "end": 107.84,
      "text": "总是像做过山车鱼"
    },
    {
      "index": 75,
      "start": 107.84,
      "end": 110.56,
      "text": "然后又又又再完善眼装了"
    },
    {
      "index": 76,
      "start": 110.56,
      "end": 112.32,
      "text": "眼装真的化了超久"
    },
    {
      "index": 77,
      "start": 112.32,
      "end": 113.76,
      "text": "我还体验到了这个"
    },
    {
      "index": 78,
      "start": 113.76,
      "end": 114.88,
      "text": "小韩传统"
    },
    {
      "index": 79,
      "start": 114.88,
      "end": 116.88,
      "text": "像我小木棍汤净"
    },
    {
      "index": 80,
      "start": 116.88,
      "end": 118.24,
      "text": "眼装部分结束之后"
    },
    {
      "index": 81,
      "start": 118.24,
      "end": 119.44,
      "text": "就开始折下了"
    },
    {
      "index": 82,
      "start": 119.44,
      "end": 120.8,
      "text": "整个底装完成后"
    },
    {
      "index": 83,
      "start": 120.8,
      "end": 123.2,
      "text": "我是感觉整体核心了很多"
    },
    {
      "index": 84,
      "start": 123.2,
      "end": 125.28,
      "text": "第一装是只用了并装红武"
    },
    {
      "index": 85,
      "start": 125.28,
      "end": 127.76,
      "text": "三红它是用这两盘混合大的"
    },
    {
      "index": 86,
      "start": 127.76,
      "end": 129.68,
      "text": "这两盘我都买了"
    },
    {
      "index": 87,
      "start": 129.68,
      "end": 131.76,
      "text": "但是我怎么打都打不出"
    },
    {
      "index": 88,
      "start": 131.76,
      "end": 133.44,
      "text": "它给我打的那个效果"
    },
    {
      "index": 89,
      "start": 133.44,
      "end": 136.0,
      "text": "果然还是技术比产品更重要"
    },
    {
      "index": 90,
      "start": 136.0,
      "end": 137.84,
      "text": "那化装是开始挑户红了"
    },
    {
      "index": 91,
      "start": 137.84,
      "end": 140.72,
      "text": "也是用了三四只混合出来的颜色"
    },
    {
      "index": 92,
      "start": 140.72,
      "end": 142.96,
      "text": "装容结束就开始做造型了"
    },
    {
      "index": 93,
      "start": 142.96,
      "end": 144.32,
      "text": "整体的效果就是这样"
    },
    {
      "index": 94,
      "start": 144.32,
      "end": 147.12,
      "text": "可能大家觉得我这十七万五花的直播直呢"
    },
    {
      "index": 95,
      "start": 147.12,
      "end": 148.88,
      "text": "下午我就带着这个装报"
    },
    {
      "index": 96,
      "start": 148.88,
      "end": 150.48,
      "text": "去拍海市针间照楼"
    },
    {
      "index": 97,
      "start": 150.48,
      "end": 153.12,
      "text": "现在小姐姐要带我上去拍照楼"
    },
    {
      "index": 98,
      "start": 154.32,
      "end": 156.08,
      "text": "我选了最贵挡位的"
    },
    {
      "index": 99,
      "start": 156.08,
      "end": 157.92,
      "text": "不是十六万很远的"
    },
    {
      "index": 100,
      "start": 157.92,
      "end": 159.92,
      "text": "到底会先给一个马嫂一下"
    },
    {
      "index": 101,
      "start": 159.92,
      "end": 161.52,
      "text": "选择想拍的风格"
    },
    {
      "index": 102,
      "start": 161.52,
      "end": 164.24,
      "text": "他们有很多背景颜色可以选"
    },
    {
      "index": 103,
      "start": 164.24,
      "end": 166.16,
      "text": "那我选的是这个色的"
    },
    {
      "index": 104,
      "start": 166.16,
      "end": 167.6,
      "text": "拍摄和修图的过程"
    },
    {
      "index": 105,
      "start": 167.6,
      "end": 169.68,
      "text": "不能够路向所以我只能口述一下的"
    },
    {
      "index": 106,
      "start": 169.68,
      "end": 171.84,
      "text": "拍照的过程超几块"
    },
    {
      "index": 107,
      "start": 171.84,
      "end": 173.44,
      "text": "我以为还在找角度"
    },
    {
      "index": 108,
      "start": 173.44,
      "end": 174.56,
      "text": "设计是他就跟我说"
    },
    {
      "index": 109,
      "start": 174.56,
      "end": 175.44,
      "text": "已经拍完了"
    },
    {
      "index": 110,
      "start": 175.44,
      "end": 177.2,
      "text": "就大概也就五分钟吧"
    },
    {
      "index": 111,
      "start": 177.2,
      "end": 178.24,
      "text": "那拍完之后"
    },
    {
      "index": 112,
      "start": 178.24,
      "end": 180.8,
      "text": "立马当着我的面就开始修图了"
    },
    {
      "index": 113,
      "start": 180.8,
      "end": 184.08,
      "text": "他连空气流汉和节碼都可以"
    },
    {
      "index": 114,
      "start": 184.08,
      "end": 185.84,
      "text": "跟一根的帮我画出来"
    },
    {
      "index": 115,
      "start": 185.84,
      "end": 187.68,
      "text": "我最后的成片就是会给一个"
    },
    {
      "index": 116,
      "start": 187.68,
      "end": 189.84,
      "text": "期待和相框还有真真账账"
    },
    {
      "index": 117,
      "start": 189.84,
      "end": 191.12,
      "text": "然后还有一个电子摆"
    },
    {
      "index": 118,
      "start": 191.12,
      "end": 192.32,
      "text": "会发到我的状况"
    },
    {
      "index": 119,
      "start": 192.32,
      "end": 193.92,
      "text": "因为我有选择困难圣"
    },
    {
      "index": 120,
      "start": 193.92,
      "end": 195.92,
      "text": "所以我用家选了一张真面子"
    },
    {
      "index": 121,
      "start": 195.92,
      "end": 197.84,
      "text": "谈与三件套体应完毕"
    },
    {
      "index": 122,
      "start": 197.84,
      "end": 199.68,
      "text": "现在是下午快六点钟"
    },
    {
      "index": 123,
      "start": 199.68,
      "end": 202.16,
      "text": "这个装划了五个小时"
    },
    {
      "index": 124,
      "start": 202.16,
      "end": 203.92,
      "text": "咱们就是洗铁"
    },
    {
      "index": 125,
      "start": 203.92,
      "end": 205.12,
      "text": "还是水光鸡"
    },
    {
      "index": 126,
      "start": 205.12,
      "end": 206.48,
      "text": "不能不说这个装容"
    },
    {
      "index": 127,
      "start": 206.48,
      "end": 207.84,
      "text": "真的是超级能大"
    },
    {
      "index": 128,
      "start": 207.84,
      "end": 209.76,
      "text": "我家外面奔波了一天"
    },
    {
      "index": 129,
      "start": 209.76,
      "end": 211.12,
      "text": "一点都没脱装"
    },
    {
      "index": 130,
      "start": 211.12,
      "end": 212.64,
      "text": "这一趟人的重逃了"
    },
    {
      "index": 131,
      "start": 212.64,
      "end": 214.16,
      "text": "很多很多东西"
    },
    {
      "index": 132,
      "start": 214.16,
      "end": 216.64,
      "text": "那我改天再跟姐妹分享吧"
    },
    {
      "index": 133,
      "start": 216.64,
      "end": 217.44,
      "text": "拜拜"
    }
  ]
}