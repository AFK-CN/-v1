{
  "language": "zh",
  "duration": 33.924375,
  "segments": [
    {
      "index": 1,
      "start": 0.02,
      "end": 2.98,
      "text": "每个人的身上都有一个模式"
    },
    {
      "index": 2,
      "start": 2.98,
      "end": 4.78,
      "text": "就是这个模式"
    },
    {
      "index": 3,
      "start": 4.78,
      "end": 7.7,
      "text": "让我们的生活总是不停地充衍"
    },
    {
      "index": 4,
      "start": 7.7,
      "end": 9.86,
      "text": "如果它是负面的"
    },
    {
      "index": 5,
      "start": 9.86,
      "end": 13.66,
      "text": "那它就是一切问题的根源"
    },
    {
      "index": 6,
      "start": 13.66,
      "end": 14.94,
      "text": "查理芒哥说"
    },
    {
      "index": 7,
      "start": 14.94,
      "end": 17.34,
      "text": "如果我知道自己明天会死在哪"
    },
    {
      "index": 8,
      "start": 17.34,
      "end": 20.74,
      "text": "那么永远不会出现在那个地方"
    },
    {
      "index": 9,
      "start": 20.74,
      "end": 23.9,
      "text": "真正让我们做出改变的"
    },
    {
      "index": 10,
      "start": 23.9,
      "end": 25.82,
      "text": "是找到那个模式"
    },
    {
      "index": 11,
      "start": 25.82,
      "end": 28.18,
      "text": "然后把那个后面堵上"
    },
    {
      "index": 12,
      "start": 28.46,
      "end": 30.78,
      "text": "覆盘 反省"
    },
    {
      "index": 13,
      "start": 30.78,
      "end": 33.82,
      "text": "是我知道的最有效的方法"
    }
  ]
}