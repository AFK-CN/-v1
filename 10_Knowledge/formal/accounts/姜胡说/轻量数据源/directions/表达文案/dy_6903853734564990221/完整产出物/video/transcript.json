{
  "language": "zh",
  "duration": 53.2911875,
  "segments": [
    {
      "index": 1,
      "start": 0.21,
      "end": 2.57,
      "text": "有一本特别棒的书"
    },
    {
      "index": 2,
      "start": 2.57,
      "end": 4.41,
      "text": "可惜被书名归回了"
    },
    {
      "index": 3,
      "start": 4.41,
      "end": 6.21,
      "text": "当年乔伯斯极力推荐的"
    },
    {
      "index": 4,
      "start": 6.21,
      "end": 7.53,
      "text": "霍金不是写过一本书吗"
    },
    {
      "index": 5,
      "start": 7.53,
      "end": 8.53,
      "text": "叫《实验检视》"
    },
    {
      "index": 6,
      "start": 8.53,
      "end": 11.93,
      "text": "有人就把《实验检视》和这本书放在一块讨论"
    },
    {
      "index": 7,
      "start": 11.93,
      "end": 14.77,
      "text": "霍金知道以后感觉莫达的荣幸"
    },
    {
      "index": 8,
      "start": 14.77,
      "end": 16.57,
      "text": "我估计很能的猜到这本书的名字了"
    },
    {
      "index": 9,
      "start": 16.57,
      "end": 19.41,
      "text": "叫《禅语摩托车维修》"
    },
    {
      "index": 10,
      "start": 19.41,
      "end": 21.13,
      "text": "这本书里能记得一个小故事"
    },
    {
      "index": 11,
      "start": 21.13,
      "end": 24.53,
      "text": "说当地人是怎么补猴子的"
    },
    {
      "index": 12,
      "start": 24.53,
      "end": 27.65,
      "text": "他们把这个椰子偷空了"
    },
    {
      "index": 13,
      "start": 27.65,
      "end": 28.93,
      "text": "里边翻他米饭"
    },
    {
      "index": 14,
      "start": 29.29,
      "end": 31.29,
      "text": "然后绑在那个书上"
    },
    {
      "index": 15,
      "start": 31.29,
      "end": 32.93,
      "text": "这个椰子上留了个小口"
    },
    {
      "index": 16,
      "start": 32.93,
      "end": 35.89,
      "text": "刚好够猴子把手伸进去的"
    },
    {
      "index": 17,
      "start": 35.89,
      "end": 37.45,
      "text": "伸进去之后偷米吃"
    },
    {
      "index": 18,
      "start": 37.45,
      "end": 38.61,
      "text": "但是一转成拳子"
    },
    {
      "index": 19,
      "start": 38.61,
      "end": 40.65,
      "text": "对不起就拿不出来了"
    },
    {
      "index": 20,
      "start": 40.65,
      "end": 43.57,
      "text": "你说这个猴子也是危险都来了"
    },
    {
      "index": 21,
      "start": 43.57,
      "end": 45.05,
      "text": "你放手不就完了吗"
    },
    {
      "index": 22,
      "start": 45.05,
      "end": 45.73,
      "text": "他不"
    },
    {
      "index": 23,
      "start": 45.73,
      "end": 48.13,
      "text": "他非得抓着那个米啊"
    },
    {
      "index": 24,
      "start": 48.13,
      "end": 49.17,
      "text": "打死都不放"
    },
    {
      "index": 25,
      "start": 50.17,
      "end": 52.57,
      "text": "你说这个猴子他是不是很笨"
    }
  ]
}