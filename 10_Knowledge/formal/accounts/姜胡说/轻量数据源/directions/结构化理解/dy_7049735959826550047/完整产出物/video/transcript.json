{
  "language": "zh",
  "duration": 90.256,
  "segments": [
    {
      "index": 1,
      "start": 0.14,
      "end": 2.14,
      "text": "今天的视频非常重要"
    },
    {
      "index": 2,
      "start": 2.14,
      "end": 5.1,
      "text": "我建议姜硕老伙计一定要多看两遍"
    },
    {
      "index": 3,
      "start": 5.1,
      "end": 6.5,
      "text": "反复琢磨琢磨"
    },
    {
      "index": 4,
      "start": 6.5,
      "end": 7.66,
      "text": "值得"
    },
    {
      "index": 5,
      "start": 7.66,
      "end": 9.54,
      "text": "读一本书读什么呢"
    },
    {
      "index": 6,
      "start": 9.54,
      "end": 10.7,
      "text": "一个是知点"
    },
    {
      "index": 7,
      "start": 10.7,
      "end": 11.86,
      "text": "一个是结构"
    },
    {
      "index": 8,
      "start": 11.86,
      "end": 12.94,
      "text": "什么是结构呢"
    },
    {
      "index": 9,
      "start": 12.94,
      "end": 15.74,
      "text": "就是知识与知识的连接叫做结构"
    },
    {
      "index": 10,
      "start": 15.74,
      "end": 18.5,
      "text": "最简单的结构就是一本书的骆金麦洛"
    },
    {
      "index": 11,
      "start": 18.5,
      "end": 20.54,
      "text": "就是这个作者是如何思考问题的"
    },
    {
      "index": 12,
      "start": 21.54,
      "end": 24.74,
      "text": "一本书没有多少知识点"
    },
    {
      "index": 13,
      "start": 24.74,
      "end": 26.22,
      "text": "知识点加结构"
    },
    {
      "index": 14,
      "start": 26.22,
      "end": 27.5,
      "text": "构成了一本书"
    },
    {
      "index": 15,
      "start": 27.66,
      "end": 30.06,
      "text": "作者在跟你讲一个知识点的时候"
    },
    {
      "index": 16,
      "start": 30.06,
      "end": 32.46,
      "text": "往往是在一个语境下进行的"
    },
    {
      "index": 17,
      "start": 32.46,
      "end": 34.82,
      "text": "你可以把它简单的理解为一个案例"
    },
    {
      "index": 18,
      "start": 34.82,
      "end": 38.82,
      "text": "就是一个知识点是放在一个什么样的场景下应用的"
    },
    {
      "index": 19,
      "start": 38.82,
      "end": 41.42,
      "text": "知识点加场景等于应用"
    },
    {
      "index": 20,
      "start": 41.42,
      "end": 43.62,
      "text": "一个比较重要的知识点的话"
    },
    {
      "index": 21,
      "start": 43.62,
      "end": 46.86,
      "text": "最好最好的方式是围绕这个知识点"
    },
    {
      "index": 22,
      "start": 46.86,
      "end": 49.62,
      "text": "多读几本书主题阅读"
    },
    {
      "index": 23,
      "start": 49.62,
      "end": 52.7,
      "text": "就是一个知识点放在多个场景下"
    },
    {
      "index": 24,
      "start": 52.7,
      "end": 54.18,
      "text": "是怎么应用的"
    },
    {
      "index": 25,
      "start": 54.18,
      "end": 57.3,
      "text": "从一个语境里面提取一个关键概念"
    },
    {
      "index": 26,
      "start": 57.3,
      "end": 59.22,
      "text": "放在不同的语境里面"
    },
    {
      "index": 27,
      "start": 59.22,
      "end": 62.26,
      "text": "有利于我们了解这个知识"
    },
    {
      "index": 28,
      "start": 62.26,
      "end": 64.78,
      "text": "这个关键的概念是怎么应用的"
    },
    {
      "index": 29,
      "start": 64.78,
      "end": 66.26,
      "text": "另外一个学习方法的话"
    },
    {
      "index": 30,
      "start": 66.26,
      "end": 68.86,
      "text": "就是对于比较重要的关键概念"
    },
    {
      "index": 31,
      "start": 68.86,
      "end": 71.66,
      "text": "最好找到它最早的处处"
    },
    {
      "index": 32,
      "start": 71.66,
      "end": 73.1,
      "text": "就之前是没有的"
    },
    {
      "index": 33,
      "start": 73.1,
      "end": 74.82,
      "text": "然后它是怎么被创建的"
    },
    {
      "index": 34,
      "start": 74.82,
      "end": 76.1,
      "text": "怎么被发现出来的"
    },
    {
      "index": 35,
      "start": 76.1,
      "end": 78.34,
      "text": "然后我们观察这个作者"
    },
    {
      "index": 36,
      "start": 78.34,
      "end": 80.06,
      "text": "证明它的这个过程"
    },
    {
      "index": 37,
      "start": 80.06,
      "end": 83.62,
      "text": "可以帮助我们理解这个领域思考问题的方式"
    },
    {
      "index": 38,
      "start": 83.62,
      "end": 84.98,
      "text": "进入一个领域"
    },
    {
      "index": 39,
      "start": 84.98,
      "end": 87.58,
      "text": "就是学习这个领域的一些关键概念"
    },
    {
      "index": 40,
      "start": 87.58,
      "end": 89.94,
      "text": "以及他们思考问题的方式"
    }
  ]
}