{
  "language": "zh",
  "duration": 65.3641875,
  "segments": [
    {
      "index": 1,
      "start": 0.43,
      "end": 1.51,
      "text": "哈喽 各位老伙计"
    },
    {
      "index": 2,
      "start": 1.51,
      "end": 3.07,
      "text": "我们刚开完内部会议"
    },
    {
      "index": 3,
      "start": 3.07,
      "end": 4.79,
      "text": "上来和大家简单聊两句"
    },
    {
      "index": 4,
      "start": 4.79,
      "end": 6.51,
      "text": "给大家推荐几本"
    },
    {
      "index": 5,
      "start": 6.51,
      "end": 10.27,
      "text": "就关于公司基本面的这个书"
    },
    {
      "index": 6,
      "start": 10.27,
      "end": 11.63,
      "text": "之前也给大家推荐过"
    },
    {
      "index": 7,
      "start": 11.63,
      "end": 12.99,
      "text": "很多小巴国反馈说"
    },
    {
      "index": 8,
      "start": 12.99,
      "end": 14.71,
      "text": "就太难理解了"
    },
    {
      "index": 9,
      "start": 14.71,
      "end": 16.99,
      "text": "所以这次特意挑了三本"
    },
    {
      "index": 10,
      "start": 16.99,
      "end": 18.43,
      "text": "有同俗与懂的"
    },
    {
      "index": 11,
      "start": 18.43,
      "end": 21.95,
      "text": "而且特意选的国人写的三本书"
    },
    {
      "index": 12,
      "start": 21.95,
      "end": 24.75,
      "text": "第一本书来自于高益资产的董事长"
    },
    {
      "index": 13,
      "start": 24.75,
      "end": 25.51,
      "text": "邱国禄"
    },
    {
      "index": 14,
      "start": 25.51,
      "end": 27.79,
      "text": "踏了20多年的经验"
    },
    {
      "index": 15,
      "start": 27.79,
      "end": 28.87,
      "text": "这个书的名字叫什么"
    },
    {
      "index": 16,
      "start": 29.07,
      "end": 31.71,
      "text": "叫投资中最简单的事"
    },
    {
      "index": 17,
      "start": 31.71,
      "end": 33.43,
      "text": "把一个事讲得很复杂"
    },
    {
      "index": 18,
      "start": 33.43,
      "end": 35.11,
      "text": "容易把一个事讲得简单"
    },
    {
      "index": 19,
      "start": 35.11,
      "end": 38.15,
      "text": "那需要大量的知识积累"
    },
    {
      "index": 20,
      "start": 38.15,
      "end": 39.79,
      "text": "和对一件事情的动产的"
    },
    {
      "index": 21,
      "start": 39.79,
      "end": 41.39,
      "text": "这本书推荐大家看一下"
    },
    {
      "index": 22,
      "start": 41.39,
      "end": 43.39,
      "text": "第二本书来自于清华金管学院的"
    },
    {
      "index": 23,
      "start": 43.39,
      "end": 43.95,
      "text": "肖英老师"
    },
    {
      "index": 24,
      "start": 43.95,
      "end": 44.87,
      "text": "这本书的名字叫什么"
    },
    {
      "index": 25,
      "start": 44.87,
      "end": 47.23,
      "text": "叫肖星的财务四位课"
    },
    {
      "index": 26,
      "start": 47.23,
      "end": 48.83,
      "text": "我认为如果一个人"
    },
    {
      "index": 27,
      "start": 48.83,
      "end": 50.95,
      "text": "要想提升自己的被动的收入"
    },
    {
      "index": 28,
      "start": 50.95,
      "end": 53.83,
      "text": "那么多多少少了解一些财务四位"
    },
    {
      "index": 29,
      "start": 53.83,
      "end": 56.11,
      "text": "我觉得这本书刚刚好"
    },
    {
      "index": 30,
      "start": 56.11,
      "end": 58.19,
      "text": "第三本书的话就比较实操了"
    },
    {
      "index": 31,
      "start": 58.19,
      "end": 61.31,
      "text": "来自于就是血球这个大位叫唐朝"
    },
    {
      "index": 32,
      "start": 61.31,
      "end": 64.59,
      "text": "书名叫手把手教你"
    },
    {
      "index": 33,
      "start": 64.59,
      "end": 65.11,
      "text": "独裁报"
    }
  ]
}