{
  "language": "zh",
  "duration": 76.3008125,
  "segments": [
    {
      "index": 1,
      "start": 0.0,
      "end": 4.6,
      "text": "哈喽 未来我今天是初迎财神 咱也担把财神"
    },
    {
      "index": 2,
      "start": 4.6,
      "end": 6.8,
      "text": "其实挣钱没那么复杂"
    },
    {
      "index": 3,
      "start": 6.8,
      "end": 9.6,
      "text": "我记得年前的时候 跟大家说过好多遍"
    },
    {
      "index": 4,
      "start": 9.6,
      "end": 12.3,
      "text": "每天写点什么 每天写点什么"
    },
    {
      "index": 5,
      "start": 12.3,
      "end": 16.0,
      "text": "就过个年 大家是不是忘了 这个事呢 关键是个习惯"
    },
    {
      "index": 6,
      "start": 16.0,
      "end": 19.8,
      "text": "就不用太多 一个半天纸 不要超过一瓶"
    },
    {
      "index": 7,
      "start": 19.8,
      "end": 23.4,
      "text": "然后每天写点啥 自己的感悟 对这个世界理解"
    },
    {
      "index": 8,
      "start": 23.4,
      "end": 27.4,
      "text": "注意不是流水帐 说我今天吃了 我想谁了 不是"
    },
    {
      "index": 9,
      "start": 27.8,
      "end": 32.2,
      "text": "每天尝试用最简单的 最普实的话"
    },
    {
      "index": 10,
      "start": 32.2,
      "end": 35.4,
      "text": "把自己的感知啊 对这个世界理解写出来"
    },
    {
      "index": 11,
      "start": 35.4,
      "end": 38.6,
      "text": "那写完了以后呢 要一定要想"
    },
    {
      "index": 12,
      "start": 38.6,
      "end": 41.7,
      "text": "就这个东西啊 它解决什么问题"
    },
    {
      "index": 13,
      "start": 41.7,
      "end": 45.4,
      "text": "它可以用在什么地方 电影问题有问题吗"
    },
    {
      "index": 14,
      "start": 45.4,
      "end": 48.4,
      "text": "对吧 然后呢 每天也不一定说写的多好"
    },
    {
      "index": 15,
      "start": 48.4,
      "end": 52.2,
      "text": "但要坚持 把自己的想法写出来 今天一点 明天一点"
    },
    {
      "index": 16,
      "start": 52.2,
      "end": 55.4,
      "text": "然后过程一段时间呢 发现之前那个写的不好"
    },
    {
      "index": 17,
      "start": 55.4,
      "end": 59.6,
      "text": "你把以前那个删掉了 重新用更简单的 更普实的话"
    },
    {
      "index": 18,
      "start": 59.6,
      "end": 61.6,
      "text": "把它说出来"
    },
    {
      "index": 19,
      "start": 61.6,
      "end": 64.9,
      "text": "其实一年下来的话呢 你基本上没那么多"
    },
    {
      "index": 20,
      "start": 64.9,
      "end": 68.9,
      "text": "只要流出那么十几个真正的感悟"
    },
    {
      "index": 21,
      "start": 68.9,
      "end": 70.4,
      "text": "你不会穷的 为什么呢"
    },
    {
      "index": 22,
      "start": 70.4,
      "end": 73.4,
      "text": "因为你每天都在思考 问题有什么怎么解决"
    },
    {
      "index": 23,
      "start": 73.4,
      "end": 76.2,
      "text": "问题有什么怎么解决 你怎么可能穷呢"
    }
  ]
}