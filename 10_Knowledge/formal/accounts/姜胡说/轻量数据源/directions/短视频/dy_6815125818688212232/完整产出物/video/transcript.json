{
  "language": "zh",
  "duration": 82.2683125,
  "segments": [
    {
      "index": 1,
      "start": 0.21,
      "end": 3.81,
      "text": "每一次我发布作品 总有人在评论区问说"
    },
    {
      "index": 2,
      "start": 3.81,
      "end": 6.21,
      "text": "胡子 你这个字幕看得挺得劲"
    },
    {
      "index": 3,
      "start": 6.21,
      "end": 7.21,
      "text": "怎么做的呀"
    },
    {
      "index": 4,
      "start": 7.21,
      "end": 9.21,
      "text": "然后你就在后台给他回复一下"
    },
    {
      "index": 5,
      "start": 9.21,
      "end": 11.61,
      "text": "结果当你下一次再发布一个作品"
    },
    {
      "index": 6,
      "start": 11.61,
      "end": 13.21,
      "text": "还会有人在评论区问说"
    },
    {
      "index": 7,
      "start": 13.21,
      "end": 15.01,
      "text": "哎 胡子 你这个字幕挺得劲啊"
    },
    {
      "index": 8,
      "start": 15.01,
      "end": 16.01,
      "text": "你怎么做的啊"
    },
    {
      "index": 9,
      "start": 16.01,
      "end": 17.81,
      "text": "既然这个问题问的这么多"
    },
    {
      "index": 10,
      "start": 17.81,
      "end": 19.81,
      "text": "那我们这一期就和大家聊一聊"
    },
    {
      "index": 11,
      "start": 19.81,
      "end": 21.61,
      "text": "如果一个支架不够高"
    },
    {
      "index": 12,
      "start": 21.61,
      "end": 22.81,
      "text": "我们该怎么处理"
    },
    {
      "index": 13,
      "start": 22.81,
      "end": 24.41,
      "text": "你看这个支架就有点低"
    },
    {
      "index": 14,
      "start": 24.41,
      "end": 26.21,
      "text": "所以呢 我们给他垫一本书"
    },
    {
      "index": 15,
      "start": 26.21,
      "end": 29.21,
      "text": "还是有点低 那我们就再垫一本"
    },
    {
      "index": 16,
      "start": 29.81,
      "end": 30.61,
      "text": "再垫一本"
    },
    {
      "index": 17,
      "start": 31.21,
      "end": 32.01,
      "text": "再垫一本"
    },
    {
      "index": 18,
      "start": 32.61,
      "end": 34.21,
      "text": "再垫一本 差不多了"
    },
    {
      "index": 19,
      "start": 34.21,
      "end": 35.81,
      "text": "我们把这个手机垫上去"
    },
    {
      "index": 20,
      "start": 35.81,
      "end": 37.01,
      "text": "就可以正常拍摄了"
    },
    {
      "index": 21,
      "start": 37.01,
      "end": 38.01,
      "text": "你的粉丝少"
    },
    {
      "index": 22,
      "start": 38.01,
      "end": 39.81,
      "text": "很可能是你垫的书不够多"
    },
    {
      "index": 23,
      "start": 39.81,
      "end": 41.81,
      "text": "我做内容创作实用的APP"
    },
    {
      "index": 24,
      "start": 41.81,
      "end": 42.81,
      "text": "基本上都在这里了"
    },
    {
      "index": 25,
      "start": 42.81,
      "end": 44.81,
      "text": "点击右下角的这个图标"
    },
    {
      "index": 26,
      "start": 44.81,
      "end": 47.21,
      "text": "然后导入刚才我们拍摄的视频"
    },
    {
      "index": 27,
      "start": 47.21,
      "end": 48.21,
      "text": "你看这个支架就"
    },
    {
      "index": 28,
      "start": 48.21,
      "end": 51.41,
      "text": "它拖动到我们需要的提取字幕那个"
    },
    {
      "index": 29,
      "start": 59.06,
      "end": 61.06,
      "text": "好的 点击下一步保存"
    },
    {
      "index": 30,
      "start": 61.06,
      "end": 62.86,
      "text": "打开我们的剪辑软件"
    },
    {
      "index": 31,
      "start": 62.86,
      "end": 65.86,
      "text": "把刚才拍摄的对话视频导入进来"
    },
    {
      "index": 32,
      "start": 65.86,
      "end": 67.46,
      "text": "然后利用画中画功能"
    },
    {
      "index": 33,
      "start": 67.46,
      "end": 69.06,
      "text": "把提取的字幕也添加进来"
    },
    {
      "index": 34,
      "start": 70.26,
      "end": 71.66,
      "text": "改变它的混合模式"
    },
    {
      "index": 35,
      "start": 71.66,
      "end": 72.66,
      "text": "比如说别亮"
    },
    {
      "index": 36,
      "start": 74.66,
      "end": 76.26,
      "text": "然后导出就可以了"
    },
    {
      "index": 37,
      "start": 76.26,
      "end": 78.06,
      "text": "这段视频是和大家分享"
    },
    {
      "index": 38,
      "start": 78.06,
      "end": 79.86,
      "text": "如何提升你拍摄的高度的"
    },
    {
      "index": 39,
      "start": 81.06,
      "end": 81.86,
      "text": "你得到了吗"
    }
  ]
}